{"data":{"body":"**[P3] Create `--dump-dir` before writing files**\n\nNeither the argument handling nor `ProxyServer` creates this directory. The documented `--dump-dir /tmp/dump` usage therefore raises `FileNotFoundError` in each eligible request thread when the directory is absent and saves no diagnostics. Resolve and create it once before starting the proxy, with a test for a new path.","comment_node_id":"PRRC_kwDOPsIIsM73Jyp-","finding_digest":"5147e93cf8fa3ac5898aaa921e47d8be45ea637f12008ae211c201e29c115d43","finding_id":"arf_v1_kfd6sphy7i5mlcmkvkjb4r6yxz","finding_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-dump::missing-output-directory","identity_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-dump::missing-output-directory","line":173,"observation_digest":"b5bab12da52dc3ca2f7aed9efee1a21ac2500bf806b992c908e454bc4651b1e2","observation_id":"aro_v1_ww5lclnffxb4ul325wpp5yncdl","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"","published_at":"2026-09-30T15:47:49Z","review_id":"arr_v1_lgabgmmninacrisu4bvrsznjtr","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63d202aa1de9e170f7c271d1479adb8c65f27412","reviewer":"codex","start_line":173,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_gahjq5pch2xveue4aublcwibdg","record_type":"finding_observed","recorded_at":"2026-09-30T15:47:49Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
