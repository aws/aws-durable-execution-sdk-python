{"data":{"body":"**[P3] Prevent older concurrent runs from replacing `latest`**\n\nThese updates are not serialized. An older run paused before this replacement can resume after a newer run and make `runs/latest` point backward. Hold a runs-directory lock around pruning and marker updates and compare start timestamps before replacing the link; add a concurrent-start regression test.","comment_node_id":"PRRC_kwDOPsIIsM75QHVo","finding_digest":"a07e2fcb7a2f904c949a490f5b72ca0208ffc5e1d439a604306009fd457f865c","finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","finding_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","identity_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","line":1058,"observation_digest":"d46be03d4710b11c1b100c171bb341c4bc6d86ce5a7612e11f9ee0dafb972645","observation_id":"aro_v1_2rv6apkhccyrygyqbqlrxm2bys","path":".github/scripts/js_examples/run.py","prior_finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","published_at":"2026-10-05T07:49:52Z","review_id":"arr_v1_lsjtv47drrinlxltegbpdkzd5v","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"64135ddf7c7a779190dcc96159d210359736d153","reviewer":"codex","start_line":1058,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_2xx4lsenjrinhtxluk52my6bra","record_type":"finding_observed","recorded_at":"2026-10-05T07:49:52Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
