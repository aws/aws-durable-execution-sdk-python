{"data":{"body":"**[P2] Bypass ambient proxies for loopback traffic**\n\n`urlopen` honors `HTTP_PROXY`/`ALL_PROXY`, while `harness_env()` preserves them. Without an appropriate `NO_PROXY`, signed requests and payloads can leave loopback and local runs can fail. Use an explicit proxy-free opener for parent-process requests and set loopback proxy bypass variables for child processes; add a sentinel-proxy regression test.","comment_node_id":"PRRC_kwDOPsIIsM75RlBw","finding_digest":"7d714a5065941e1d09f6a3ac5f92121355a23544714ccfd22de784f2581d9d44","finding_id":"arf_v1_pvyuuudfsqpb2cpwuowf7eqscn","finding_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-call::loopback-proxy-bypass","identity_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-call::loopback-proxy-bypass","line":214,"observation_digest":"40dbcd0e9503d63bed63bd59ebb1f9f3d79ea93ed26db413dcbabf23d18ab584","observation_id":"aro_v1_idn42duvapldx3ldxvm6xmpz6p","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"arf_v1_pvyuuudfsqpb2cpwuowf7eqscn","published_at":"2026-10-05T08:39:26Z","review_id":"arr_v1_oxfxnwb65bcn7v73wj3lz4rnyf","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"8f526047d8f70d83a3feef0ee9448e3419c0da50","reviewer":"codex","start_line":214,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_cbvzlm7fhj5rcd2dunvlp2s4k6","record_type":"finding_observed","recorded_at":"2026-10-05T08:39:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
