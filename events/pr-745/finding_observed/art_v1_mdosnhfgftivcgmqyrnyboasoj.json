{"data":{"body":"**[P2] Do not delete another active run's output directory**\n\nThe marker only proves that some harness run created the directory. The default `--out` is global while locks are per JS checkout, so overlapping runs using different checkouts can reach this line and recursively remove the first run's maps, logs, and Jest results. Hold an output-specific lock for the entire run or make the default output unique per run, with a concurrent-run regression test.","comment_node_id":"PRRC_kwDOPsIIsM73MNTD","finding_digest":"0222f837a286f1dfbb33cf815e5beac15718e9628fa3b9740351cb09be160d3a","finding_id":"arf_v1_airpqn5cq3y57oztz6av4w7kyf","finding_key":"github/scripts/js_examples/run.py::prepare_out::active-output-directory-deletion","identity_key":"github/scripts/js_examples/run.py::prepare_out::active-output-directory-deletion","line":950,"observation_digest":"f61b06fa421c0158eb60cb7c2db6f067ded4e63dd20e54c3203cb675069973d5","observation_id":"aro_v1_6ynqn6scdqavr23azn6c3nxqm7","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T16:59:24Z","review_id":"arr_v1_bnud5kfbfetmz3d5g5dgf7e6t7","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"ecfaf35d145fe615c797dce03e042eb26cc007fc","reviewer":"codex","start_line":950,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_mdosnhfgftivcgmqyrnyboasoj","record_type":"finding_observed","recorded_at":"2026-09-30T16:59:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
