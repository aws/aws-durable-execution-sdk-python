{"data":{"body":"**[P2] Allow selections containing only known failures**\n\nKnown failures are excluded from retries and `unexpected`, but this check still returns failure when a targeted run or shard contains only allowlisted failures. That contradicts the documented known-failure behavior. Treat a reported failed suite as evidence that tests ran\u2014such as failing this guard only when neither `passed` nor `failed` is populated\u2014and add a single-known-failure regression test.","comment_node_id":"PRRC_kwDOPsIIsM75PPT6","finding_digest":"1ba1e919457c0f09c5ef0617dd6642441ee69776de78eca0f3535ab0ca0a4fa5","finding_id":"arf_v1_doq6sgkfpqhqtrppayl52zsciq","finding_key":"github/scripts/js_examples/run.py::summarize::known-failure-only-selection","identity_key":"github/scripts/js_examples/run.py::summarize::known-failure-only-selection","line":810,"observation_digest":"2694b4eaf9c8d8bb518c08cc78c612da4ed737777084f67dc34fdc3ab6707471","observation_id":"aro_v1_e2klj2xzzdmlwummbdghrrqs3j","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-10-05T07:13:58Z","review_id":"arr_v1_lb24m3ntdz3bxfcp3ukviq3l52","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"845781ebe14c4086a8cb97c2318362f26b8cd3dd","reviewer":"codex","start_line":808,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_detx5cxxl6mk2yfiwlul5n7lnu","record_type":"finding_observed","recorded_at":"2026-10-05T07:13:58Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
