{"data":{"body":"**[P2] Serialize results before crossing the worker boundary**\n\n`postMessage` structured-clones the handler result before the main thread calls `JSON.stringify`. This can strip custom prototypes/`toJSON` behavior or reject values Lambda could serialize, causing different payloads or spurious `DataCloneError`s. JSON-serialize inside the worker, send the serialized text to the main thread, and add coverage for a custom `toJSON` result.","comment_node_id":"PRRC_kwDOPsIIsM75PPOM","finding_digest":"cada4d4951b8d9dcf1b13c15a7729f376b873c4b8ba43933f3363646bb34a05f","finding_id":"arf_v1_zlne2skrxdm5z4nrhqk2o4u7g5","finding_key":"github/scripts/js_examples/lambda-shim.cjs::runsandbox::serialize-before-structured-clone","identity_key":"github/scripts/js_examples/lambda-shim.cjs::runsandbox::serialize-before-structured-clone","line":323,"observation_digest":"8a005a2dd1efccde9039e06655337c0e8104110d85199892bc7c1ed77d6c5cc1","observation_id":"aro_v1_riafulor57gn5ebz4btfkm34b2","path":".github/scripts/js_examples/lambda-shim.cjs","prior_finding_id":"","published_at":"2026-10-05T07:13:54Z","review_id":"arr_v1_lb24m3ntdz3bxfcp3ukviq3l52","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"845781ebe14c4086a8cb97c2318362f26b8cd3dd","reviewer":"codex","start_line":323,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_odhpvw3o5jmosj2bxammh7kugo","record_type":"finding_observed","recorded_at":"2026-10-05T07:13:54Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
