{"data":{"body":"**[P2] Keep ports reserved until their servers bind**\n\nBoth `free_port()` calls release their sockets immediately, and the proxy subsequently binds another ephemeral port before the runner or shim necessarily starts. It can therefore take either selected port, causing intermittent startup failures. Bind servers directly to port `0` and communicate their assigned ports, or keep reservation sockets open until each server has bound.","comment_node_id":"PRRC_kwDOPsIIsM75PPSV","finding_digest":"a7be217e2d06b53dff4fb7172a5c928f1be80f5df34740f1041ec0f521964f01","finding_id":"arf_v1_u67cc7rna22t372pw4lsuxesr4","finding_key":"github/scripts/js_examples/run.py::servers-start::port-reservation-lifetime","identity_key":"github/scripts/js_examples/run.py::servers-start::port-reservation-lifetime","line":468,"observation_digest":"3c24ed42d5f22d60ac76bd20704a789b51a1788d34bc54ce273594f0e5aeb688","observation_id":"aro_v1_hqso2qwv6iwwbldwxuqhastytn","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-10-05T07:13:57Z","review_id":"arr_v1_lb24m3ntdz3bxfcp3ukviq3l52","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"845781ebe14c4086a8cb97c2318362f26b8cd3dd","reviewer":"codex","start_line":468,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_ib4tbqnds3m5ieo4jt7eyege3j","record_type":"finding_observed","recorded_at":"2026-10-05T07:13:57Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
