{"data":{"body":"**[P2] Normalize partial Lambda ARNs**\n\nInvoke also accepts partial ARNs such as `123456789012:function:Configured:3`, but this parser treats the account ID as the function name and `function` as the qualifier. The root execution is then recorded under the wrong identity and fails shim lookup. Parse all supported Invoke identifier forms and add qualified and unqualified partial-ARN tests.","comment_node_id":"PRRC_kwDOPsIIsM75RlEz","finding_digest":"5f7ce3fddde68d5ead4e498e5bc49abe62b9b6c6cb61d930a770b598c32e7fd4","finding_id":"arf_v1_l56oh7o542gv5lkojghfxre2xz","finding_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::function-identity-normalization","identity_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::function-identity-normalization","line":78,"observation_digest":"e0d6f18b52e061e5186182e6bae89d234cc0327d60c9ee2b0d868ae3d01660cd","observation_id":"aro_v1_4dlpdc2s4bq6kgdbqltlv2e5en","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"arf_v1_l56oh7o542gv5lkojghfxre2xz","published_at":"2026-10-05T08:39:27Z","review_id":"arr_v1_oxfxnwb65bcn7v73wj3lz4rnyf","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"8f526047d8f70d83a3feef0ee9448e3419c0da50","reviewer":"codex","start_line":74,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_y2vz4ke6seo767dftwsygtkvew","record_type":"finding_observed","recorded_at":"2026-10-05T08:39:27Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
