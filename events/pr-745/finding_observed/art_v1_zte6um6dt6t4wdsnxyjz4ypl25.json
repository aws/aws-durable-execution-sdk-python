{"data":{"body":"**[P2] Do not let a skipped retry erase a failure**\n\nLater outcomes overwrite earlier ones, so a file that fails initially but has every test skipped on retry becomes `skipped`; retries stop and the overall run can succeed when another file passed. Only a real pass should clear an earlier failure. Preserve `failed` when a later attempt is skipped and add a fail-then-skip regression test.","comment_node_id":"PRRC_kwDOPsIIsM73MNcd","finding_digest":"eb05d3e034ee421eded64e8203f56e9cede51c5e38f6773567ca980f96eba09c","finding_id":"arf_v1_5mc5hybu5zbb5xwwj2bah5lott","finding_key":"github/scripts/js_examples/run.py::outcomes::skipped-retry-erases-failure","identity_key":"github/scripts/js_examples/run.py::outcomes::skipped-retry-erases-failure","line":718,"observation_digest":"ca3d63fa3c500f398fb88aaba2f0d86f6e230332777ed269806c288fa83b72a0","observation_id":"aro_v1_zi6wh6r4kahttd5yrkv2f4gyn5","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T16:59:28Z","review_id":"arr_v1_bnud5kfbfetmz3d5g5dgf7e6t7","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"ecfaf35d145fe615c797dce03e042eb26cc007fc","reviewer":"codex","start_line":718,"suggestion_id":"arsg_v1_6x6qbhsaexkbop2fpul6msemsu"},"pull_request":{"number":745},"record_id":"art_v1_zte6um6dt6t4wdsnxyjz4ypl25","record_type":"finding_observed","recorded_at":"2026-09-30T16:59:28Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
