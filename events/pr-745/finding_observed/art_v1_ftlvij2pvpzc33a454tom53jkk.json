{"data":{"body":"**[P2] Contain response serialization failures per invocation**\n\n`JSON.stringify` throws for results such as `BigInt` or circular objects. This exception escapes the server callback and terminates the entire shim, disrupting unrelated tests instead of returning a Lambda function error for that invocation. Catch marshal failures, return an `X-Amz-Function-Error` payload, and test that a subsequent invocation still succeeds.","comment_node_id":"PRRC_kwDOPsIIsM75OsKP","finding_digest":"e469a68ba15d6fd456a6433666ec9967bfa0501171abdb60637d57a303e60c6c","finding_id":"arf_v1_4ru2nc5blvx5ivvgim3gn3ezm6","finding_key":"github/scripts/js_examples/lambda-shim.cjs::sendjson::serialization-error-containment","identity_key":"github/scripts/js_examples/lambda-shim.cjs::sendjson::serialization-error-containment","line":226,"observation_digest":"372f4f58565b852b5ddbe058f5566038ab051c956932a2fee8a8915eb3bf96e4","observation_id":"aro_v1_g4xu6wcwlocswxo34bmpkvtahc","path":".github/scripts/js_examples/lambda-shim.cjs","prior_finding_id":"","published_at":"2026-10-05T06:49:12Z","review_id":"arr_v1_42pxjmgykimp27isxjurdot2s5","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"ca059e59caba02cf5eb95f8a71ce6a65e951487a","reviewer":"codex","start_line":226,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_ftlvij2pvpzc33a454tom53jkk","record_type":"finding_observed","recorded_at":"2026-10-05T06:49:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
