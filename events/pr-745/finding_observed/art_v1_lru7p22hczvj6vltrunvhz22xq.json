{"data":{"body":"**[P3] Do not prune output directories that are still active**\n\n`OUT_MARKER` is created when a run starts, so an active directory becomes eligible for deletion here. Once ten newer runs start across other JS checkouts, this can remove the older run's logs, maps, and Jest output while they are still in use. Track completion or hold a per-run lock and prune only completed or unlocked directories, with a concurrent-pruning test.","comment_node_id":"PRRC_kwDOPsIIsM74B5GQ","finding_digest":"0222f837a286f1dfbb33cf815e5beac15718e9628fa3b9740351cb09be160d3a","finding_id":"arf_v1_airpqn5cq3y57oztz6av4w7kyf","finding_key":"github/scripts/js_examples/run.py::prepare_out::active-output-directory-deletion","identity_key":"github/scripts/js_examples/run.py::prepare_out::active-output-directory-deletion","line":995,"observation_digest":"cb16141f2e3822014b0288efa83a6c15512074025567aebd6e973f02669ccca6","observation_id":"aro_v1_zmlbihzoharacsycrdx2qotmcv","path":".github/scripts/js_examples/run.py","prior_finding_id":"arf_v1_airpqn5cq3y57oztz6av4w7kyf","published_at":"2026-10-01T22:41:10Z","review_id":"arr_v1_kacf4myrr6apsummjtsffldknk","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"043d3decfcd46faf521f8cddcc42c0e71b110cc5","reviewer":"codex","start_line":994,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_lru7p22hczvj6vltrunvhz22xq","record_type":"finding_observed","recorded_at":"2026-10-01T22:41:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
