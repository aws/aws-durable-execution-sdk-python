{"data":{"body":"**[P2] Keep the checkout exclusively locked while it is in use**\n\nAn `flock` exclusive-to-shared conversion is not atomic. A waiting run can acquire the exclusive lock, check out and build another ref, then downgrade before this run obtains its shared lock; this run consequently tests the other ref's artifacts. Keep the exclusive lock through `run()`, or implement a separate atomic reader/writer protocol, and test simultaneous runs targeting different refs.","comment_node_id":"PRRC_kwDOPsIIsM73MNOC","finding_digest":"1b2216c614ead9d1ed9cce696dc966ea5f1341b7ba583bc19c0791039280ad29","finding_id":"arf_v1_dmrbnrqu5lm5d3m4zzuw3slg5j","finding_key":"github/scripts/js_examples/run.py::main::non-atomic-lock-downgrade","identity_key":"github/scripts/js_examples/run.py::main::non-atomic-lock-downgrade","line":927,"observation_digest":"c0c813b4228d3548a82750f19009250f6d55a9a5f1aada8d7b9ba0809f183ed2","observation_id":"aro_v1_ydebhnbcru2urkbhkdyzacjfb5","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T16:59:22Z","review_id":"arr_v1_bnud5kfbfetmz3d5g5dgf7e6t7","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"ecfaf35d145fe615c797dce03e042eb26cc007fc","reviewer":"codex","start_line":927,"suggestion_id":"arsg_v1_ulhdiia6phnoo6phourvrcubai"},"pull_request":{"number":745},"record_id":"art_v1_zasmgkxhhy7kjrt4u2emmaxmmg","record_type":"finding_observed","recorded_at":"2026-09-30T16:59:22Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
