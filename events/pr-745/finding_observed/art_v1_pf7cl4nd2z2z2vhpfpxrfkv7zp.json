{"data":{"body":"**[P2] Split qualified identifiers before starting the runner**\n\nFor `name:7` or a function ARN, this stores the entire identifier as `FunctionName` and hard-codes `$LATEST`. The runner expects the bare name and qualifier separately, so execution details report malformed ARNs and the wrong version even though the shim happens to find the handler. Parse path and query qualifiers into separate fields and assert the complete start payload in the proxy tests.","comment_node_id":"PRRC_kwDOPsIIsM74B4_L","finding_digest":"5f7ce3fddde68d5ead4e498e5bc49abe62b9b6c6cb61d930a770b598c32e7fd4","finding_id":"arf_v1_l56oh7o542gv5lkojghfxre2xz","finding_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::function-identity-normalization","identity_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::function-identity-normalization","line":129,"observation_digest":"309558db380a6aee671582e78a2681f9feb572ec31ec829d3001f32d44d93ddc","observation_id":"aro_v1_gckvrwzybjvo4zyvqltyujub7h","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"","published_at":"2026-10-01T22:41:06Z","review_id":"arr_v1_kacf4myrr6apsummjtsffldknk","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"043d3decfcd46faf521f8cddcc42c0e71b110cc5","reviewer":"codex","start_line":128,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_pf7cl4nd2z2z2vhpfpxrfkv7zp","record_type":"finding_observed","recorded_at":"2026-10-01T22:41:06Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
