{"data":{"body":"**[P3] Prevent older concurrent runs from replacing `latest`**\n\nThese updates are not serialized. An older run paused before this replacement can resume after a newer run and make `runs/latest` point backward. Hold a runs-directory lock around pruning and marker updates and compare start timestamps before replacing the link; add a concurrent-start regression test.","comment_node_id":"PRRC_kwDOPsIIsM75ROKE","finding_digest":"a07e2fcb7a2f904c949a490f5b72ca0208ffc5e1d439a604306009fd457f865c","finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","finding_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","identity_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","line":1065,"observation_digest":"5a12cfbedf2c3a5b7110ab0ec746b16be46d33579a756abbde2ed97b2fa89455","observation_id":"aro_v1_lijm7pw7fq5fw4iqvmhmorvrnp","path":".github/scripts/js_examples/run.py","prior_finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","published_at":"2026-10-05T08:27:39Z","review_id":"arr_v1_qe6yswyh6qamy3ebbgfzc6omzx","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"a99b73f1cd29ac2840c707ae081c9966cf036c22","reviewer":"codex","start_line":1065,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_h54kfmey5whgcxd346gidc2r7w","record_type":"finding_observed","recorded_at":"2026-10-05T08:27:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
