{"data":{"body":"**[P1] Do not discard Jest's exit status**\n\nThe return code from `proc.wait()` is ignored. Jest can write complete JSON with passing suites yet exit nonzero for global teardown, runtime, or snapshot errors, after which `summarize()` returns success. Retain the status and fail/report nonzero exits not represented by retryable or known failed suites; test a nonzero/all-passing JSON case.","comment_node_id":"PRRC_kwDOPsIIsM73JyVT","finding_digest":"b90a7df7151eff25756dd021572ea8871df8e65e4f90d7d00e3f098b7a47be29","finding_id":"arf_v1_xefh35yvd37sk5ln2aqvolviq4","finding_key":"github/scripts/js_examples/run.py::run_jest::ignored-jest-exit-status","identity_key":"github/scripts/js_examples/run.py::run_jest::ignored-jest-exit-status","line":613,"observation_digest":"d0e4a30cc65c505f48abbd62688f1b74a6601af07570a633086c636ee4d783f9","observation_id":"aro_v1_2dskgdgglrif6sflxvrgrdy3os","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T15:47:41Z","review_id":"arr_v1_lgabgmmninacrisu4bvrsznjtr","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63d202aa1de9e170f7c271d1479adb8c65f27412","reviewer":"codex","start_line":613,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_nvta3rjnbbnh5o7xbguqyhn6wc","record_type":"finding_observed","recorded_at":"2026-09-30T15:47:41Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
