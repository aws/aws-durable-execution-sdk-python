{"data":{"body":"**[P2] Check the package's source directory, not the whole repository**\n\nA PyPI wheel installed into an in-repository virtualenv such as `.venv` has an origin under `REPO_ROOT`, so this accepts it and silently tests the published runner rather than this checkout. Compare the origin with the exact testing package source tree, or verify editable-install metadata, and add an in-tree-wheel regression test.","comment_node_id":"PRRC_kwDOPsIIsM73Jyf3","finding_digest":"322919e662ba1e0765cec3593cb95453f06fd5e5a4366aef23604d240cebbefa","finding_id":"arf_v1_giurtztcxipaozooynmtzokukp","finding_key":"github/scripts/js_examples/run.py::check_python::in-tree-wheel-accepted","identity_key":"github/scripts/js_examples/run.py::check_python::in-tree-wheel-accepted","line":188,"observation_digest":"2b0613c323ab649bbb8a3e46010891d8f7f82b26e943dda38d6e5d0a3a95c167","observation_id":"aro_v1_fmdbhqzdvnsjxo4khzdaccer3d","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T15:47:45Z","review_id":"arr_v1_lgabgmmninacrisu4bvrsznjtr","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63d202aa1de9e170f7c271d1479adb8c65f27412","reviewer":"codex","start_line":188,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_b3dkg3ye7cy7o3jt4t2ebb45bq","record_type":"finding_observed","recorded_at":"2026-09-30T15:47:45Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
