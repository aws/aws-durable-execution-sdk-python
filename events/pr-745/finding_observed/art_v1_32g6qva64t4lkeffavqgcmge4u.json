{"data":{"body":"**[P3] Keep `latest` monotonic across concurrent starts**\n\nThese metadata updates are not serialized. An older run can pause before this replacement, let a newer run publish `latest`, then resume and point it backward. Hold a runs-directory lock around pruning and marker updates, and replace the link only when this run's start key is newer; add an interleaving regression test.","comment_node_id":"PRRC_kwDOPsIIsM75RlIx","finding_digest":"a07e2fcb7a2f904c949a490f5b72ca0208ffc5e1d439a604306009fd457f865c","finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","finding_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","identity_key":"github/scripts/js_examples/run.py::new-run-dir::latest-monotonicity","line":1065,"observation_digest":"b5ceca08fecdfc3c083149345dc40398981fa78e1d25c81687d3c4cf36c93ba0","observation_id":"aro_v1_wxhmuch6zx6dycbrje2f3radtc","path":".github/scripts/js_examples/run.py","prior_finding_id":"arf_v1_ub7c7s32f6iezfe2jehvw4wkai","published_at":"2026-10-05T08:39:29Z","review_id":"arr_v1_oxfxnwb65bcn7v73wj3lz4rnyf","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"8f526047d8f70d83a3feef0ee9448e3419c0da50","reviewer":"codex","start_line":1065,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_32g6qva64t4lkeffavqgcmge4u","record_type":"finding_observed","recorded_at":"2026-10-05T08:39:29Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
