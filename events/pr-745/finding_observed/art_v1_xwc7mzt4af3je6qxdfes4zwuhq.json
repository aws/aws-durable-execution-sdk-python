{"data":{"body":"**[P2] Keep root and child DurableConfig defaults consistent**\n\n`FunctionConfig.from_dict()` uses 120 seconds and 1 day when these fields are omitted, while the proxy starts the same function with 300 seconds and 7 days. Root and chained executions therefore have different timeout and retention semantics. Reuse the testing package defaults and update the empty/partial-config tests.","comment_node_id":"PRRC_kwDOPsIIsM75ROAn","finding_digest":"247a38ef2e28f9674b5123858856c46b7d7d69db814e4567a8496646916a9c17","finding_id":"arf_v1_er5dr3zofd4wos2reocyqvwenn","finding_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::durable-config-default-mismatch","identity_key":"github/scripts/js_examples/invoke_proxy.py::start_execution::durable-config-default-mismatch","line":40,"observation_digest":"801b078e21e8244e7ecad05cf86f0883e02a2a80a2c28eb00998c49ba02b911b","observation_id":"aro_v1_qanqpdrb5ase47wk2bopq3yiqp","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"","published_at":"2026-10-05T08:27:35Z","review_id":"arr_v1_qe6yswyh6qamy3ebbgfzc6omzx","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"a99b73f1cd29ac2840c707ae081c9966cf036c22","reviewer":"codex","start_line":39,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_xwc7mzt4af3je6qxdfes4zwuhq","record_type":"finding_observed","recorded_at":"2026-10-05T08:27:35Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
