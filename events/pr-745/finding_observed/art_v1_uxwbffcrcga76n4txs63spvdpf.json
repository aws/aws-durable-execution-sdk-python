{"data":{"body":"**[P1] Guard the recursive cleanup of `--out`**\n\n`--out` is user-controlled, but this recursively deletes its resolved target before validation. Passing `.`, the checkout root, or another valuable directory erases it. Refuse root/home/cwd/repository targets and preferably delete only a harness-owned directory or one containing a sentinel; add unsafe-path tests.","comment_node_id":"PRRC_kwDOPsIIsM73JyQl","finding_digest":"240d251535a5d6abc6739e307656e5cc1d54bdfd79752012a943e8360446e143","finding_id":"arf_v1_eqgskfjvuxlkxrtttyyhmvxfzq","finding_key":"github/scripts/js_examples/run.py::run::unsafe-output-directory-deletion","identity_key":"github/scripts/js_examples/run.py::run::unsafe-output-directory-deletion","line":870,"observation_digest":"2455a8d09bbb45e017ab9c25375941ce054611621ca6ec6b1f44fe09384c88fa","observation_id":"aro_v1_erk2rue3xnc6af5ltqstowkbzy","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T15:47:39Z","review_id":"arr_v1_lgabgmmninacrisu4bvrsznjtr","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63d202aa1de9e170f7c271d1479adb8c65f27412","reviewer":"codex","start_line":870,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_uxwbffcrcga76n4txs63spvdpf","record_type":"finding_observed","recorded_at":"2026-09-30T15:47:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
