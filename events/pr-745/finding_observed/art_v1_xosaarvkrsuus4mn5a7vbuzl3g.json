{"data":{"body":"**[P2] Isolate worker pools by function qualifier**\n\n`Fn`, `Fn:7`, and other qualified versions all reuse the same worker and module cache because the pool is keyed only by the bare name. Module globals can consequently leak between versions even though Lambda execution environments are version-specific. Include the qualifier or resolved version in the pool key and its exit cleanup, with a counter-based isolation test.","comment_node_id":"PRRC_kwDOPsIIsM75N44F","finding_digest":"0f7c2811697696e335191e20c7e8ec57224c5f21b985c74d0b3231adaa8da480","finding_id":"arf_v1_b56cqeljo2lognizdyqmp2hmk4","finding_key":"github/scripts/js_examples/lambda-shim.cjs::invoke::qualified-sandbox-isolation","identity_key":"github/scripts/js_examples/lambda-shim.cjs::invoke::qualified-sandbox-isolation","line":159,"observation_digest":"98b70c2a61ff79139ceb5b1c54444e5e2fc681497f7307b55f5260c600da9c10","observation_id":"aro_v1_tc3qyktb754rhhhllmofircoly","path":".github/scripts/js_examples/lambda-shim.cjs","prior_finding_id":"","published_at":"2026-10-05T06:12:24Z","review_id":"arr_v1_6wm2bprwt6d656bvg435c7hxnz","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"612c25e99cea0cff7be65f0bcc0684ba73bd13ce","reviewer":"codex","start_line":157,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_xosaarvkrsuus4mn5a7vbuzl3g","record_type":"finding_observed","recorded_at":"2026-10-05T06:12:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
