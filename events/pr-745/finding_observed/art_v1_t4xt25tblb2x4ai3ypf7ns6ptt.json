{"data":{"body":"**[P2] Invalidate the build cache for dirty JS checkouts**\n\nThe stamp records only `HEAD`, so edits made after a successful `--js-dir` build leave the commit unchanged and cause the old `dist` bundles to be reused. The run can consequently pass without testing the checkout's current source. Include relevant worktree content in the stamp or always rebuild dirty checkouts; cover this case in unit tests.","comment_node_id":"PRRC_kwDOPsIIsM73JylU","finding_digest":"420186eb08b93d88bfb348fa583b45cc13727ebd50faa1b79bc73850992c93a2","finding_id":"arf_v1_iiayn2yixe6yrp5tjd5fqo2fzq","finding_key":"github/scripts/js_examples/run.py::build_js_sdk::dirty-checkout-cache","identity_key":"github/scripts/js_examples/run.py::build_js_sdk::dirty-checkout-cache","line":147,"observation_digest":"136bf21567460bbbf8c280b656e0b15e9ceb11657f23d1ce8a9a1b0e43e7cd6e","observation_id":"aro_v1_cnv7eflhiyf3x6gcqc3fnyfrl2","path":".github/scripts/js_examples/run.py","prior_finding_id":"","published_at":"2026-09-30T15:47:47Z","review_id":"arr_v1_lgabgmmninacrisu4bvrsznjtr","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63d202aa1de9e170f7c271d1479adb8c65f27412","reviewer":"codex","start_line":147,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_t4xt25tblb2x4ai3ypf7ns6ptt","record_type":"finding_observed","recorded_at":"2026-09-30T15:47:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
