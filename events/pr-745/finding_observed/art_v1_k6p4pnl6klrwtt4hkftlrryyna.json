{"data":{"body":"**[P2] Bypass ambient proxies for loopback traffic**\n\n`urlopen` and the child boto clients inherit `HTTP_PROXY`/`ALL_PROXY`. When `NO_PROXY` does not include `127.0.0.1`, supposedly local requests are sent to that proxy, breaking the harness and potentially exposing signed invocation payloads. Use an explicit no-proxy opener for parent-process loopback calls and sanitize proxy variables in `harness_env`; test with a sentinel proxy configured.","comment_node_id":"PRRC_kwDOPsIIsM75PPQg","finding_digest":"7d714a5065941e1d09f6a3ac5f92121355a23544714ccfd22de784f2581d9d44","finding_id":"arf_v1_pvyuuudfsqpb2cpwuowf7eqscn","finding_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-call::loopback-proxy-bypass","identity_key":"github/scripts/js_examples/invoke_proxy.py::proxyhandler-call::loopback-proxy-bypass","line":209,"observation_digest":"4c5664b522b954a3daf680bb43f380fabdbfd657dd99bdc390cf36600f5a34bc","observation_id":"aro_v1_jrlgjnjcxfkkhwxwqc5uh44a7k","path":".github/scripts/js_examples/invoke_proxy.py","prior_finding_id":"","published_at":"2026-10-05T07:13:55Z","review_id":"arr_v1_lb24m3ntdz3bxfcp3ukviq3l52","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"845781ebe14c4086a8cb97c2318362f26b8cd3dd","reviewer":"codex","start_line":209,"suggestion_id":""},"pull_request":{"number":745},"record_id":"art_v1_k6p4pnl6klrwtt4hkftlrryyna","record_type":"finding_observed","recorded_at":"2026-10-05T07:13:55Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
