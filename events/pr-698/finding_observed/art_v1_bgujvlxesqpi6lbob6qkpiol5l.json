{"data":{"body":"[P1] Include the parent in checkpoint identity validation\n\n`OperationIdentifier` carries `parent_id`, but this validator compares only type, subtype, and name. Switching map/parallel between `FLAT` and `NESTED` preserves inner operation IDs while changing their parent, so replay accepts checkpoints from the old hierarchy. Compare `checkpoint.parent_id` with `self.parent_id`, including `None`, and add a nesting-drift regression test.","comment_node_id":"PRRC_kwDOPsIIsM7oVlO7","finding_digest":"ec9a21b87ff8a776a7616ac856bd981163a3a79d54e8811949329bc0907d43ad","finding_id":"arf_v1_5sncdod77ctxnj3bnlefnpmycf","finding_key":"identifier.py::operationidentifier.validate_checkpoint::parent-identity-validation","identity_key":"identifier.py::operationidentifier.validate_checkpoint::parent-identity-validation","line":68,"observation_digest":"4e105871f306641eefa73dce74f14d21d0b3cf12f6800f751f6958640893a987","observation_id":"aro_v1_jyifq4ptazsb535hhxhhj4kneh","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/identifier.py","prior_finding_id":"","published_at":"2026-08-31T20:10:10Z","review_id":"arr_v1_ndaj2fou5axmf4km6bz6wuke6p","reviewed_base_sha":"ae73e73a9749d8faf73fc5530ce0429a70a5a725","reviewed_head_sha":"335b745b98d71c033b6b469cfecc6ad9489eb439","reviewer":"codex","start_line":68,"suggestion_id":""},"pull_request":{"number":698},"record_id":"art_v1_bgujvlxesqpi6lbob6qkpiol5l","record_type":"finding_observed","recorded_at":"2026-08-31T20:10:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
