{"data":{"body":"[P1] Reject persisted containers when the current child is virtual\n\nWhen `ChildConfig(is_virtual=True)` replays a non-virtual child with the same identity, this lookup accepts its terminal checkpoint and returns the cached value without running the virtual body or validating its changed inner parents. Before terminal handling, reject any existing checkpoint when `self.is_virtual`, and add a non-virtual-to-virtual replay test.","comment_node_id":"PRRC_kwDOPsIIsM7p-w2Z","finding_digest":"856e8305ec1ad93cdd36952739c09f74587b246a0c47360b9f8d015fd8f3922a","finding_id":"arf_v1_qvxigbpmdlmtzxjwsutttqe7or","finding_key":"operation/child.py::childoperationexecutor.check_result_status::virtual-mode-must-not-consume-container-checkpoints","identity_key":"operation/child.py::childoperationexecutor.check_result_status::virtual-mode-must-not-consume-container-checkpoints","line":86,"observation_digest":"507de183e6139a4c808a51dd0188edd8ee07a64bd0c10c6273c1cb2e2f5ee8fb","observation_id":"aro_v1_kb66da7gconezaekkhoqdchn3d","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/operation/child.py","prior_finding_id":"arf_v1_qvxigbpmdlmtzxjwsutttqe7or","published_at":"2026-09-03T14:26:41Z","review_id":"arr_v1_hhkwgtypsgzj3ruhhq6llt5ege","reviewed_base_sha":"0b6b702cb6f5ddb5caaa84258704515814935938","reviewed_head_sha":"be1d349f153bf74d61e1104745b9ae77513f0697","reviewer":"codex","start_line":86,"suggestion_id":""},"pull_request":{"number":698},"record_id":"art_v1_eacq24p3rg77rskpccfr3sqwfq","record_type":"finding_observed","recorded_at":"2026-09-03T14:26:41Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
