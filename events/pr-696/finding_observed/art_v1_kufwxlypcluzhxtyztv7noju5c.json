{"data":{"body":"**[P2] Close attempts overwritten by same-key re-entry.** This sweep can retrieve only the latest span stored for each key. If an incomplete STEP resumes in-process with the same attempt, `_start_span()` replaces the first recording span; ending the replacement here leaves the original unreachable and unended. End or retain the existing attempt before replacement, and test that both span objects stop recording after re-entry.","comment_node_id":"PRRC_kwDOPsIIsM7qOE0f","finding_digest":"1d7a6163e24685b4fcd7a7ea3b4889b62ab1ac1e01aa4091989cf4c640399edc","finding_id":"arf_v1_dv5gcy7ci2c3j7gxu7vdwsejwy","finding_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","identity_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","line":546,"observation_digest":"fca0257b2614429ba3aad442ea902f3142ef3acc3577726fe0eceb085af9d282","observation_id":"aro_v1_7sqck6zgcrbjxi5k2rbovebpgf","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_plugin.py","prior_finding_id":"arf_v1_dv5gcy7ci2c3j7gxu7vdwsejwy","published_at":"2026-09-03T23:26:59Z","review_id":"arr_v1_ljttrxyjynvbj6mvdlic5hitlh","reviewed_base_sha":"38d94dc98bc73826b6d2eb978d65f6eeb9169ad1","reviewed_head_sha":"00efaf2f592cf28b40b0beb7b83746c4fd2dccee","reviewer":"codex","start_line":546,"suggestion_id":""},"pull_request":{"number":696},"record_id":"art_v1_kufwxlypcluzhxtyztv7noju5c","record_type":"finding_observed","recorded_at":"2026-09-03T23:26:59Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
