{"data":{"body":"**[P1] Do not re-export terminal contexts during replay.** This set is reset after every invocation, so ReplayChildren contexts calling `on_child_context_end(..., is_replayed=True)` export the same deterministic span again on each replay. Collectors may overwrite or reject the original span. Skip replayed terminal callbacks or otherwise make export uniqueness execution-wide, and add a multi-invocation ReplayChildren test asserting one export.","comment_node_id":"PRRC_kwDOPsIIsM7ppZx-","finding_digest":"d3da0dec184e0f285f443e19ff936dfcc8931469772f96d484aecb4ecd544d22","finding_id":"arf_v1_2pna33ayjyhsqx2ehym77e3n7t","finding_key":"otel/execution_plugin.py::on_operation_end::replayed-context-span-uniqueness","identity_key":"otel/execution_plugin.py::on_operation_end::replayed-context-span-uniqueness","line":618,"observation_digest":"79677e7f11d6a67b2809b63fadd91547e44c64ff05ffc36bf24d79e241c84215","observation_id":"aro_v1_pftx47yr22thwkajwy723wivi7","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_plugin.py","prior_finding_id":"arf_v1_2pna33ayjyhsqx2ehym77e3n7t","published_at":"2026-09-03T00:31:12Z","review_id":"arr_v1_jjmofwsaroeevpqujpf7ihwd32","reviewed_base_sha":"0b6b702cb6f5ddb5caaa84258704515814935938","reviewed_head_sha":"216222aaac4c038d1bb7fc8e2e010e80c8e2885c","reviewer":"codex","start_line":615,"suggestion_id":""},"pull_request":{"number":696},"record_id":"art_v1_vlszfen4vtcrllpfnnsnzcwdjf","record_type":"finding_observed","recorded_at":"2026-09-03T00:31:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
