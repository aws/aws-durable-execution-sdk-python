{"data":{"body":"**[P2] Close attempts overwritten by in-process re-entry.** This sweep sees only the latest span stored for each key. If an incomplete STEP re-enters the same attempt during one invocation, `_start_span()` replaces the existing `operation_id:attempt:N` entry, leaving the first recording span unreachable and unended. Reuse or end the existing attempt before replacement, or retain every open span, and extend the re-entry test to assert the original span is no longer recording.","comment_node_id":"PRRC_kwDOPsIIsM7pXemZ","finding_digest":"1d7a6163e24685b4fcd7a7ea3b4889b62ab1ac1e01aa4091989cf4c640399edc","finding_id":"arf_v1_dv5gcy7ci2c3j7gxu7vdwsejwy","finding_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","identity_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","line":512,"observation_digest":"f2f5aec962bc5285812cef61c4bd292e1c53d01ca57a3df5cb33067ad7e8bf9a","observation_id":"aro_v1_6l225slcxrjilajm55q4jpjjfy","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_plugin.py","prior_finding_id":"","published_at":"2026-09-02T14:35:15Z","review_id":"arr_v1_t6uybcwowwbijlesmbdes66ctp","reviewed_base_sha":"ea0bc35cef49b694999c0c2578ad3c76a381f844","reviewed_head_sha":"1d65bfb2afe19d529b7c2b3868efe172a4e145c6","reviewer":"codex","start_line":511,"suggestion_id":""},"pull_request":{"number":696},"record_id":"art_v1_237cnjvfsrhszqze3zc2vy37uj","record_type":"finding_observed","recorded_at":"2026-09-02T14:35:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
