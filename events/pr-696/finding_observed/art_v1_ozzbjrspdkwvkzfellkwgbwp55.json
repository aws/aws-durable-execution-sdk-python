{"data":{"body":"**[P2] Close attempts overwritten by in-process re-entry.** This sweep can see only the latest span stored for each key. If an incomplete STEP re-enters the same attempt, `_start_span()` replaces the first recording span; ending the replacement then leaves the original unreachable and unended. End or retain the existing attempt before replacement, and extend the re-entry test to assert the original span is no longer recording.","comment_node_id":"PRRC_kwDOPsIIsM7ppZ0-","finding_digest":"1d7a6163e24685b4fcd7a7ea3b4889b62ab1ac1e01aa4091989cf4c640399edc","finding_id":"arf_v1_dv5gcy7ci2c3j7gxu7vdwsejwy","finding_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","identity_key":"otel/execution_plugin.py::_end_open_recording_spans::reentered-attempt-closure","line":512,"observation_digest":"32a8e39e11437881b0c1e45c3d57dc208e9914afb7a462c09a34c740d05ba432","observation_id":"aro_v1_gkuohhqrin4idmgb4rod2v64ec","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_plugin.py","prior_finding_id":"arf_v1_dv5gcy7ci2c3j7gxu7vdwsejwy","published_at":"2026-09-03T00:31:14Z","review_id":"arr_v1_jjmofwsaroeevpqujpf7ihwd32","reviewed_base_sha":"0b6b702cb6f5ddb5caaa84258704515814935938","reviewed_head_sha":"216222aaac4c038d1bb7fc8e2e010e80c8e2885c","reviewer":"codex","start_line":511,"suggestion_id":""},"pull_request":{"number":696},"record_id":"art_v1_ozzbjrspdkwvkzfellkwgbwp55","record_type":"finding_observed","recorded_at":"2026-09-03T00:31:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
