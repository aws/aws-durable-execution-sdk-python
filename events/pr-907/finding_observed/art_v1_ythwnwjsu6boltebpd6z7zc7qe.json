{"data":{"body":"[P2] Approach: cover the missing-log-group branch\n\nDeleting this guard and its raise leaves the source assertions passing because the step and handler still contain `raise RuntimeError`. The cloud template always supplies the variable, so that scenario does not exercise this branch either. This violates rule 4, \u201cEvery branch has a test that fails without it,\u201d leaving the fail-fast configuration contract unprotected. Please return to the design phase under rule 8, step 6, and choose validation based on observable behavior.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABCo0Efg","finding_digest":"60f241212ea9f697efa79e6d3446163ad40f979b7dc70510dd51726b33716c06","finding_id":"arf_v1_mdzecijovh3jp35htzwtirqwhl","finding_key":"packages/aws-durable-execution-sdk-python-conformance-tests-telemetry/tests/test_telemetry_examples.py::test_telemetry_2_handler_raises_the_pinned_messages::untested-handler-branches","identity_key":"packages/aws-durable-execution-sdk-python-conformance-tests-telemetry/tests/test_telemetry_examples.py::test_telemetry_2_handler_raises_the_pinned_messages::untested-handler-branches","line":49,"observation_digest":"702070d753accaa346721e19a07d3b4be53c75136ed7d8219aa499612be8c1b3","observation_id":"aro_v1_oaqhbv2tvtfkgrtsdym2a7j3jp","path":"packages/aws-durable-execution-sdk-python-conformance-tests-telemetry/src/telemetry_2_failure.py","prior_finding_id":"arf_v1_mdzecijovh3jp35htzwtirqwhl","published_at":"2026-11-04T19:02:57Z","review_id":"arr_v1_j4lwjlisp5syrrgcjawkxmmqze","reviewed_base_sha":"7bed3879b6c1eebf0012984cf757825d02ea1f90","reviewed_head_sha":"ecfe5788a2a04450c2c1039e503cccce78364b1d","reviewer":"codex","start_line":48,"suggestion_id":""},"pull_request":{"number":907},"record_id":"art_v1_ythwnwjsu6boltebpd6z7zc7qe","record_type":"finding_observed","recorded_at":"2026-11-04T19:02:57Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
