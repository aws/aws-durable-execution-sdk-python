{"data":{"body":"[P2] Include the new error contract in the end-to-end validation design\n\nThe new assertions check inheritance and export identity, while the moved workflow tests still catch MicroVM-specific errors. No test under `tests/e2e/` exercises the new public `ComputeError` contract across operation failure and replay. AGENTS.md and CONTRIBUTING.md require e2e tests for public API changes. Following rule 9, return to the design phase under rule 8, step 6, and agree on end-to-end coverage for that contract.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABDVYghQ","finding_digest":"10fe20cd5efcea077362f842e1f3819961dd9559635199abfabc652a570c0441","finding_id":"arf_v1_cd7cbtk67tvao43c7bbod44btf","finding_key":"extras/tests/compute/microvm/errors_test.py::test_every_microvm_error_is_a_compute_error::missing-public-api-e2e-coverage","identity_key":"extras/tests/compute/microvm/errors_test.py::test_every_microvm_error_is_a_compute_error::missing-public-api-e2e-coverage","line":78,"observation_digest":"20da56eedf802e42eb7977eb41c9652326425239c2a207c08578f07a40fb169b","observation_id":"aro_v1_ednfn3w7qaxef23zo7vudslfem","path":"packages/aws-durable-execution-sdk-python-extras/tests/compute/microvm/errors_test.py","prior_finding_id":"","published_at":"2026-11-09T22:25:32Z","review_id":"arr_v1_kermildz4vx5gzgxqapyeuzrfc","reviewed_base_sha":"93751c4602e0fab6f476090a69db10b7b4e38cd4","reviewed_head_sha":"8b776afee152f0614143cded054a95c464deb0fc","reviewer":"codex","start_line":76,"suggestion_id":""},"pull_request":{"number":919},"record_id":"art_v1_wczfjixy3deljgiq5irlizio2y","record_type":"finding_observed","recorded_at":"2026-11-09T22:25:32Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
