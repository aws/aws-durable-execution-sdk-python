{"data":{"body":"[P2] Include the public error contract in the end-to-end test design\n\nThis assertion checks registry reconstruction directly; it does not exercise a handler catching `ComputeError` across operation failure and replay. The moved workflow tests still catch MicroVM-specific classes, and no test under `tests/e2e/` covers the new contract. This breaks the public-API integration-testing requirement in AGENTS.md and CONTRIBUTING.md. Following rule 9, return to the design phase under rule 8, step 6, and agree on end-to-end coverage for this contract.","comment_node_id":"","finding_digest":"10fe20cd5efcea077362f842e1f3819961dd9559635199abfabc652a570c0441","finding_id":"arf_v1_cd7cbtk67tvao43c7bbod44btf","finding_key":"extras/tests/compute/microvm/errors_test.py::test_every_microvm_error_is_a_compute_error::missing-public-api-e2e-coverage","identity_key":"extras/tests/compute/microvm/errors_test.py::test_every_microvm_error_is_a_compute_error::missing-public-api-e2e-coverage","line":111,"observation_digest":"012af9f8943af6ec6eb8fc53ac59400c39454255e9558e0533b38098f29d9767","observation_id":"aro_v1_aevpt6euhl3oy3vy7rj2ywkabq","path":"packages/aws-durable-execution-sdk-python-extras/tests/compute/microvm/errors_test.py","prior_finding_id":"arf_v1_cd7cbtk67tvao43c7bbod44btf","published_at":"2026-11-09T22:33:00Z","review_id":"arr_v1_k6nxjbt6dzf2aisarbnd7drasa","reviewed_base_sha":"93751c4602e0fab6f476090a69db10b7b4e38cd4","reviewed_head_sha":"08c2832823d559e54971426007c4d56cfed3ef8d","reviewer":"codex","start_line":111,"suggestion_id":"","suppressed":true,"suppression_status":"deferred"},"pull_request":{"number":919},"record_id":"art_v1_7rmfywjqkwhkydhkjzw7p2swkx","record_type":"finding_observed","recorded_at":"2026-11-09T22:33:00Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
