{"data":{"body":"**P1 \u2014 Version the core-side stabilization.** This changes the core distribution, but only OTel receives a version bump. An OTel-only release downloads the already-published SDK 2.0.0 wheel, so these metadata and documentation changes never reach customers. Bump core to a new version, require and pin that version, and cut a combined SDK/OTel release.","comment_node_id":"PRRC_kwDOPsIIsM7qkAEn","finding_digest":"40d18dfc39aa1acc436a922fb27d8d7e0407971e63e5bb0a45f0f1ea8c6d486a","finding_id":"arf_v1_idiy37bzvinmyq3ksix3e7mnpy","finding_key":"core/plugin.py::payload-field-stabilization::unversioned-core-release","identity_key":"core/plugin.py::payload-field-stabilization::unversioned-core-release","line":100,"observation_digest":"67709666acc5ae13cbaa9014e7821e38152fa809243641733856360087b7fd23","observation_id":"aro_v1_m5yjmzvmywxbhs5ksakopaq6ha","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/plugin.py","prior_finding_id":"","published_at":"2026-09-04T15:07:19Z","review_id":"arr_v1_3nsx46uzprmrra2z2x7w65ufyn","reviewed_base_sha":"f560c4a1c532702196337e61ed897d2586ae7a63","reviewed_head_sha":"a0a10531b1e15aefca1d4204d7a60f637e8514e1","reviewer":"codex","start_line":100,"suggestion_id":""},"pull_request":{"number":707},"record_id":"art_v1_uwweulvvorwxp74gwtb6lttbqq","record_type":"finding_observed","recorded_at":"2026-09-04T15:07:19Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
