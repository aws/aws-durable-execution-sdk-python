{"data":{"body":"[P3] Document the pass-through callback default\n\n`Callback.result()` selects `PASS_THROUGH_SERDES` when `serdes` is omitted, so a JSON callback payload is returned as a string rather than a decoded object. This documentation can lead callers to treat that string as a dictionary and fail. Describe the pass-through default; JSON decoding requires an explicit serializer.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABBJg1og","finding_digest":"3bf2e26b49ae2d493d28c2c412755dad9db8bf7bc38fd4dfc84b63ccc9608203","finding_id":"arf_v1_hpzoe22jvywuspjiylcbe5k5vw","finding_key":"config.py::callbackconfig.serdes::incorrect-default-deserialization","identity_key":"config.py::callbackconfig.serdes::incorrect-default-deserialization","line":695,"observation_digest":"72c3264009967a186223ffc78eea23c69e871d7ed505a3f5d260914badfae625","observation_id":"aro_v1_olbsmqajsz5bqyrd77dy52rdy2","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/config.py","prior_finding_id":"","published_at":"2026-10-25T19:10:39Z","review_id":"arr_v1_64zw6zllhs2wuk27dz5jx27pqo","reviewed_base_sha":"22e1e3ffb67db3fecaf9d69d3fb746cdb16a9bc7","reviewed_head_sha":"483c445d9fdda6f72c7424df68a7b7aa777df354","reviewer":"codex","start_line":695,"suggestion_id":"arsg_v1_gyq57g47d6dh6s2ybbmxqqzeel"},"pull_request":{"number":837},"record_id":"art_v1_f6akujuu4p53almiqvzpanpsjy","record_type":"finding_observed","recorded_at":"2026-10-25T19:10:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
