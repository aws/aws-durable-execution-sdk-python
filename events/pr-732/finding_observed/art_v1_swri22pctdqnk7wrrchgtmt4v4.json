{"data":{"body":"The timeout also covers socket writes, so exporting a large record can time out when a peer stops consuming it. Conversely, successful response bodies are never read; slow response bytes only prolong the export while reading status/headers or a non-2xx error body. Document those phases accurately here and in the README and `_common.py` copies.","comment_node_id":"PRRC_kwDOPsIIsM7wJKOe","finding_digest":"9a8c1cae16db0f8aec3b524ed5fb47213e9c9c8100f5bb77926cee98270f47bf","finding_id":"arf_v1_tkgbzlqw3mhyv3b3kjhnl62hee","finding_key":"insight/http_exporter.py::httpexporter::timeout-io-scope","identity_key":"insight/http_exporter.py::httpexporter::timeout-io-scope","line":38,"observation_digest":"e14781d02c123ca9beee9324f6b01f59608f1c140c70f45bf698e2559b562396","observation_id":"aro_v1_4fdydubmci6ktpxosmspnma7lf","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/http_exporter.py","prior_finding_id":"arf_v1_tkgbzlqw3mhyv3b3kjhnl62hee","published_at":"2026-09-16T17:35:00Z","review_id":"arr_v1_qglin62xh2trlm2fzmsdmtkgkv","reviewed_base_sha":"86ea45c3e4a891bc7969f8ca1323064d9287d792","reviewed_head_sha":"6c6f2d70da085b0d079b81a7054459fba9216a04","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":732},"record_id":"art_v1_swri22pctdqnk7wrrchgtmt4v4","record_type":"finding_observed","recorded_at":"2026-09-16T17:35:00Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
