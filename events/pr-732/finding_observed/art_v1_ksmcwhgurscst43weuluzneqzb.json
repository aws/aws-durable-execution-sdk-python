{"data":{"body":"The timeout also applies while `urllib` sends request headers/body, which matters when a peer stops consuming a potentially large record. Conversely, `http_send` never reads a successful response body, so a slowly streamed 2xx body does not prolong the export; only status/headers and non-2xx error bodies are read. Update this docstring and the README/`_common.py` copies to describe connect, send, status/header reads, and error-body reads accurately.","comment_node_id":"PRRC_kwDOPsIIsM7wIfim","finding_digest":"9a8c1cae16db0f8aec3b524ed5fb47213e9c9c8100f5bb77926cee98270f47bf","finding_id":"arf_v1_tkgbzlqw3mhyv3b3kjhnl62hee","finding_key":"insight/http_exporter.py::httpexporter::timeout-io-scope","identity_key":"insight/http_exporter.py::httpexporter::timeout-io-scope","line":40,"observation_digest":"f26a6070b4da82e3976645f3d505c5c56eb6a668ea04b25a2a143061b88a6685","observation_id":"aro_v1_6jvga4fu3kbohf3gixz5kbofyv","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/http_exporter.py","prior_finding_id":"","published_at":"2026-09-16T17:16:02Z","review_id":"arr_v1_abtqdgnsmu4gnpkdgu6sllkdho","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"44c88129cbba7874b8a9b459fdda2c05903a9b16","reviewer":"codex","start_line":37,"suggestion_id":""},"pull_request":{"number":732},"record_id":"art_v1_ksmcwhgurscst43weuluzneqzb","record_type":"finding_observed","recorded_at":"2026-09-16T17:16:02Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
