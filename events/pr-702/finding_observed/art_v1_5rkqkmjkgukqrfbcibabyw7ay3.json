{"data":{"body":"**[P2] Preserve bounded timezone values for custom renderers.** A transformed value such as `datetime.timezone.utc` has no instance dictionary or slots and is not in the safe-type list, so it reaches this fallback and the entire record is dropped before `exporter.render()` can normalize it. Add safe retained handling for `datetime.timezone`, including its offset/name state, or implement a general bounded-opaque policy with a regression test.","comment_node_id":"PRRC_kwDOPsIIsM7s8LM-","finding_digest":"45c6b7e59c258cff3290510a9fd3bada9db7088ef5c67825bf6b0070991937b8","finding_id":"arf_v1_ixdlpzm4ewgp6muqkefj7u523k","finding_key":"insight/_export_scheduler.py::_exportscheduler.schedule::pre-render-admission-rejection","identity_key":"insight/_export_scheduler.py::_exportscheduler.schedule::pre-render-admission-rejection","line":164,"observation_digest":"6473df222aaace01f1b9fbe780e65ebc449f2b299bd8c8a2d53728ad0f030721","observation_id":"aro_v1_mrz56irkvlhad4nz7ptybzs6xr","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/_export_scheduler.py","prior_finding_id":"arf_v1_ixdlpzm4ewgp6muqkefj7u523k","published_at":"2026-09-10T03:33:20Z","review_id":"arr_v1_aazv6mtkt4toiyvp5s2wmlz7z4","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"7b5c6a3383009fd90a86136b6e2622d45636fa24","reviewer":"codex","start_line":164,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_5rkqkmjkgukqrfbcibabyw7ay3","record_type":"finding_observed","recorded_at":"2026-09-10T03:33:20Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
