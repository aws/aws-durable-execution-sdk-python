{"data":{"body":"**[P2] Avoid invoking `__sizeof__` on the checkpoint thread.** `sys.getsizeof()` dispatches to a user-defined `__sizeof__`, so a value returned by a content/result transform can block indefinitely here; exception handling cannot contain a hang. Size only exact built-ins through non-overridable descriptors or fail closed for custom types, and add a sentinel `__sizeof__` regression.","comment_node_id":"PRRC_kwDOPsIIsM7s716p","finding_digest":"8c6c8c863cf549979485d6b7d23c25a3385b07a01938da8a8783d4f610964734","finding_id":"arf_v1_rrwizbr46vezpfef2235epbfum","finding_key":"insight/_export_scheduler.py::_retained_shallow_size::overridable-size-hook","identity_key":"insight/_export_scheduler.py::_retained_shallow_size::overridable-size-hook","line":169,"observation_digest":"cd512f36905c1f625b87899c971fd4e784c6a80a2bd0d9e8aa2ead109d83b02a","observation_id":"aro_v1_zvis6nuqlqpwew4hrgojoh6u46","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/_export_scheduler.py","prior_finding_id":"","published_at":"2026-09-10T03:12:24Z","review_id":"arr_v1_xu5asg75ee3ff5ephagorp56ks","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"3a78affbb4beb7c25b916c32f6a9d81bd33f714e","reviewer":"codex","start_line":169,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_cmoq4coibxl67rafspbj2fcu6b","record_type":"finding_observed","recorded_at":"2026-09-10T03:12:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
