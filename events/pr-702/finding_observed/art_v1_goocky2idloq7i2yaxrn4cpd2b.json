{"data":{"body":"**[P2] Charge in-flight work until export releases it.** Subtracting here frees the whole budget while the source record, lane-local copy, and blocked `export()` still retain it. Another full budget can then be queued, exceeding the documented bound per exporter. Track pending plus in-flight/copy bytes and release the charge in `finally`; test two near-budget records with the first export blocked.","comment_node_id":"PRRC_kwDOPsIIsM7s715F","finding_digest":"fefef5ae3cb54f4f3d8dbd5ab933f3b9716d65fe276fc6ee9a3ec593d58cb7ee","finding_id":"arf_v1_737pllr4wvhu6pmnxvnlsm7txf","finding_key":"insight/_export_scheduler.py::_exporterlane._run_worker::inflight-byte-budget-exclusion","identity_key":"insight/_export_scheduler.py::_exporterlane._run_worker::inflight-byte-budget-exclusion","line":493,"observation_digest":"54250d9db4f941bcb709641b6b9365df1d415157d0eaebc65fe8fe7cf3a8e91f","observation_id":"aro_v1_kqsq3hnu7fa3znyjmqnwxe3f34","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/_export_scheduler.py","prior_finding_id":"","published_at":"2026-09-10T03:12:23Z","review_id":"arr_v1_xu5asg75ee3ff5ephagorp56ks","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"3a78affbb4beb7c25b916c32f6a9d81bd33f714e","reviewer":"codex","start_line":493,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_goocky2idloq7i2yaxrn4cpd2b","record_type":"finding_observed","recorded_at":"2026-09-10T03:12:23Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
