{"data":{"body":"**[P2] Preserve other invocations' detached flushes.** This deletes every detached marker before confirming that this barrier remains queued. If this barrier was already popped while a later concurrent invocation installed its timeout marker, the older cancellation erases the later flush, allowing buffered records to be exported and then abandoned on worker exit. Find this barrier first and preserve the rightmost flush marker when coalescing; add the two-barrier race test.","comment_node_id":"PRRC_kwDOPsIIsM7s718H","finding_digest":"c1f45b80f8553d190c237bc947db26a4097f0133b5602f89663ac7c6af01e73d","finding_id":"arf_v1_yh2fxahyku6rsdbdppeupwzguq","finding_key":"insight/_export_scheduler.py::_exporterlane.cancel_flush::cross-barrier-flush-deletion","identity_key":"insight/_export_scheduler.py::_exporterlane.cancel_flush::cross-barrier-flush-deletion","line":386,"observation_digest":"bca612dac10e1801c70e11dddce8256a779e787a45577962ad721d835230d8de","observation_id":"aro_v1_xstbfwwbbymadryocho5z2bfnj","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/_export_scheduler.py","prior_finding_id":"","published_at":"2026-09-10T03:12:26Z","review_id":"arr_v1_xu5asg75ee3ff5ephagorp56ks","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"3a78affbb4beb7c25b916c32f6a9d81bd33f714e","reviewer":"codex","start_line":380,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_m5jrw4shtrbckmlrqds562c6uq","record_type":"finding_observed","recorded_at":"2026-09-10T03:12:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
