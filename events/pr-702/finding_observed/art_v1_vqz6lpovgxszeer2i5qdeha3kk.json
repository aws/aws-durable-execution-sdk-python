{"data":{"body":"**[P2] Include owned attributes in special-case traversal.** `custom` contains the object's `__dict__` and slots, but this branch discards it; the function and atomic branches below do likewise. Because copying preserves these objects verbatim, a `functools.partial` with a large attached buffer is estimated as tiny and can exceed the 16 MB lane budget. Chain owned attributes into these branches, use exact-type checks for atomic built-ins, and add large partial/subclass tests.","comment_node_id":"PRRC_kwDOPsIIsM7s7fCZ","finding_digest":"ea6c1cf3405a9df9ac9ecf0e969171cbe08e51ef48754894a52ee1a6db3c26bc","finding_id":"arf_v1_5jwbz42alko7tle6z4hjnelrzp","finding_key":"insight/_export_scheduler.py::_exporterlane._pending::unbounded-record-bytes","identity_key":"insight/_export_scheduler.py::_exporterlane._pending::unbounded-record-bytes","line":118,"observation_digest":"227be917969d7fe4b2d3f4090f2cd73204be2dabed411d086572d137dacfe35a","observation_id":"aro_v1_ej56sf4wtv76jmwt6qeq6lgxgi","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/_export_scheduler.py","prior_finding_id":"arf_v1_5jwbz42alko7tle6z4hjnelrzp","published_at":"2026-09-10T02:50:41Z","review_id":"arr_v1_k4hrjqgchgrlblks6ft3hhim26","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"4bd5e14f415ee5f249d3e4ff6501b023bcf916f7","reviewer":"codex","start_line":118,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_vqz6lpovgxszeer2i5qdeha3kk","record_type":"finding_observed","recorded_at":"2026-09-10T02:50:41Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
