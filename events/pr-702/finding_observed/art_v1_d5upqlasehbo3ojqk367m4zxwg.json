{"data":{"body":"**[P2] Preserve the duplicate-exporter invariant after validation.** `exporters` remains a caller-owned mutable list, so mutating it after config construction can add the same instance twice and make `workflow_insight(config)` create two lanes that concurrently call that exporter. Snapshot it to an immutable collection during `__post_init__`, or revalidate the copied list immediately before scheduler construction, and test mutation after configuration.","comment_node_id":"PRRC_kwDOPsIIsM7sK4gO","finding_digest":"5d366e836444d0727644fee0fefd02440bb0c3ffa1b94949dd3615e91452b05f","finding_id":"arf_v1_lu3g5a3eitihe5se73qp57iciq","finding_key":"insight/types.py::workflowinsightconfig._validate_exporters::post-validation-mutation","identity_key":"insight/types.py::workflowinsightconfig._validate_exporters::post-validation-mutation","line":128,"observation_digest":"6136ae83a2525e2e1f969e8ca8259fdc91446d16284c4d042514570fd43df64d","observation_id":"aro_v1_me3k5a5ckjpc4h4wt2gkqjm73s","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/types.py","prior_finding_id":"","published_at":"2026-09-08T21:09:44Z","review_id":"arr_v1_6jnifbi3l5kkwf6feew3hw67hz","reviewed_base_sha":"b7b10c7f5640615a4974b793b7618dfb4a37a59b","reviewed_head_sha":"2e81513927cad0f0d7ee3440e4336cd9b4be0dd3","reviewer":"codex","start_line":128,"suggestion_id":""},"pull_request":{"number":702},"record_id":"art_v1_d5upqlasehbo3ojqk367m4zxwg","record_type":"finding_observed","recorded_at":"2026-09-08T21:09:44Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
