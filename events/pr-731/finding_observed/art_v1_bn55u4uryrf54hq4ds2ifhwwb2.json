{"data":{"body":"**[P2] Populate `LambdaContext.function_name` for invoked targets.** The helper now receives the target name and builds a target-specific ARN, but still leaves the corresponding `function_name` field as `None`. Registered plain and durable handlers that use this standard Lambda context attribute therefore behave differently locally. Set it to the bare target name, handling qualifiers separately, and test both target kinds.","comment_node_id":"PRRC_kwDOPsIIsM7wVju_","finding_digest":"eea501d22f8edc2c70557d22181c3524ca6b53045c4e401ce92621f6cdd24474","finding_id":"arf_v1_52sqdurpr3ocy4cvpurbqhbvet","finding_key":"testing/invoker.py::create_test_lambda_context::function-name-not-populated","identity_key":"testing/invoker.py::create_test_lambda_context::function-name-not-populated","line":152,"observation_digest":"94b52bb84d7b545364ee0f85cd3eb927bc693e75d3efdad4cf8891090b8a4a68","observation_id":"aro_v1_ss2sxocnpnkfgzhob6c42pvze6","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/invoker.py","prior_finding_id":"","published_at":"2026-09-17T01:13:25Z","review_id":"arr_v1_jcubvkvc46wxo6g6noxo6h2xup","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"3d178588333d0735a6fc4b6223119a885347eb6e","reviewer":"codex","start_line":149,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_bn55u4uryrf54hq4ds2ifhwwb2","record_type":"finding_observed","recorded_at":"2026-09-17T01:13:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
