{"data":{"body":"**P2:** `join(timeout)` only stops waiting; the daemon target thread continues executing after the parent receives `Sandbox.Timedout`. Its side effects can therefore occur after failure, overlap parent progress, or leak into later tests, unlike a Lambda invocation terminated at timeout. Run targets in a killable process or otherwise guarantee termination before returning the timeout outcome.","comment_node_id":"PRRC_kwDOPsIIsM7wf-p_","finding_digest":"2d25f274e4be432243de5d46585c13ddbf4de4b974512299e31e08037c96a42e","finding_id":"arf_v1_fus7e5hexzbseq66lvdfqxat3w","finding_key":"testing/child_dispatcher.py::_run_single_invocation::timed-out-target-continues","identity_key":"testing/child_dispatcher.py::_run_single_invocation::timed-out-target-continues","line":582,"observation_digest":"f33a589ec93cdf504e3a8abadd61ece751551fa0673662b704f5653e0468ed4d","observation_id":"aro_v1_6m5frhwjhtpvatr2rk5n2ypm45","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/child_dispatcher.py","prior_finding_id":"","published_at":"2026-09-17T08:52:45Z","review_id":"arr_v1_xsrr7eksstd5bhluxvdunv7xkn","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"75207a5f280325db0836892471924779f0f7bcc8","reviewer":"codex","start_line":576,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_lwudcuo3aoepxfwgvye6cmkg6j","record_type":"finding_observed","recorded_at":"2026-09-17T08:52:45Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
