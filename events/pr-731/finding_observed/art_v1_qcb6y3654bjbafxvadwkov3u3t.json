{"data":{"body":"**P2:** `join(timeout)` only stops waiting; the daemon target thread continues after the invocation is reported as timed out. Its side effects can occur after failure, overlap parent progress, or leak into later tests. Run plain targets in a killable process or otherwise guarantee termination before returning the timeout outcome.","comment_node_id":"PRRC_kwDOPsIIsM7wg2y0","finding_digest":"d4e8c32377709a0d1f0920c3e698e048f5190b35ffe986eb2a452d285708c71e","finding_id":"arf_v1_2tumgi3xocna2hyjedb6nghajd","finding_key":"testing/child_dispatcher.py::_run_single_invocation::timed-out-target-continues","identity_key":"testing/runner.py::web_runner_config::positional-field-order-compatibility","line":583,"observation_digest":"7586cae1bfff4c9d60d9a2277ade0a2da2fe7d05161a20e92edefa044bc4c3b8","observation_id":"aro_v1_owdmvyn775gj2ygzuitxvxqkfw","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/child_dispatcher.py","prior_finding_id":"arf_v1_2tumgi3xocna2hyjedb6nghajd","published_at":"2026-09-17T09:20:39Z","review_id":"arr_v1_6fgbuaf6kfgym33jkdawdtz66x","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"016ccb33c00e7b8840da85de747444f9ec131aec","reviewer":"codex","start_line":582,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_qcb6y3654bjbafxvadwkov3u3t","record_type":"finding_observed","recorded_at":"2026-09-17T09:20:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
