{"data":{"body":"**P2:** `WebRunnerConfig` is a public exported dataclass, and inserting this field before `skip_time` changes existing positional calls: the old boolean is now treated as function configurations and later fails on `.lookup()`. Preserve positional compatibility by making the new option keyword-only or appending it after existing fields.","comment_node_id":"PRRC_kwDOPsIIsM7wf-tz","finding_digest":"d4e8c32377709a0d1f0920c3e698e048f5190b35ffe986eb2a452d285708c71e","finding_id":"arf_v1_2tumgi3xocna2hyjedb6nghajd","finding_key":"testing/runner.py::web_runner_config::positional-field-order-compatibility","identity_key":"testing/runner.py::web_runner_config::positional-field-order-compatibility","line":133,"observation_digest":"2cd91981e5a9d12250305075d4499de8177004f5434d8b70d8d2e2c9cc7e8bbf","observation_id":"aro_v1_ftmrtapfvhiseubqkb25ism55a","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/runner.py","prior_finding_id":"","published_at":"2026-09-17T08:52:47Z","review_id":"arr_v1_xsrr7eksstd5bhluxvdunv7xkn","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"75207a5f280325db0836892471924779f0f7bcc8","reviewer":"codex","start_line":133,"suggestion_id":"arsg_v1_6ay4l5uevkkbd7vujjkyv3wo5v"},"pull_request":{"number":731},"record_id":"art_v1_b5stxyc46jjticq63bpz4ex43b","record_type":"finding_observed","recorded_at":"2026-09-17T08:52:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
