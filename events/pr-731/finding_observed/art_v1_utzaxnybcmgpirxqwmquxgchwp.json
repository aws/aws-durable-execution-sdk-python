{"data":{"body":"**P2:** Waiting only until `_launch_execution()` queues the first invocation does not make the child survive shutdown. `_closing` is already true, so that invocation is canceled or its result is dropped, leaving the persisted child and parent operation STARTED. Make the launch durably recoverable before releasing the in-flight count, and test resulting state rather than only scheduler call counts.","comment_node_id":"PRRC_kwDOPsIIsM7wf-mb","finding_digest":"933c833314bdacb3bbc23d78a07b7e1ef9a679c4205bb5a94755649e903288c8","finding_id":"arf_v1_sm6igmyuxwwlho6chv4ka636d3","finding_key":"testing/executor.py::shutdown::running-pool-work-survives","identity_key":"testing/executor.py::shutdown::running-pool-work-survives","line":2312,"observation_digest":"9d0d8a66cba737ce2e29dbc80257490e049aa5236fdd22ce162970924095c3f7","observation_id":"aro_v1_tugyuzwlu4344lrj3peaev2jby","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/executor.py","prior_finding_id":"arf_v1_sm6igmyuxwwlho6chv4ka636d3","published_at":"2026-09-17T08:52:43Z","review_id":"arr_v1_xsrr7eksstd5bhluxvdunv7xkn","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"75207a5f280325db0836892471924779f0f7bcc8","reviewer":"codex","start_line":2312,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_utzaxnybcmgpirxqwmquxgchwp","record_type":"finding_observed","recorded_at":"2026-09-17T08:52:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
