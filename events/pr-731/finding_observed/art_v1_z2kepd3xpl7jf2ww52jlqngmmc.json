{"data":{"body":"**P1:** This effect is emitted only after the STARTED operation and checkpoint idempotency response have been persisted. A crash, scheduler failure, or shutdown before `on_chained_invoke_started()` loses the only dispatch signal; retrying the checkpoint replays the cache and never creates a target, leaving the operation STARTED forever. Persist an idempotent dispatch/outbox record with the checkpoint and reconcile it on startup before acknowledging or replaying the checkpoint.","comment_node_id":"PRRC_kwDOPsIIsM7weq4w","finding_digest":"471da4bccee8997af1d26a3ea0b813cfe2675bf59ebff1bfd35f636c783dee9e","finding_id":"arf_v1_i4o2jpgo5cmxv4osni7kboatz7","finding_key":"testing/checkpoint/processors/invoke.py::process::dispatch-effect-not-recoverable","identity_key":"testing/checkpoint/processors/invoke.py::process::dispatch-effect-not-recoverable","line":110,"observation_digest":"c6a67f34b75b22bf1a8c6528973639bcdffca755643028e95948bf70b75dec7e","observation_id":"aro_v1_y2th6nfxlmrl6gummuujonrzxt","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/checkpoint/processors/invoke.py","prior_finding_id":"arf_v1_i4o2jpgo5cmxv4osni7kboatz7","published_at":"2026-09-17T08:11:05Z","review_id":"arr_v1_3bvcew2vfedcjt5bvjy2l7kotx","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"7f5a1277cabc95bdaf6569c272003069e50f6458","reviewer":"codex","start_line":110,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_z2kepd3xpl7jf2ww52jlqngmmc","record_type":"finding_observed","recorded_at":"2026-09-17T08:11:05Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
