{"data":{"body":"**P1:** The STARTED operation and idempotency response are persisted before this in-memory notification is applied. A crash or scheduling failure loses the only dispatch signal; replaying the checkpoint hits the cache and leaves the invoke STARTED forever. Persist an idempotent dispatch/outbox record with the checkpoint and reconcile it on startup or replay.","comment_node_id":"PRRC_kwDOPsIIsM7wf-e2","finding_digest":"471da4bccee8997af1d26a3ea0b813cfe2675bf59ebff1bfd35f636c783dee9e","finding_id":"arf_v1_i4o2jpgo5cmxv4osni7kboatz7","finding_key":"testing/checkpoint/processors/invoke.py::process::dispatch-effect-not-recoverable","identity_key":"testing/checkpoint/processors/invoke.py::process::dispatch-effect-not-recoverable","line":111,"observation_digest":"8b93a84cd6733a90c543a1e9ba7c29f8639f4df0228e0b75d9a69ff2033b7a99","observation_id":"aro_v1_roj2qtgwom5jbrkduhu3u7bj7b","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/checkpoint/processors/invoke.py","prior_finding_id":"arf_v1_i4o2jpgo5cmxv4osni7kboatz7","published_at":"2026-09-17T08:52:40Z","review_id":"arr_v1_xsrr7eksstd5bhluxvdunv7xkn","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"75207a5f280325db0836892471924779f0f7bcc8","reviewer":"codex","start_line":111,"suggestion_id":""},"pull_request":{"number":731},"record_id":"art_v1_xrnjdycqrxvhruza57nim2ktbi","record_type":"finding_observed","recorded_at":"2026-09-17T08:52:40Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
