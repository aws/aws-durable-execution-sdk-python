{"data":{"body":"**[P2] Bound connection establishment by the remaining deadline**\n\n`socket.create_connection()` applies this timeout independently to every resolved address while `conn.sock` remains unavailable to the timer. Multi-address failures can therefore block for multiples of `timeout`; `_after_connect` only rejects a late success. Implement a deadline-aware address loop that recalculates the remaining budget and exposes the in-flight socket for shutdown, then assert elapsed time in the slow-connect test.","comment_node_id":"PRRC_kwDOPsIIsM7vqrb8","finding_digest":"8de6757cce301331da15d14d1a50402a63abc16c631f83cb4021706b919c6e3f","finding_id":"arf_v1_rxthk7gogajtdwqv2fgruucafj","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::whole-request-deadline-during-connect","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::whole-request-deadline-during-connect","line":74,"observation_digest":"271874712926a7f762020b3863701e34fcfafb525034f4d639f567bbb08a9788","observation_id":"aro_v1_e4mhi4jje2t7oyqcbm4gg4a6gt","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_rxthk7gogajtdwqv2fgruucafj","published_at":"2026-09-15T22:59:03Z","review_id":"arr_v1_y4ciaxbdlrpkq2gi7z7ncoxmd3","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"37e5029b35d0568b5fc10a55ff1862baea2d4de8","reviewer":"codex","start_line":74,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_da7apxiyn26dadpeumpjwnylzi","record_type":"finding_observed","recorded_at":"2026-09-15T22:59:03Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
