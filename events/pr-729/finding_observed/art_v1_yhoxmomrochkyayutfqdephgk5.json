{"data":{"body":"**[P2] Retain the standard HTTPS ALPN configuration**\n\nPassing an explicit `ssl.create_default_context()` bypasses `HTTPSConnection`'s built-in context setup, which advertises `http/1.1` through ALPN. HTTPS endpoints that require protocol negotiation can now reject the handshake. Let `HTTPSConnection` create its default context or configure the explicit context equivalently, with a TLS ALPN regression test.","comment_node_id":"PRRC_kwDOPsIIsM7vqrl0","finding_digest":"fcbdd844996a9878dbb0fc654c192e2190fa43295aa6d249944dedbc96992e5f","finding_id":"arf_v1_7s65qreznkmhrw5q7rsuygjoeg","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::https-alpn-preservation","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::https-alpn-preservation","line":167,"observation_digest":"67d2ff95ec893375719106feda1b8efe8f1e0d39d3caca703c4b9169fb0d161c","observation_id":"aro_v1_m7jp7fpmrezxk4mra37nug4o72","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-15T22:59:10Z","review_id":"arr_v1_y4ciaxbdlrpkq2gi7z7ncoxmd3","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"37e5029b35d0568b5fc10a55ff1862baea2d4de8","reviewer":"codex","start_line":167,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_yhoxmomrochkyayutfqdephgk5","record_type":"finding_observed","recorded_at":"2026-09-15T22:59:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
