{"data":{"body":"**[P2] Coalesce headers case-insensitively before sending**\n\n`Request.add_header()` previously made the last differently-cased header win. `http.client` emits every mapping entry, so `headers={\"content-type\": ...}` now sends both the exporter's default `Content-Type` and the user's override; endpoints may reject the request or use the wrong value. Normalize headers case-insensitively with last-value-wins semantics and test that only one header is received.","comment_node_id":"PRRC_kwDOPsIIsM7vqrjN","finding_digest":"c2be430a5b625a1f1368657cded1e4fb2e6be95e0f21c2d26027387783c1aae7","finding_id":"arf_v1_yk7egcs3mjnb6e3imv6n5upe7m","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::case-insensitive-header-overrides","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::case-insensitive-header-overrides","line":195,"observation_digest":"534075507c23a14b94df04c4f1112d3ee4278538cfff79e150d3c05c683d5411","observation_id":"aro_v1_knahkud4eoquxfg7atcpcejnh3","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-15T22:59:08Z","review_id":"arr_v1_y4ciaxbdlrpkq2gi7z7ncoxmd3","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"37e5029b35d0568b5fc10a55ff1862baea2d4de8","reviewer":"codex","start_line":195,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_gkkyzarxjuw34jnxs5kgv2mk5d","record_type":"finding_observed","recorded_at":"2026-09-15T22:59:08Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
