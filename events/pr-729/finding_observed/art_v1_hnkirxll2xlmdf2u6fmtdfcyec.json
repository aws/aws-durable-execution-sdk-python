{"data":{"body":"**[P2] Preserve environment proxy routing**\n\nThe removed opener used Python's `ProxyHandler`; these direct connections now fail wherever egress requires `HTTP_PROXY` or `HTTPS_PROXY`, and also lose `NO_PROXY`, proxy authentication, and HTTPS `CONNECT` behavior. Preserve proxy discovery and bypass handling while applying the deadline, and add HTTP/HTTPS proxy regression tests.","comment_node_id":"PRRC_kwDOPsIIsM7vqrZA","finding_digest":"5dee70e51aa88eaa00f436115306334d8936f4d42d25a73feafd7ce9b33b40e6","finding_id":"arf_v1_lxxhbzi2vchkuahugyivgbrtjw","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::proxy-routing-preservation","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::proxy-routing-preservation","line":151,"observation_digest":"9a67f710ae71c5d8a59a2a0668acdb846a92f178bcb86074eedd84ef931dcb07","observation_id":"aro_v1_tjt7oefoohc5rjm2fidgrlg3qr","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_lxxhbzi2vchkuahugyivgbrtjw","published_at":"2026-09-15T22:59:02Z","review_id":"arr_v1_y4ciaxbdlrpkq2gi7z7ncoxmd3","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"37e5029b35d0568b5fc10a55ff1862baea2d4de8","reviewer":"codex","start_line":150,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_hnkirxll2xlmdf2u6fmtdfcyec","record_type":"finding_observed","recorded_at":"2026-09-15T22:59:02Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
