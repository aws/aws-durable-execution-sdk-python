{"data":{"body":"**[P1] Redact the endpoint from timeout errors**\n\n`_ExportScheduler` logs exporter exceptions verbatim, so a routine timeout now writes the complete configured URL\u2014including userinfo or signed query parameters\u2014to application logs. Omit it or format only a safely redacted origin, and add a regression test using a secret-bearing URL.","comment_node_id":"PRRC_kwDOPsIIsM7vreuP","finding_digest":"e9ef2b0345144fc571c964d3bed63aeb25ce0567996821567f14aac6b690687e","finding_id":"arf_v1_5hxswa2fcrh4k4ojmtj35vr25m","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::timeout-url-redaction","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::timeout-url-redaction","line":292,"observation_digest":"2111c813995501d06263a027eaaabd9594a6a4f255b1e8c7229f4346f57dcb01","observation_id":"aro_v1_eei4qe4zkua5aytduat6vkv5sw","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-15T23:32:18Z","review_id":"arr_v1_eebpolbfrjetvavyjht3od2yr2","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"886e8930b2ef5ab9cc92d4fe87b117de642d912a","reviewer":"codex","start_line":292,"suggestion_id":"arsg_v1_7nhd7lqmhd4ai4xcilwpdfrl2e"},"pull_request":{"number":729},"record_id":"art_v1_vy3npxg723fyqahukgfi4fkcwx","record_type":"finding_observed","recorded_at":"2026-09-15T23:32:18Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
