{"data":{"body":"**[P2] Do not swallow deadline expiry while reading an error body**\n\nIf non-2xx headers arrive before the deadline but the body stalls, the timer's socket shutdown makes `response.read()` fail; this broad handler suppresses that failure and returns the status, causing `HttpExporter` to raise `RuntimeError` instead of the promised `TimeoutError`. Check `expired` after both successful and failed body reads and propagate a timeout when set. Add a regression test with an immediate error status and a trickled response body.","comment_node_id":"PRRC_kwDOPsIIsM7vpdVd","finding_digest":"a1673fbeb081d533f1aaacb4702ea0b6d0a6bbe76f961c9062b6524b5ccd739c","finding_id":"arf_v1_uftt7pvqqhkth4nkvs2halvaw3","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::error-body-deadline-propagation","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::error-body-deadline-propagation","line":136,"observation_digest":"93378880ae24dcdcef2380bf4181901bc0bb4a7af6f233fc10bb17fcf7668401","observation_id":"aro_v1_sm3yrafoetonz3zdqc7udamqdp","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-15T22:05:05Z","review_id":"arr_v1_vzqvk7bxp55s6e4dweav2lirxm","reviewed_base_sha":"5a09149848101e44a4281c53c74dc9f1a98d1ffd","reviewed_head_sha":"868a2fc71b31c0ac53b47353c26ad14381cfac13","reviewer":"codex","start_line":132,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_fa3zqv4unuwe4fxihjhr7qftpf","record_type":"finding_observed","recorded_at":"2026-09-15T22:05:05Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
