{"data":{"body":"**[P2] Preserve brackets around IPv6 hosts**\n\n`urlsplit().hostname` removes IPv6 brackets. With no explicit port, passing `::1` to `HTTPConnection` makes the standard library parse the final `:1` as a port; longer literals are similarly corrupted or rejected. Re-bracket IPv6 literals before constructing both connection types and add HTTP/HTTPS tests using default ports.","comment_node_id":"PRRC_kwDOPsIIsM7vqrev","finding_digest":"69fdf803b6f67148f46ad121b257ca099edeba06c24f242c9571409dcf320c7a","finding_id":"arf_v1_nh67qa5w6zyur5dk2eq3ev6kbg","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::ipv6-authority-preservation","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::http_send::ipv6-authority-preservation","line":165,"observation_digest":"e4834ccc2135e7e24f8ed578fb38ac15187fcbfdb5872cb2f05c1be8e969c86f","observation_id":"aro_v1_4sbuztbbgxt6et4o2v4pwofmcu","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-15T22:59:05Z","review_id":"arr_v1_y4ciaxbdlrpkq2gi7z7ncoxmd3","reviewed_base_sha":"15fa221c0f6010d040f6f1418ff70e3e2e2e298f","reviewed_head_sha":"37e5029b35d0568b5fc10a55ff1862baea2d4de8","reviewer":"codex","start_line":164,"suggestion_id":""},"pull_request":{"number":729},"record_id":"art_v1_jjuhf6oksateodwc6qgchovser","record_type":"finding_observed","recorded_at":"2026-09-15T22:59:05Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
