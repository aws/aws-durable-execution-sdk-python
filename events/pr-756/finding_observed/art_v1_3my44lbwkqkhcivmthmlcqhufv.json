{"data":{"body":"**P3 \u2014 Add unit coverage for the branch context handoff.** The new `copy_context()` path is covered only by tests under `tests/e2e`; the modified map/parallel unit tests always use an empty plugin executor and therefore exercise only the `else` branch. Add a focused executor unit test using a non-empty plugin list and a reused single worker, asserting that each branch inherits the coordinator binding and cannot leak changes into the next branch.","comment_node_id":"PRRC_kwDOPsIIsM773gse","finding_digest":"a6fb290908cdeb5ef7aace906552a8cf4c2c9ac1cce50184b8167880c19fc73f","finding_id":"arf_v1_u35ssciizxvv555kz2igkuviz5","finding_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/concurrency/executor.py::concurrentexecutor.execute::branch-context-unit-coverage","identity_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/concurrency/executor.py::concurrentexecutor.execute::branch-context-unit-coverage","line":295,"observation_digest":"3f688844fd17927535a3b36ce2dc19e047df37c1a5d4a8c8399031c6649cc966","observation_id":"aro_v1_h5uiqrh5c6jhknndwnwofxaz4b","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/concurrency/executor.py","prior_finding_id":"","published_at":"2026-10-09T00:57:13Z","review_id":"arr_v1_efmdaiv5oob5cfdaxu263cvlqt","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"29847f372255c5ac4ed0f43d3b67dcbd59b37173","reviewer":"codex","start_line":295,"suggestion_id":""},"pull_request":{"number":756},"record_id":"art_v1_3my44lbwkqkhcivmthmlcqhufv","record_type":"finding_observed","recorded_at":"2026-10-09T00:57:13Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
