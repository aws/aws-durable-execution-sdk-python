{"data":{"body":"**P2 \u2014 Require explicit opt-in before invoking this hook.** Existing plugins or OTel subclasses may already expose a callable `handler_context` helper with unrelated semantics. This lookup now invokes it on every execution, potentially wrapping handlers unexpectedly, causing side effects, or disabling the inherited OTel fallback. Gate dispatch through an explicit versioned marker on the class that defines the hook, and add a regression test proving coincidental legacy callables remain inert.","comment_node_id":"PRRC_kwDOPsIIsM77y9Wa","finding_digest":"decd4edd530ea82da215852ebf828ae84902f6f636a5bd5401159a38d9c38045","finding_id":"arf_v1_33gu5xktb2uc3iqvquxl7auk5b","finding_key":"packages/aws-durable-execution-sdk-python/plugin.py::_safe_handler_context::unopted-hook-name-collision","identity_key":"packages/aws-durable-execution-sdk-python/plugin.py::_safe_handler_context::unopted-hook-name-collision","line":570,"observation_digest":"ed4786f1f7de6aa5961b88bf886ed02d48bc315c5efa8cde1d925f71ea6b6bf5","observation_id":"aro_v1_5vdyn4px3zvklfq3rc7yq3wqfv","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/plugin.py","prior_finding_id":"","published_at":"2026-10-08T21:43:25Z","review_id":"arr_v1_ljqlirgp34ymd2gmits6pkdfaa","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"d8de5f37b185e1d1fdbdb4634fceca82d6556fb6","reviewer":"codex","start_line":568,"suggestion_id":""},"pull_request":{"number":756},"record_id":"art_v1_ps4qdthccoe7op3t5org2gh7td","record_type":"finding_observed","recorded_at":"2026-10-08T21:43:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
