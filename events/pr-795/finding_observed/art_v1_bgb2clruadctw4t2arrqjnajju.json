{"data":{"body":"[P3] Reconsider the optional proof-file exporter\n\nThe `SERVICE_PRUNING_PROOF_DIR` option introduces filesystem behavior that the PR description does not list or justify, contrary to rule 7. It also violates rule 4: no test sets this variable or asserts the exported files, so deleting this entire branch changes no regression assertion. Please return to the design phase under rule 8 and keep the parity regression focused on assertions unless an evidence-export requirement is explicitly agreed.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABBeN7QA","finding_digest":"afbc854dec1c6f852a36817672bd7ad540ab8c1cd203cdd9bda71db28492ddbe","finding_id":"arf_v1_v66iktpmdrxykkrwqf3hfpl22v","finding_key":"testing/replay_children_service_parity_int_test.py::test_public_resume_uses_service_state_but_inspection_remains_complete::unreviewed-proof-export-option","identity_key":"testing/replay_children_service_parity_int_test.py::test_public_resume_uses_service_state_but_inspection_remains_complete::unreviewed-proof-export-option","line":135,"observation_digest":"a2aacd99b6ecf3bf0c8fe4bf94d7a8ee1da83e82ede32c84f06b525c852c508a","observation_id":"aro_v1_ukvm3gnw5tz36dep4s7zjv5i5y","path":"packages/aws-durable-execution-sdk-python-testing/tests/e2e/replay_children_service_parity_int_test.py","prior_finding_id":"","published_at":"2026-10-27T20:27:14Z","review_id":"arr_v1_c52dqfew2ymwqzhba2yqiubks7","reviewed_base_sha":"d7ae95571c44b18c2a2efdef9a308b1c916c5049","reviewed_head_sha":"f8ac9b4aee71b4f31a9ea94ea105225a31ea552d","reviewer":"codex","start_line":132,"suggestion_id":""},"pull_request":{"number":795},"record_id":"art_v1_bgb2clruadctw4t2arrqjnajju","record_type":"finding_observed","recorded_at":"2026-10-27T20:27:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
