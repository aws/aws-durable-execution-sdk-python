{"data":{"body":"[P3] Simplify the unused marker-validation mode\n\nThis breaks rules 2, \u201cSimplify before you add,\u201d and 4, \u201cEvery branch has a test that fails without it.\u201d The only caller, `page()`, now always supplies the retained operation count, and no test calls `_resolve_marker()` without it. The new `None` fallback therefore adds an unexercised raw-snapshot validation mode that no supported path needs. Please return to the design phase under rule 8; a single retained-operation count is the simpler direction.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABBeN51g","finding_digest":"adc65d2ac203827baa096bc4b608a12077380d474b1dca63adce8e6bc00ef942","finding_id":"arf_v1_vxdf2kwcaobhxkqjnpclmcfbeb","finding_key":"testing/execution.py::operationpaginatorstate._resolve_marker::unused-count-fallback","identity_key":"testing/execution.py::operationpaginatorstate._resolve_marker::unused-count-fallback","line":982,"observation_digest":"92d1416a55a78439457734c31ca13f9f5ee64e9c155d1bc433618e846e78d3cb","observation_id":"aro_v1_sliuc2svu6cdsrlxgtbrzij7t5","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py","prior_finding_id":"","published_at":"2026-10-27T20:27:12Z","review_id":"arr_v1_c52dqfew2ymwqzhba2yqiubks7","reviewed_base_sha":"d7ae95571c44b18c2a2efdef9a308b1c916c5049","reviewed_head_sha":"f8ac9b4aee71b4f31a9ea94ea105225a31ea552d","reviewer":"codex","start_line":978,"suggestion_id":""},"pull_request":{"number":795},"record_id":"art_v1_qbn3r44dzrrcvxyzsv5tc4lntt","record_type":"finding_observed","recorded_at":"2026-10-27T20:27:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
