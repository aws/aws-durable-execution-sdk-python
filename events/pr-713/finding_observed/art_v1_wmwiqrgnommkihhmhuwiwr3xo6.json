{"data":{"body":"**[P2] Exercise this burst through the real durable runner.** This test invokes plugin hooks directly with a fast exporter, so it does not cover the parallel/map \u2192 PluginExecutor \u2192 scheduler path this change targets and can pass when the worker drains between calls. The repository rules require e2e coverage for cross-component workflow behavior. Add a `tests/e2e/` local-runner case using `emit_mode=\"on-change\"` that produces the fan-in burst and asserts every expected RUNNING snapshot followed by the terminal snapshot.","comment_node_id":"PRRC_kwDOPsIIsM7s4ZMv","finding_digest":"4b662772b698a30c07f277adca0734eb5d3fe0a875f145f1d3f16acbb2d5785b","finding_id":"arf_v1_jntco4vwtcrqyb7so6w4ubzu5n","finding_key":"packages/aws-durable-execution-sdk-python-insight/tests/test_plugin_async.py::test_tight_on_change_burst_preserves_all_records::missing-local-runner-e2e","identity_key":"packages/aws-durable-execution-sdk-python-insight/tests/test_plugin_async.py::test_tight_on_change_burst_preserves_all_records::missing-local-runner-e2e","line":223,"observation_digest":"d17ea06232d60ec2ca77b35f023abdb6be63f71d52e7ef3c9b8c1beac21eb539","observation_id":"aro_v1_2f7kayrs2yhmfstxwnpqeov5w2","path":"packages/aws-durable-execution-sdk-python-insight/tests/test_plugin_async.py","prior_finding_id":"","published_at":"2026-09-10T00:16:09Z","review_id":"arr_v1_fanq4sff2pym3ufgnamz4dkrsy","reviewed_base_sha":"399a606df1f7d1f6a9222a5459616e370bf31f56","reviewed_head_sha":"ed394bf37b1dc2d06824c329833ba7ac9e056efa","reviewer":"codex","start_line":223,"suggestion_id":""},"pull_request":{"number":713},"record_id":"art_v1_wmwiqrgnommkihhmhuwiwr3xo6","record_type":"finding_observed","recorded_at":"2026-09-10T00:16:09Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
