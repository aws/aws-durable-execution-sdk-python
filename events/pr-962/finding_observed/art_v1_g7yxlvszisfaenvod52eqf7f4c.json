{"data":{"body":"[P2] Include the new test module in the CI invocation\n\nThis path filter starts `test-scripts`, but its `Run script tests` step explicitly enumerates test modules and omits `test_closed_issue_comment_workflow.py`. Root pytest discovery also excludes `.github/scripts/tests`, so the main CI job does not collect it either. Consequently, none of the five new checks runs in CI, allowing workflow regressions to pass unnoticed. Add the new module to the script-test invocation.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABE0_wFQ","finding_digest":"a86e8b1630c740f7221fcea82555743ff95b2a98dd26e97d99a66d084f20b4d7","finding_id":"arf_v1_vbxiwfrqy5apoiq7z2uckvluh7","finding_key":"github/workflows/test-parser.yml::test-scripts::closed-issue-comment-tests-not-collected","identity_key":"github/workflows/test-parser.yml::test-scripts::closed-issue-comment-tests-not-collected","line":14,"observation_digest":"f1753cdbecac439a7fa1ac61bfff076f77ee555039ac3059534ae4e2019f01e8","observation_id":"aro_v1_6f2tzw7mvrbzu75bvrq377yhn5","path":".github/workflows/test-parser.yml","prior_finding_id":"","published_at":"2026-11-18T18:35:32Z","review_id":"arr_v1_amaobkkyn3rtl2qho3yjyliep7","reviewed_base_sha":"2884bb0057a2655d7207366f1d1bc4a519bc5d29","reviewed_head_sha":"4f083b2a575e449da9d4a41d0c295f0f1e697a59","reviewer":"codex","start_line":14,"suggestion_id":""},"pull_request":{"number":962},"record_id":"art_v1_g7yxlvszisfaenvod52eqf7f4c","record_type":"finding_observed","recorded_at":"2026-11-18T18:35:32Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
