{"data":{"body":"**[P2] Queue the invocation-end drain before running transforms.** This request is reached only after `_emit()`, but content and result transforms can raise `asyncio.CancelledError` because their helpers catch only `Exception`. Core then contains the hook failure, leaving previously scheduled records unflushed in buffering exporters. Register the drain immediately upon entering `_hook_frame()` or in a `finally`, and test an end transform that raises cancellation after an `ON_CHANGE` record was scheduled.","comment_node_id":"PRRC_kwDOPsIIsM7xe5l7","finding_digest":"1de2d9f6c1964f50abc09c85fe00a2ed7fc68a666918fdb8f56264e18a4ed3dc","finding_id":"arf_v1_dxrnt5wbszhvbk6atsc74afc5v","finding_key":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py::workflowinsightplugin.on_invocation_end::drain-skipped-on-baseexception","identity_key":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py::workflowinsightplugin.on_invocation_end::drain-skipped-on-baseexception","line":455,"observation_digest":"d1e8cff3993e7c4be9272b67ef29a9a0ec53b9a9969df567c25b0dd78baeebd9","observation_id":"aro_v1_2hum744zhz6ex2jhfnt66knjud","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-18T23:28:26Z","review_id":"arr_v1_b36gtcrmmlelm5sz4766aafg6j","reviewed_base_sha":"2313fcbf2ac08a1e46c078ab2ba8f0fa44c1ef0a","reviewed_head_sha":"84159aa222a10087bba29cb0f627875921d057de","reviewer":"codex","start_line":455,"suggestion_id":""},"pull_request":{"number":737},"record_id":"art_v1_jvbc5fgqz6xdn5cmunnhr3zm42","record_type":"finding_observed","recorded_at":"2026-09-18T23:28:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
