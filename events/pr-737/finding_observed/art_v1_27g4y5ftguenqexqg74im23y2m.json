{"data":{"body":"**[P1] Avoid a process-global current-plugin pointer**\n\nAll root handlers share this filter, so overlapping invocations continually overwrite `_plugin`. After B binds, logs from still-running A query B's registry and can receive B's invocation span IDs or lose correlation. Resolve the plugin/span through invocation-local context, or attach the invocation span to the emitting context, and make installation concurrency-safe. Add a test where two invocations emit logs after both have started.","comment_node_id":"PRRC_kwDOPsIIsM7wrIpg","finding_digest":"d6d5b31e2ed09329bfefb9f3864bffc7ce896028f27233f951f992543603a3fe","finding_id":"arf_v1_23k3ghro2cjstp7pxhzyms77y7","finding_key":"aws_durable_execution_sdk_python_otel/log_filter.py::otelcontextlogfilter.bind::concurrent-invocation-isolation","identity_key":"aws_durable_execution_sdk_python_otel/log_filter.py::otelcontextlogfilter.bind::concurrent-invocation-isolation","line":76,"observation_digest":"995607afff5d78bf5d70fb7af7ea68ba0c0894d416786be4ead089cb2e80184e","observation_id":"aro_v1_tflapl77lv4l6xlq7n5pp2tixi","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/log_filter.py","prior_finding_id":"","published_at":"2026-09-17T14:14:39Z","review_id":"arr_v1_v64wskqwhvja4fxok4kfcn4px4","reviewed_base_sha":"fb8af739a92f7fd8070d928029150fe4e5c9cc61","reviewed_head_sha":"f011990caae96c43d4fc17c99ae4410b0db07a3c","reviewer":"codex","start_line":76,"suggestion_id":""},"pull_request":{"number":737},"record_id":"art_v1_27g4y5ftguenqexqg74im23y2m","record_type":"finding_observed","recorded_at":"2026-09-17T14:14:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
