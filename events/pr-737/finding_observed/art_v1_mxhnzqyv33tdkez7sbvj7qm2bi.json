{"data":{"body":"**[P2] Preserve the handler\u2019s public two-argument signature**\n\n`PluginHost.handle_durable_output` applies `functools.wraps` to this new three-argument internal function, so `inspect.signature()` on the returned Lambda handler advertises a required `plugin_executor` argument even though the callable accepts only `event` and `context`. Signature-aware runtimes and test harnesses can reject or misinvoke it. Preserve the user function\u2019s metadata before applying the host wrapper.","comment_node_id":"PRRC_kwDOPsIIsM7w5vT6","finding_digest":"75113d9d409cd712b195632c04984a0c685c210cd54c4a73efcb6a4b3d519673","finding_id":"arf_v1_ouit3hkattlrfmmvmmwajgckbr","finding_key":"core/execution.py::durable_execution.wrapper::two-argument-handler-signature","identity_key":"core/execution.py::durable_execution.wrapper::two-argument-handler-signature","line":202,"observation_digest":"d7a75a9be15cec2ca6a0ec5838e0f550a42aa1ac88d8b35b21fdbf56be1bec42","observation_id":"aro_v1_26tvvg7bltwczjva5rmdryhvkc","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py","prior_finding_id":"","published_at":"2026-09-17T21:39:40Z","review_id":"arr_v1_u2sfqjex4lghovpbpp76rtcocr","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"a67d1a86a494933d5bcd8020481c2c7f2413b766","reviewer":"codex","start_line":201,"suggestion_id":"arsg_v1_edewmsqkr2vprsjjlthldd4p73"},"pull_request":{"number":737},"record_id":"art_v1_mxhnzqyv33tdkez7sbvj7qm2bi","record_type":"finding_observed","recorded_at":"2026-09-17T21:39:40Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
