{"data":{"body":"**[P2] Validate the object returned by each factory**\n\nThe load-time shape check cannot inspect a factory's return, but this path accepts every non-`None` object. A factory returning `object()` is registered and then fails every hook inside `_dispatch_plugin`, so that plugin silently provides no telemetry while producing repeated errors. Check that the result is a `DurableInstrumentationPlugin`, log and skip invalid results, and add a test alongside the `None` case.","comment_node_id":"PRRC_kwDOPsIIsM7xWkE8","finding_digest":"0ad34eb30aebaf7a6e5603141ea2eb5e42c6d342a2fe68b9d180b612b7fbc846","finding_id":"arf_v1_blju5myk5oxxu3swamkb5ixllz","finding_key":"core/plugin.py::pluginexecutor._create_plugins::invalid-plugin-return","identity_key":"core/plugin.py::pluginexecutor._create_plugins::invalid-plugin-return","line":630,"observation_digest":"a391d158c59c5ade8f3897b013d04c1076a7d6695ffb49ab3a96627ed1049be2","observation_id":"aro_v1_uoi5cwgftrnn5dzys6ybhucmcb","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/plugin.py","prior_finding_id":"","published_at":"2026-09-18T17:43:47Z","review_id":"arr_v1_6fhf2wx7p6nkoh4vhu54b3irhz","reviewed_base_sha":"d3230f34a0dbba856b39787b6b568de03de89123","reviewed_head_sha":"717ef06d47ee2badd14806bf7126bc08d4fc7848","reviewer":"codex","start_line":630,"suggestion_id":""},"pull_request":{"number":737},"record_id":"art_v1_buiofuz3tvoc737n26k6wryx3q","record_type":"finding_observed","recorded_at":"2026-09-18T17:43:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
