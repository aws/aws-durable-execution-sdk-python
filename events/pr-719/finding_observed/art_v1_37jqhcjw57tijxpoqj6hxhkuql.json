{"data":{"body":"**[P2] Avoid draining an idle scheduler.** This runs even when the invocation emitted nothing, such as an `on-failure` success or an `on-complete` `PENDING`/`RETRY`. It therefore starts a worker, calls every exporter\u2019s `flush()`, and can block for the full default five seconds despite having no record to deliver. Track outstanding/unflushed work and return immediately when idle, while still draining work left by an earlier timeout.","comment_node_id":"PRRC_kwDOPsIIsM7tgnzi","finding_digest":"2ecd1c450b3393934a905c271dcd92f91f55f79ebfa149174292d6ed5e2b3584","finding_id":"arf_v1_f3gryrilgojzgsuqlqtr3tms7e","finding_key":"insight/plugin.py::workflowinsightplugin.on_invocation_end::idle-flush-avoidance","identity_key":"insight/plugin.py::workflowinsightplugin.on_invocation_end::idle-flush-avoidance","line":327,"observation_digest":"b363de2ea6d1899090f167d772380d57a8fdc98c7a8e935ff0bb5933465c6008","observation_id":"aro_v1_wnr54lvg2gezbehrm7lxeoank6","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-11T00:23:03Z","review_id":"arr_v1_kqfoskol3o5mz5p4dys5sg477a","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"cd7eabba429611aab0ad23f224597056ec063545","reviewer":"codex","start_line":327,"suggestion_id":""},"pull_request":{"number":719},"record_id":"art_v1_37jqhcjw57tijxpoqj6hxhkuql","record_type":"finding_observed","recorded_at":"2026-09-11T00:23:03Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
