{"data":{"body":"[P2] Preserve JSON `null` instead of treating it as absence. A handler returning `None` produces `\"null\"`, which parses to `None` and is skipped here; null input and opted-in null operation results are similarly lost. Use a private omission sentinel, insert fields unless that sentinel is returned, and update the operation-index/truncation presence checks. Add null input, output, transform, and result tests.","comment_node_id":"PRRC_kwDOPsIIsM7o85dT","finding_digest":"f45213d2e659aa323b6e40553a24091e49dc437ec3aabf28a3c54295f8b81e64","finding_id":"arf_v1_6rjbhuxglgvdeo3oibktujajdz","finding_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin._emit::null-content-preservation","identity_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin._emit::null-content-preservation","line":425,"observation_digest":"6b306ca02e9251f6acaab26c29c20e7821a607faad1688729405bf3b546ead2c","observation_id":"aro_v1_nmygzibosji7nlfkwjwctqqopa","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-01T20:45:00Z","review_id":"arr_v1_iagmdikyzsx3yia7cftiq6uv3u","reviewed_base_sha":"9052f3510f9c7cc83c8eeb8e260226b38c5e0245","reviewed_head_sha":"455a5bc0e6517bc3ca1f7aaacbe8e36a2fd6feb5","reviewer":"codex","start_line":422,"suggestion_id":""},"pull_request":{"number":632},"record_id":"art_v1_34ib3wjgv7n4psqfrmpaaglpnn","record_type":"finding_observed","recorded_at":"2026-09-01T20:45:00Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
