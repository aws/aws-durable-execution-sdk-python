{"data":{"body":"[P2] Preserve terminal payloads before the core SDK elides them from the Lambda response. `InvocationEndInfo.execution_result` is `\"\"` when a large result was checkpointed out-of-band, so this plugin omits the output and never invokes its configured transform. Large checkpointed failures can similarly lack `info.error`. Extend the hook data with the original serialized result/error and test both large success and failure paths.","comment_node_id":"PRRC_kwDOPsIIsM7o85gm","finding_digest":"0c9fdbad4b80176a9f682e01a69fe871097299f2eae25edd8f8c888a1b683f34","finding_id":"arf_v1_bsp5xlklqalwvh3ifya2nh7ioe","finding_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin.on_invocation_end::checkpointed-terminal-payload-loss","identity_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin.on_invocation_end::checkpointed-terminal-payload-loss","line":315,"observation_digest":"5e5918bb90effd7a2c89ce1c9a3b422d8df5d19a19a9d73578168284d0c18e6f","observation_id":"aro_v1_lzmrro4q576xulejzyojuo2cfw","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-01T20:45:01Z","review_id":"arr_v1_iagmdikyzsx3yia7cftiq6uv3u","reviewed_base_sha":"9052f3510f9c7cc83c8eeb8e260226b38c5e0245","reviewed_head_sha":"455a5bc0e6517bc3ca1f7aaacbe8e36a2fd6feb5","reviewer":"codex","start_line":314,"suggestion_id":""},"pull_request":{"number":632},"record_id":"art_v1_rrdlcipqegykzl3rfspciitckl","record_type":"finding_observed","recorded_at":"2026-09-01T20:45:01Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
