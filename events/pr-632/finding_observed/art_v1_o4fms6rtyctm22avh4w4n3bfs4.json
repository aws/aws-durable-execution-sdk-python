{"data":{"body":"[P2] Normalize non-finite floats before serialization. Python emits `NaN` and `Infinity` tokens by default, which are invalid JSON and differ from JavaScript's `JSON.stringify` behavior of emitting `null`. Durable results and transforms can contain these values, producing incompatible S3/log records. Use one shared JS-compatible normalizer for both export serialization and byte-size measurement, with tests for NaN and both infinities.","comment_node_id":"PRRC_kwDOPsIIsM7o85of","finding_digest":"cafcb91e356125fce3999e1e324fe0e6f656962847f1b20242c9e699f0337c1b","finding_id":"arf_v1_zl6lshrvmes7zy4ztypdet7a43","finding_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::compact_dumps::nonfinite-json-compatibility","identity_key":"packages/aws-durable-execution-sdk-python-insight/exporters/_common.py::compact_dumps::nonfinite-json-compatibility","line":24,"observation_digest":"3d9d8f013d660138e0f95e984a294517490d50d65e3ee0e2e1b11f017cae8bde","observation_id":"aro_v1_hwoy6aj5myatryhzl2meukkfc5","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-01T20:45:05Z","review_id":"arr_v1_iagmdikyzsx3yia7cftiq6uv3u","reviewed_base_sha":"9052f3510f9c7cc83c8eeb8e260226b38c5e0245","reviewed_head_sha":"455a5bc0e6517bc3ca1f7aaacbe8e36a2fd6feb5","reviewer":"codex","start_line":24,"suggestion_id":""},"pull_request":{"number":632},"record_id":"art_v1_o4fms6rtyctm22avh4w4n3bfs4","record_type":"finding_observed","recorded_at":"2026-09-01T20:45:05Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
