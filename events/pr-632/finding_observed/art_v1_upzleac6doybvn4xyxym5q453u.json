{"data":{"body":"[P1] Move exporter I/O off the synchronous hook path. This runs from operation-change hooks before checkpoint waiters are released and from invocation-end hooks before Lambda returns. A slow or hung S3/custom exporter can therefore stall workflow progress until timeout; catching exceptions only helps after the call returns. Queue exports to a bounded worker and use a deadline-bounded invocation-end drain, dropping telemetry if necessary.","comment_node_id":"PRRC_kwDOPsIIsM7o85Zc","finding_digest":"a363edbe079304b2a7775dc2e92d3f3c981ad5a48a5fb5b76d83365ed7bed06f","finding_id":"arf_v1_unr63pqhsmclfj3xlxboslj7hs","finding_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin._emit::blocking-export-on-hook-thread","identity_key":"packages/aws-durable-execution-sdk-python-insight/plugin.py::workflowinsightplugin._emit::blocking-export-on-hook-thread","line":435,"observation_digest":"3efdff2463dd7c587f6b4f8b4c4e4601f7a5cf59ddbff74c7ffa0042899eba99","observation_id":"aro_v1_h3676jdd3v6fq73lj6fuytsgah","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-01T20:44:58Z","review_id":"arr_v1_iagmdikyzsx3yia7cftiq6uv3u","reviewed_base_sha":"9052f3510f9c7cc83c8eeb8e260226b38c5e0245","reviewed_head_sha":"455a5bc0e6517bc3ca1f7aaacbe8e36a2fd6feb5","reviewer":"codex","start_line":435,"suggestion_id":""},"pull_request":{"number":632},"record_id":"art_v1_upzleac6doybvn4xyxym5q453u","record_type":"finding_observed","recorded_at":"2026-09-01T20:44:58Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
