{"data":{"body":"**[P2] Apply accepted response state before suspending**\n\nThis branch runs before `NewExecutionState` is merged or plugin updates are emitted. The batch was accepted, so inline terminal operation states are omitted from invocation-end state; replay skips terminal replay/end hooks, potentially leaving OTel operation spans permanently absent. Merge the inline operations without pagination and emit their updates before suspending waiters. Add plugin coverage for this path.","comment_node_id":"PRRC_kwDOPsIIsM778rwX","finding_digest":"b7fabdadf04687c0488b83b27e3dca17136da9e1401c4ac8cb1f1d8e97ed00e0","finding_id":"arf_v1_w75l3lpqi2d4aselqozh4pokc4","finding_key":"core/state.py::checkpoint_batches_forever::revoked-response-state-not-applied","identity_key":"core/state.py::checkpoint_batches_forever::revoked-response-state-not-applied","line":1070,"observation_digest":"1c2a9caf37a2fbfd67cc455696f10edcd9385c4719669568b8478b1b839c3ad6","observation_id":"aro_v1_dqvjzlzxul572z6mivljn4io3t","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/state.py","prior_finding_id":"arf_v1_w75l3lpqi2d4aselqozh4pokc4","published_at":"2026-10-09T05:40:36Z","review_id":"arr_v1_j3pcpkjey44k7lg2ycvonga3wu","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"f2f73f65eaff19371e4885240e77800825ba4c4c","reviewer":"codex","start_line":1070,"suggestion_id":""},"pull_request":{"number":757},"record_id":"art_v1_scgyuetjpkbxprv5jv4oo2xc26","record_type":"finding_observed","recorded_at":"2026-10-09T05:40:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
