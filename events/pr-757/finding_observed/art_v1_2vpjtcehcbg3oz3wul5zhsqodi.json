{"data":{"body":"**[P2] Apply accepted response state before suspending**\n\nThis branch runs before `NewExecutionState` is merged or plugin updates are emitted. The batch was accepted, so inline terminal operation states are omitted from invocation-end state; replay skips terminal replay/end hooks, potentially leaving OTel operation spans permanently absent. Merge the inline operations without pagination and emit their updates before suspending waiters. Add plugin coverage for this path.","comment_node_id":"PRRC_kwDOPsIIsM7779iM","finding_digest":"b7fabdadf04687c0488b83b27e3dca17136da9e1401c4ac8cb1f1d8e97ed00e0","finding_id":"arf_v1_w75l3lpqi2d4aselqozh4pokc4","finding_key":"core/state.py::checkpoint_batches_forever::revoked-response-state-not-applied","identity_key":"core/state.py::checkpoint_batches_forever::revoked-response-state-not-applied","line":1070,"observation_digest":"d6e152e39ca1c5b100d71826e928893fd2bc2110a37f72dfa4ec43865184bdf2","observation_id":"aro_v1_23qvfy44uhc3cagxdatoskejh7","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/state.py","prior_finding_id":"arf_v1_w75l3lpqi2d4aselqozh4pokc4","published_at":"2026-10-09T05:06:31Z","review_id":"arr_v1_obxx2rcov3s6qfuks6u2gi5r3m","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"4eeabba62096dc54d0b65f50f8373b3f810da19d","reviewer":"codex","start_line":1070,"suggestion_id":""},"pull_request":{"number":757},"record_id":"art_v1_2vpjtcehcbg3oz3wul5zhsqodi","record_type":"finding_observed","recorded_at":"2026-10-09T05:06:31Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
