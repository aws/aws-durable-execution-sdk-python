{"data":{"body":"**[P1] Defer retryable errors until after checkpoint cleanup**\n\nThis still raises from inside the `with` block. If a tokenless asynchronous checkpoint completes while the context managers unwind, revocation is recorded after the preceding check, so the post-cleanup override never runs and Lambda retries with a revoked token. Store the exception, finish cleanup, return bare `PENDING` if revocation was observed, and otherwise re-raise. Add a race test with a retryable `InvocationError`.","comment_node_id":"PRRC_kwDOPsIIsM778rtN","finding_digest":"352c424d31867d0c303c8609577202e1fda61787967b6b43b495c43bf7a94ab3","finding_id":"arf_v1_guweetjrqz6qymb4qyevo4qc4h","finding_key":"core/execution.py::wrapper::cleanup-time-revocation-on-retryable-error","identity_key":"core/execution.py::wrapper::cleanup-time-revocation-on-retryable-error","line":456,"observation_digest":"1b5b3a74f6ad2dc0334d176e2a2f96a41c77c827c52017d44a59a3a5f52a9a04","observation_id":"aro_v1_dnntu5hwvuw4am2nc5xcul4wuq","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py","prior_finding_id":"arf_v1_guweetjrqz6qymb4qyevo4qc4h","published_at":"2026-10-09T05:40:34Z","review_id":"arr_v1_j3pcpkjey44k7lg2ycvonga3wu","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"f2f73f65eaff19371e4885240e77800825ba4c4c","reviewer":"codex","start_line":456,"suggestion_id":""},"pull_request":{"number":757},"record_id":"art_v1_hsgsj6b5mxhhnrqifagwbv6of4","record_type":"finding_observed","recorded_at":"2026-10-09T05:40:34Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
