{"data":{"body":"**[P1] Defer retryable errors until after checkpoint cleanup**\n\nThis still raises from inside the `with` block. If a tokenless asynchronous checkpoint completes while the context managers unwind, revocation is recorded after the preceding check, so the post-cleanup override never runs and Lambda retries with a revoked token. Store the exception, finish cleanup, return bare `PENDING` if revocation was observed, and otherwise re-raise. Add a race test with a retryable `InvocationError`.","comment_node_id":"PRRC_kwDOPsIIsM7779f3","finding_digest":"352c424d31867d0c303c8609577202e1fda61787967b6b43b495c43bf7a94ab3","finding_id":"arf_v1_guweetjrqz6qymb4qyevo4qc4h","finding_key":"core/execution.py::wrapper::cleanup-time-revocation-on-retryable-error","identity_key":"core/execution.py::wrapper::cleanup-time-revocation-on-retryable-error","line":456,"observation_digest":"0a913a4726b27fa77b81c7e73786e20301966715abbd42ad7edb20735d45f598","observation_id":"aro_v1_bkiturzgwj72o64by7ttpbxcam","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py","prior_finding_id":"arf_v1_guweetjrqz6qymb4qyevo4qc4h","published_at":"2026-10-09T05:06:29Z","review_id":"arr_v1_obxx2rcov3s6qfuks6u2gi5r3m","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"4eeabba62096dc54d0b65f50f8373b3f810da19d","reviewer":"codex","start_line":456,"suggestion_id":""},"pull_request":{"number":757},"record_id":"art_v1_64ol6p4e2kminzj3kp5y3es2t6","record_type":"finding_observed","recorded_at":"2026-10-09T05:06:29Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
