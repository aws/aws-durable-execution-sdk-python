{"data":{"body":"**[P2] Cache tokenless responses for idempotent retries**\n\nAn accepted paused checkpoint advances the token sequence but leaves `last_checkpoint` unchanged. If its response is lost, retrying the same `ClientToken` and inbound token is rejected as stale instead of replaying the tokenless response, breaking the existing checkpoint idempotency contract. Persist the record with `outbound_checkpoint_token=None` and update both checkpoint-path tests to expect identical replay while paused and after resume.","comment_node_id":"PRRC_kwDOPsIIsM7779j8","finding_digest":"86015a6600b99d594920541957498cdf6feb6e99245134f12126f5dd2ec47f28","finding_id":"arf_v1_qyavuzqaxgovssjakqmvosmm35","finding_key":"testing/checkpoint::paused-response::idempotent-token-replay","identity_key":"testing/checkpoint::paused-response::idempotent-token-replay","line":166,"observation_digest":"4c9c80cf32f33108cf2ab91db0a29ed9cdce60afb42e0aef479ac283856db60f","observation_id":"aro_v1_jsoibtzs6myqrtzkxeo3biu63h","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/checkpoint/core.py","prior_finding_id":"arf_v1_qyavuzqaxgovssjakqmvosmm35","published_at":"2026-10-09T05:06:32Z","review_id":"arr_v1_obxx2rcov3s6qfuks6u2gi5r3m","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"4eeabba62096dc54d0b65f50f8373b3f810da19d","reviewer":"codex","start_line":156,"suggestion_id":"arsg_v1_qap2xhqmejsdfewpbcygvdshql"},"pull_request":{"number":757},"record_id":"art_v1_vuqwu3vsizkbrsarbb332jhfip","record_type":"finding_observed","recorded_at":"2026-10-09T05:06:32Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
