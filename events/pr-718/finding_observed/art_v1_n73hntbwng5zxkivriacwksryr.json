{"data":{"body":"[P2] `newest` is sampled once before a 150-second poll, after the serialized update job has released its lock. If a newer release advances `latest` during that poll, every retry still requires `latest` to equal this older version and the correctly published release fails spuriously. Keep verification inside the serialized job, or recompute and verify the highest published version on each attempt.","comment_node_id":"PRRC_kwDOPsIIsM7vBLVa","finding_digest":"81c11bff0b72d33a555146565f18722ef0857058f6ad8fa15690d1a4a6acc5cc","finding_id":"arf_v1_qharx7yloljtuvkrizlf6gdsf3","finding_key":"github/workflows/ecr-release.yml::verify-publish::newest-snapshot-races-later-release","identity_key":"github/workflows/ecr-release.yml::verify-publish::newest-snapshot-races-later-release","line":367,"observation_digest":"1bcf970f2f9d9a98542ded862cdf39a05b853da45199c0bf89bf1371d09ffafb","observation_id":"aro_v1_dphzodzptwnjqvbn5wdczxzzub","path":".github/workflows/ecr-release.yml","prior_finding_id":"","published_at":"2026-09-14T22:11:15Z","review_id":"arr_v1_xr2diezg5i7fm4xxzfh6yjyayy","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"5c613bfa1d2a3b11957748b2998c94a7ab4afbdd","reviewer":"codex","start_line":367,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_n73hntbwng5zxkivriacwksryr","record_type":"finding_observed","recorded_at":"2026-09-14T22:11:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
