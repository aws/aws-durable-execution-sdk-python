{"data":{"body":"[P1] Serializing jobs does not make this ECR read fresh. After `v3` updates `latest`, an older `v2` job can receive a stale `v1` digest or absence, conclude it is newer, and overwrite `latest`; its verification then accepts the downgrade. Use a strongly consistent compare-and-swap high-water mark or a reconciler that publishes the maximum immutable version while refusing downgrades.","comment_node_id":"PRRC_kwDOPsIIsM7066iB","finding_digest":"74e4f569b4125a540b55ee46f0d90465df0c11880299ea927499408118c8257f","finding_id":"arf_v1_otspk2nucjnfic2v5zdpbwiemx","finding_key":"github/workflows/ecr-release.yml::advance-latest::registry-visibility-before-selection","identity_key":"github/workflows/ecr-release.yml::advance-latest::registry-visibility-before-selection","line":326,"observation_digest":"02db5ba7bf6b73c0f2b464cd33d7a74317cda4c9ac02f4e7672c0f78d4224a85","observation_id":"aro_v1_alnvxj57nnz4b4vumtgthv5him","path":".github/workflows/ecr-release.yml","prior_finding_id":"arf_v1_otspk2nucjnfic2v5zdpbwiemx","published_at":"2026-09-25T22:18:56Z","review_id":"arr_v1_lhxq6tg5ikcm5vtwosktspxu7t","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"e1cd63f8d7e73662772d518993974ba9f66e5f8b","reviewer":"codex","start_line":326,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_shokudt7p27v6j4ul3y4a5wrlm","record_type":"finding_observed","recorded_at":"2026-09-25T22:18:56Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
