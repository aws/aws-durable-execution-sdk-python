{"data":{"body":"[P1] Serialize the `latest` selection and publication. Concurrent release runs can both decide they are newest before either new tag is visible, allowing the older run to push `latest` last; the independent verification query can subsequently miss this race. Add a shared workflow-level concurrency group with cancellation disabled so selection, push, and verification complete atomically relative to other releases.","comment_node_id":"PRRC_kwDOPsIIsM7uD_Sl","finding_digest":"712906d8b61c820df6d222136b7bf9f65e36df612afddca8e324e86732553e36","finding_id":"arf_v1_oeuqnwfwdsba35wseijww67z6z","finding_key":"github/workflows/ecr-release.yml::create-latest-manifest::latest-update-not-serialized","identity_key":"github/workflows/ecr-release.yml::create-latest-manifest::latest-update-not-serialized","line":236,"observation_digest":"c3f8e1c6abfd0ba5ecf2bf48de819e8ed4f2bda61c8bf2fa0bd41f55366d0fb2","observation_id":"aro_v1_yp4odrvl7uf2l3hsx5en5am6r3","path":".github/workflows/ecr-release.yml","prior_finding_id":"","published_at":"2026-09-11T22:55:17Z","review_id":"arr_v1_yjqty7uusgvecu63k2vbo2lwrb","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"8c205dd693c0b84767b0ee10e854c325f4342efa","reviewer":"codex","start_line":236,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_flzedqpffny5djvmflfqqx4skx","record_type":"finding_observed","recorded_at":"2026-09-11T22:55:17Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
