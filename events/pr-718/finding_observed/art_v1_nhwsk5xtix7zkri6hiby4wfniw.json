{"data":{"body":"[P1] GitHub concurrency groups retain only one pending job; another queued updater replaces it even with `cancel-in-progress: false`. If `v3` is running, `v4` is pending, and `v2` arrives, `v4` is canceled and `v2` subsequently no-ops against `v3`, leaving `latest` behind. Use a queue or lock that preserves every updater, or make every survivor reconcile the highest published version.","comment_node_id":"PRRC_kwDOPsIIsM7066jv","finding_digest":"3a1afded902dc8a91b439c3ceab4f53d04b8cde20e1f42579ca76fdcf384826d","finding_id":"arf_v1_hinp33mqfxeksg2dtq6ovnhvhu","finding_key":"github/workflows/ecr-release.yml::workflow-concurrency::pending-release-publication-dropped","identity_key":"github/workflows/ecr-release.yml::workflow-concurrency::pending-release-publication-dropped","line":268,"observation_digest":"77fd8df7dda2e6a9271ab9b11bbff1b5b716c845058ea45b405c546752f184cb","observation_id":"aro_v1_o76y3565ultksjy2xgyrxp7rww","path":".github/workflows/ecr-release.yml","prior_finding_id":"arf_v1_hinp33mqfxeksg2dtq6ovnhvhu","published_at":"2026-09-25T22:18:58Z","review_id":"arr_v1_lhxq6tg5ikcm5vtwosktspxu7t","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"e1cd63f8d7e73662772d518993974ba9f66e5f8b","reviewer":"codex","start_line":268,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_nhwsk5xtix7zkri6hiby4wfniw","record_type":"finding_observed","recorded_at":"2026-09-25T22:18:58Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
