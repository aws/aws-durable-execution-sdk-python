{"data":{"body":"OCI index digests include descriptor order. The version manifest is created x86_64 then arm64, while `latest` is created arm64 then x86_64, so their top-level digests differ despite containing the same images. This marks successful publishes as failed. Create both tags from one identically ordered manifest or compare their child platform digests.","comment_node_id":"PRRC_kwDOPsIIsM7t9o6q","finding_digest":"28da63d887523611ffacc6141f9187d10d89737744292e58ddd6b2cb93fda01a","finding_id":"arf_v1_fdnghwehki3bd75myykb7emh2e","finding_key":"github/workflows/ecr-release.yml::verify-publish::manifest-order-digest-mismatch","identity_key":"github/workflows/ecr-release.yml::verify-publish::manifest-order-digest-mismatch","line":272,"observation_digest":"0590970cec5bd4d127aaf8c29c13d1dd48919efb25b6e72328080d8c56c7b473","observation_id":"aro_v1_awijodhmlpkncj5k7dbjye6r3v","path":".github/workflows/ecr-release.yml","prior_finding_id":"","published_at":"2026-09-11T18:43:35Z","review_id":"arr_v1_tkpgti7lzdxa7sxia5zycahmtb","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"44d8ed03d3ba8954121e4d3c198252aa4e44a4c0","reviewer":"codex","start_line":272,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_gu7dhc7c2kcmjhhfzvvdtknpjs","record_type":"finding_observed","recorded_at":"2026-09-11T18:43:35Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
