{"data":{"body":"[P2] This is only a prefix check, so a valid Packaging value such as `v999.0.0.1` is accepted although releases require three components. If such an alias shares `latest`'s digest, it becomes the apparent high-water version and can block releases or falsely validate an old `latest`. Enforce exactly three release components while allowing intended prerelease suffixes, and add a `v1.2.3.4` regression case.","comment_node_id":"PRRC_kwDOPsIIsM7066mE","finding_digest":"0b7f4d0eb12f93cea69c80013017f755f045981204a2fe6ec8181df5e70a44a5","finding_id":"arf_v1_bn7u2dvrf6j45ju4qaataf7xkx","finding_key":"github/scripts/latest_testing_version.py::latest_version::malformed-tag-shape-filter","identity_key":"github/scripts/latest_testing_version.py::latest_version::malformed-tag-shape-filter","line":13,"observation_digest":"ae22bba1fe4ac2fe12a0a551bf8d1097ae1d72f3e8bc7569c292e8e2d608d69b","observation_id":"aro_v1_vyrlxip6jlbp4evauvi37diqs6","path":".github/scripts/current_latest_version.py","prior_finding_id":"arf_v1_bn7u2dvrf6j45ju4qaataf7xkx","published_at":"2026-09-25T22:19:00Z","review_id":"arr_v1_lhxq6tg5ikcm5vtwosktspxu7t","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"e1cd63f8d7e73662772d518993974ba9f66e5f8b","reviewer":"codex","start_line":13,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_hev4xcgvopp2kmncqho4s7ffyo","record_type":"finding_observed","recorded_at":"2026-09-25T22:19:00Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
