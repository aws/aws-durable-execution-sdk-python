{"data":{"body":"[P2] `Version()` accepts abbreviated PEP 440 values such as `1` and `1.2`, although this workflow only publishes versions with an `X.Y.Z` prefix. A stray registry tag such as `v999` is therefore selected as newest, causing attempts to use nonexistent `v999-x86_64` and `v999-arm64` images and blocking releases. Full-match the supported tag grammar before parsing, and add regression cases for `v1` and `v1.2`.","comment_node_id":"PRRC_kwDOPsIIsM7yXnQC","finding_digest":"0b7f4d0eb12f93cea69c80013017f755f045981204a2fe6ec8181df5e70a44a5","finding_id":"arf_v1_bn7u2dvrf6j45ju4qaataf7xkx","finding_key":"github/scripts/latest_testing_version.py::latest_version::malformed-tag-shape-filter","identity_key":"github/scripts/latest_testing_version.py::latest_version::malformed-tag-shape-filter","line":23,"observation_digest":"841d061c9468bcfcde29ed724074d53d6e9bf16b2161359c7164e57ac5e7660f","observation_id":"aro_v1_qqoqmheunc6pzxrj5vzea5gvhv","path":".github/scripts/latest_testing_version.py","prior_finding_id":"","published_at":"2026-09-21T20:46:28Z","review_id":"arr_v1_stmrfvfczkqstt22emqmbwd4t7","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"0f4faa37a8847743aa2df07bd47bad2bf3d8885a","reviewer":"codex","start_line":20,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_7fq72euyhphv2fsnfz2vnkow7y","record_type":"finding_observed","recorded_at":"2026-09-21T20:46:28Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
