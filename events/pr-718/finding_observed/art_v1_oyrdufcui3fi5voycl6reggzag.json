{"data":{"body":"[P1] Grant repository read access for the new checkout steps. Job-level `permissions` replaces the top-level map, but this job\u2014and `verify-publish`\u2014only grants `id-token: write`. Consequently checkout can fail after the architecture images are uploaded. Add `contents: read` to both jobs' permission maps.","comment_node_id":"PRRC_kwDOPsIIsM7uD_PC","finding_digest":"c83f517036fc32fb554e8efb6184ad8b091e9ae123f8cca0fcfa6384d531dce7","finding_id":"arf_v1_za7vc4bw7qzpwvkor35wdbfnrm","finding_key":"github/workflows/ecr-release.yml::checkout-release-scripts::missing-contents-permission","identity_key":"github/workflows/ecr-release.yml::checkout-release-scripts::missing-contents-permission","line":190,"observation_digest":"55783d0426c82e4816d0f5b100be59a48fb5325675b1b9d741fecd0750def14e","observation_id":"aro_v1_kv4d2bbgzaxeqfwq6wyqbpszus","path":".github/workflows/ecr-release.yml","prior_finding_id":"","published_at":"2026-09-11T22:55:15Z","review_id":"arr_v1_yjqty7uusgvecu63k2vbo2lwrb","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"8c205dd693c0b84767b0ee10e854c325f4342efa","reviewer":"codex","start_line":190,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_oyrdufcui3fi5voycl6reggzag","record_type":"finding_observed","recorded_at":"2026-09-11T22:55:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
