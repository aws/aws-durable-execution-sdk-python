{"data":{"body":"[P1] GitHub concurrency retains only one pending job; a newer arrival replaces the existing pending updater even with `cancel-in-progress: false`. If `v3` is running, `v4` is pending, and `v2` arrives, `v4` is canceled and `v2` subsequently no-ops against `v3`, leaving `latest` behind. Use a queue that preserves every update, or make every surviving job reconcile the highest published immutable version.","comment_node_id":"PRRC_kwDOPsIIsM707o6W","finding_digest":"3a1afded902dc8a91b439c3ceab4f53d04b8cde20e1f42579ca76fdcf384826d","finding_id":"arf_v1_hinp33mqfxeksg2dtq6ovnhvhu","finding_key":"github/workflows/ecr-release.yml::workflow-concurrency::pending-release-publication-dropped","identity_key":"github/workflows/ecr-release.yml::workflow-concurrency::pending-release-publication-dropped","line":269,"observation_digest":"d1915365635e500fc73d7defe87f6a0fc4f27ed6ea398d77f4510148a3551521","observation_id":"aro_v1_2givgzldlzia7rz5pxx6q73kb7","path":".github/workflows/ecr-release.yml","prior_finding_id":"arf_v1_hinp33mqfxeksg2dtq6ovnhvhu","published_at":"2026-09-25T23:03:10Z","review_id":"arr_v1_zxlfkusij2zpcyhnnw6ujxzcoj","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"3f48987c4ff9c0455773c53a1af5c399f1d7d76f","reviewer":"codex","start_line":267,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_idbaibel74iqv4mofd3pxprolr","record_type":"finding_observed","recorded_at":"2026-09-25T23:03:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
