{"data":{"body":"[P1] The earlier preflight check is not a publication lock. Concurrent deliveries for the same testing version can both build through mutable per-architecture tags and reach this push, silently replacing an already-published release or creating a mixed manifest. Use run-scoped architecture tags, then acquire a per-version lock and recheck existence before publishing the immutable version tag.","comment_node_id":"PRRC_kwDOPsIIsM707o3h","finding_digest":"7d526107609cb8c9525a38aa6ef76fac53392b11ded1a51119841bfc80c139d6","finding_id":"arf_v1_pvjgcb3ats4msus2hcvg553pvr","finding_key":"github/workflows/ecr-release.yml::create-version-manifest::existing-version-tag-immutability","identity_key":"github/workflows/ecr-release.yml::create-version-manifest::existing-version-tag-immutability","line":257,"observation_digest":"ca57d1b3b6d9b1d6a1716ae18a9ea9e76ee6f09397f00654f90aeabb74a251c8","observation_id":"aro_v1_zjl5dm5w3gy5nilrnlqyvhvj45","path":".github/workflows/ecr-release.yml","prior_finding_id":"arf_v1_pvjgcb3ats4msus2hcvg553pvr","published_at":"2026-09-25T23:03:07Z","review_id":"arr_v1_zxlfkusij2zpcyhnnw6ujxzcoj","reviewed_base_sha":"9157022256ce2dcff075308b71ed6054bf8b8569","reviewed_head_sha":"3f48987c4ff9c0455773c53a1af5c399f1d7d76f","reviewer":"codex","start_line":257,"suggestion_id":""},"pull_request":{"number":718},"record_id":"art_v1_vm4dykuwm4d2tk5bxh2kpyysdk","record_type":"finding_observed","recorded_at":"2026-09-25T23:03:07Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
