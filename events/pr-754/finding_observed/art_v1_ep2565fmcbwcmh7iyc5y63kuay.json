{"data":{"body":"**P1:** GitHub Actions `concurrency` supports only `group` and `cancel-in-progress`; `queue` makes this workflow invalid before jobs start. The identical additions in both conformance workflows have the same impact. Remove these keys and use a supported external lock/gate if every pending run must be retained; plain YAML parsing does not validate the Actions schema.","comment_node_id":"PRRC_kwDOPsIIsM76fxJy","finding_digest":"e63b99999d40c85865927f825e4da32cb5b328f854b0002c6de0a7bc5e842182","finding_id":"arf_v1_4y5ztgm5idefqzmsp6bf4tndfs","finding_key":"github/workflows::concurrency::unsupported-queue-option","identity_key":"github/workflows::concurrency::unsupported-queue-option","line":49,"observation_digest":"c3fa5d8d195fa5b4f818dcefa54e7e8d500c443c05de47760a1f7e7e43e703d5","observation_id":"aro_v1_yp5f3dizl6s3j6ay3tx2ktt6rv","path":".github/workflows/cloud-tests.yml","prior_finding_id":"","published_at":"2026-10-07T03:00:25Z","review_id":"arr_v1_f3vhmaeq7l3kgg7rlk236t5ody","reviewed_base_sha":"d3b2ddfc73a350593644e628aa91a7ad7aa525e2","reviewed_head_sha":"1a57d1d5ce4db37c955346572b8700b9c0cbe224","reviewer":"codex","start_line":49,"suggestion_id":""},"pull_request":{"number":754},"record_id":"art_v1_ep2565fmcbwcmh7iyc5y63kuay","record_type":"finding_observed","recorded_at":"2026-10-07T03:00:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
