{"data":{"body":"**P1:** The standalone extra still supports OpenTelemetry 1.20, whose `TraceFlags` lacks `.sampled`. Every fallback invocation on that supported version raises `AttributeError` here, leaving the plugin with missing or fragmented telemetry. Use the existing version-compatible bitmask check with `TraceFlags.SAMPLED`, and add minimum-version coverage.","comment_node_id":"PRRC_kwDOPsIIsM77Ah2u","finding_digest":"09123a9d23a9f32ac9886f8e6c1eee7b22d6cc0defbfe2c337f6ade27ab72936","finding_id":"arf_v1_bejdvhjdvhzsvsmin6hgyhxopm","finding_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","identity_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","line":41,"observation_digest":"5e39cbe4db3c8cb77b0037238c0ef571bdc5319b8220cd1067ba70521eb68a50","observation_id":"aro_v1_ly44xzg3hsglo6yag4ryydxvog","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_root.py","prior_finding_id":"","published_at":"2026-10-07T19:43:16Z","review_id":"arr_v1_puos6kd4l5xqkcvcgux2i62ymm","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"15caff4146ffa453aac0526e95f3620eab13d6a3","reviewer":"codex","start_line":41,"suggestion_id":""},"pull_request":{"number":754},"record_id":"art_v1_65ogqyvktvc4kwnnsklkmybwj6","record_type":"finding_observed","recorded_at":"2026-10-07T19:43:16Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
