{"data":{"body":"**P1:** The standalone extra still supports OpenTelemetry 1.20, whose `TraceFlags` lacks `.sampled`. Every fallback invocation on that supported version raises `AttributeError` here, leaving the plugin with missing or fragmented telemetry. Use the existing version-compatible bitmask check with `TraceFlags.SAMPLED`, and add minimum-version coverage.","comment_node_id":"PRRC_kwDOPsIIsM77Hfoo","finding_digest":"09123a9d23a9f32ac9886f8e6c1eee7b22d6cc0defbfe2c337f6ade27ab72936","finding_id":"arf_v1_bejdvhjdvhzsvsmin6hgyhxopm","finding_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","identity_key":"otel/execution_root.py::executionroot.export::minimum-otel-traceflags-compatibility","line":41,"observation_digest":"d93567df76dec6c86f5e5b0fc7473d09b9571268c8a5d8dff253b03ad34ca8fb","observation_id":"aro_v1_3e2wpx3w33dmq326lmh4orz5bg","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/execution_root.py","prior_finding_id":"arf_v1_bejdvhjdvhzsvsmin6hgyhxopm","published_at":"2026-10-07T23:25:36Z","review_id":"arr_v1_wx6lvqlbpkuv4ezabn2y7tj72t","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"2492e7197226921012199091ea0ebe3080de882f","reviewer":"codex","start_line":41,"suggestion_id":""},"pull_request":{"number":754},"record_id":"art_v1_n7qaqyxu6mqqy3o4sogapffb7e","record_type":"finding_observed","recorded_at":"2026-10-07T23:25:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
