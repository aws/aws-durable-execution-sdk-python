{"data":{"body":"**[P2] Do not invoke customer transforms while holding `state.lock`**\n\n`_emit()` calls configured input/output and operation-result transforms while this lock is held. If one waits for a concurrent hook for the same execution, that hook blocks acquiring the lock and the invocation deadlocks. Snapshot/reserve emission state under the lock, run customer callables unlocked, then reacquire only to validate the gate and enqueue the record.","comment_node_id":"PRRC_kwDOPsIIsM7wUrBb","finding_digest":"db6cfd5399cfb83c082679c9aad91c0468030e33b4dab3595300a77749106aa8","finding_id":"arf_v1_3nwp2u4zz64dycbgphe2vwi4ar","finding_key":"insight/plugin.py::_emit::customer-callout-under-state-lock","identity_key":"insight/plugin.py::_emit::customer-callout-under-state-lock","line":292,"observation_digest":"3540c3ec6d0e53492cf7a13a9274a3ace86d0fa6fc3f560ac9b1f8b10eec9572","observation_id":"aro_v1_gvamh3dnbzjuslhxue5je5fdvt","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/plugin.py","prior_finding_id":"","published_at":"2026-09-17T00:20:35Z","review_id":"arr_v1_33ayiya5fwsl4v4tcidzfuh3ei","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"fb8af739a92f7fd8070d928029150fe4e5c9cc61","reviewer":"codex","start_line":292,"suggestion_id":""},"pull_request":{"number":734},"record_id":"art_v1_d2ewmgu7q35k7xlvyqoisu7twy","record_type":"finding_observed","recorded_at":"2026-09-17T00:20:35Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
