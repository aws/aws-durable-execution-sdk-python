{"data":{"body":"**[P2] Add the required end-to-end lifecycle coverage**\n\nThese tests call hooks and scheduler internals directly, so they do not exercise `PluginExecutor` ordering or the real durable lifecycle. Repository rules require e2e tests for cross-component and public lifecycle changes. Add coverage under `tests/e2e/` for concurrent executions sharing one plugin and flush-on-no-emission behavior.","comment_node_id":"PRRC_kwDOPsIIsM7wUrGx","finding_digest":"3d386fd8b67f8a747db9c4a6b1c7dc01b91712063c6dbc40c82252f9eb03c641","finding_id":"arf_v1_hu4g7wfwp6fhi7nzystldr64ag","finding_key":"insight/tests/test_plugin.py::test_concurrent_executions_each_deliver_their_terminal_record::missing-e2e-lifecycle-coverage","identity_key":"insight/tests/test_plugin.py::test_concurrent_executions_each_deliver_their_terminal_record::missing-e2e-lifecycle-coverage","line":662,"observation_digest":"9ee0d8fb1d83a22e06c0d248a922feb87a837762456c106ed4243da77d3751af","observation_id":"aro_v1_t3qnr6y5qorc4bwa2jeksix6xb","path":"packages/aws-durable-execution-sdk-python-insight/tests/test_plugin.py","prior_finding_id":"","published_at":"2026-09-17T00:20:39Z","review_id":"arr_v1_33ayiya5fwsl4v4tcidzfuh3ei","reviewed_base_sha":"cf4d27f59c2bf14f87c3ef75f58fc0881b2e2c34","reviewed_head_sha":"fb8af739a92f7fd8070d928029150fe4e5c9cc61","reviewer":"codex","start_line":662,"suggestion_id":""},"pull_request":{"number":734},"record_id":"art_v1_kz24ehvvkw37avgevunesvm3ze","record_type":"finding_observed","recorded_at":"2026-09-17T00:20:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
