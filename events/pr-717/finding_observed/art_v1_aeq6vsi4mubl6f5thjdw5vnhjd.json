{"data":{"body":"**[P3] Preserve non-bundled local version labels**\n\n`split(\"+\")[0]` runs for every install, so a non-bundled build such as `2.0.0+acme.1` is now reported as `2.0.0`, collapsing distinct builds in SDK telemetry. Strip only the exact `+bundled` suffix when `_is_bundled()` is true; otherwise retain `__version__`. Add a user-agent test using a different local label.","comment_node_id":"PRRC_kwDOPsIIsM7vql2W","finding_digest":"958fe66241d835f08bbf21a274f97e1ccca8663f7d3a7afea5f3cf1c686acdad","finding_id":"arf_v1_swh6mysb3a27bc57egrhj6l6dt","finding_key":"core/lambda_service.py::initialize_client::nonbundled-local-version-preservation","identity_key":"core/lambda_service.py::initialize_client::nonbundled-local-version-preservation","line":1217,"observation_digest":"54a64c232841184ee342b80b94769ecaffc648c3d402feeaf314d8921a80bcf8","observation_id":"aro_v1_ksteyiziieme5y2cxafzi5u6zl","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/lambda_service.py","prior_finding_id":"","published_at":"2026-09-15T22:55:15Z","review_id":"arr_v1_se55ahebo6svdod6bhssyixh3h","reviewed_base_sha":"5a09149848101e44a4281c53c74dc9f1a98d1ffd","reviewed_head_sha":"f30b5b7c4fa16b774a1b4682c1ef2dc33bf884db","reviewer":"codex","start_line":1217,"suggestion_id":""},"pull_request":{"number":717},"record_id":"art_v1_aeq6vsi4mubl6f5thjdw5vnhjd","record_type":"finding_observed","recorded_at":"2026-09-15T22:55:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
