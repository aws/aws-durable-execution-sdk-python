{"data":{"body":"**[P2] Bound HTTP response reads**\n\nThe helper loads every success or error response fully into memory even though most callers discard it. A faulty endpoint can stream a very large body and exhaust Lambda memory. Skip successful bodies when unused and cap diagnostic reads to a small fixed size; test oversized responses.","comment_node_id":"PRRC_kwDOPsIIsM7uC8zH","finding_digest":"96912924c2fbf864e1e3caf208def15c3c756b9aef94e5bea594c3b2ced2949d","finding_id":"arf_v1_s2issjgc7p4gjypdzlzarxxrlq","finding_key":"insight/exporters/_common.py::http_send::bounded-response-read","identity_key":"insight/exporters/_common.py::http_send::bounded-response-read","line":81,"observation_digest":"0c1e46102d13a62889bbc276d447e13b26206e8ace39603e94f29f242c88d2d5","observation_id":"aro_v1_bqpemebncotcrcn3yj3nir7bhm","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-11T22:03:40Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":81,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_idk5a6srzk4cb3ulfvz3kktdvx","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:40Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
