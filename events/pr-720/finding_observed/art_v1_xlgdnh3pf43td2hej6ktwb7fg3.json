{"data":{"body":"**[P1] Bound HTTP requests made from plugin hooks**\n\n`OTelExporter` and `OpenSearchExporter` call this helper without a timeout, permitting an indefinitely blocking connect or read. Exporters run synchronously during operation-change and invocation-end hooks, so a stalled endpoint can block checkpoint completion or the handler response until Lambda times out. Give these exporters a finite configurable timeout (or make this default finite) and test a stalled endpoint.","comment_node_id":"PRRC_kwDOPsIIsM7t9pSn","finding_digest":"ac2df1b1e8ffd3b551e50aaf85ce40437eb83a204a99d5d624be01c213bc39f4","finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","finding_key":"insight/exporters/_common.py::http_send::finite-timeout","identity_key":"insight/exporters/_common.py::http_send::finite-timeout","line":66,"observation_digest":"026d3aca0d6376e3b733ba02e3ac80cd1d72f8f0e5a8a1e20613a78a3530396a","observation_id":"aro_v1_ajwtvsqnmn3ohnztxibohleazu","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-11T18:43:47Z","review_id":"arr_v1_2cq7dktxvabgcbetwmfipqxnt7","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"32c68f1b2186ef5140fef99a73aa5360f129fac8","reviewer":"codex","start_line":66,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_xlgdnh3pf43td2hej6ktwb7fg3","record_type":"finding_observed","recorded_at":"2026-09-11T18:43:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
