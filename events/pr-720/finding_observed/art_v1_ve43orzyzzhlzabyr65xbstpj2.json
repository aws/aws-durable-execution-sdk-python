{"data":{"body":"**[P3] Use the instrumentation library version for the scope**\n\nInstrumentationScope.version identifies the emitting library, not the workflow record schema. Using `schemaVersion` makes every SDK release report scope version `1.0` and misgroups telemetry. Use the insight package version from `__about__`, or omit the scope version.","comment_node_id":"PRRC_kwDOPsIIsM7uC9HC","finding_digest":"f4194c28442c0cb8f05cad6e09686fcded69dc903504ef5f4953f9ddfc671106","finding_id":"arf_v1_6qmuykcefqglr4c4vvxas2dpzx","finding_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","identity_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","line":115,"observation_digest":"7dea118ac5ccf4759ff62910f5bc60e9b9c949a02c7e55ce4946271055aa87e1","observation_id":"aro_v1_pxvbdcwfzt2hlh7wfeiplpda5g","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"","published_at":"2026-09-11T22:03:54Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":112,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_ve43orzyzzhlzabyr65xbstpj2","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:54Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
