{"data":{"body":"**[P2] Measure the bytes JSON mode actually writes**\n\nThe scheduler measures compact JSON returned by `render()`, but JSON mode writes indented JSON. A record can therefore pass or be truncated to `max_record_size_bytes` and still produce a larger file. Serialize compactly as measured, or make truncation account for the pretty-printed representation, with a boundary test using nested data.","comment_node_id":"PRRC_kwDOPsIIsM7uDuHw","finding_digest":"52fe803682f8a5331094f91887dbf1120a5135c344d04ef1eabb78691a2292fc","finding_id":"arf_v1_kl7ianuc7cstgeeu7emipw7rci","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","line":79,"observation_digest":"734c52512f47812cbcf29fa4477c18b380928d49ff267c1b5fb47ca487f5ac73","observation_id":"aro_v1_ongfeujpi6aszphst6seo7aywo","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kl7ianuc7cstgeeu7emipw7rci","published_at":"2026-09-11T22:40:31Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":77,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_7lluefkh2phgutk4zixb25iy4k","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:31Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
