{"data":{"body":"**[P1] Avoid a shared unlocked NDJSON file on EFS**\n\nDefault mode funnels every execution for a day into one file, but append positioning is not atomic across EFS/NFS clients and large text writes may split. Concurrent Lambda environments can therefore overwrite or interleave records. Use per-execution/per-writer files or an EFS-compatible cross-process lock around one encoded write, and add concurrent-writer coverage.","comment_node_id":"PRRC_kwDOPsIIsM7uDuA2","finding_digest":"ec7f85a6806de23e7011f3b1a9bba6796a32e062b508f9f197df5d70c90349ec","finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","line":71,"observation_digest":"3183422f17c478c83ffd1eb7ca67fb1eb8eaae754480fda286f90c01fa6b0853","observation_id":"aro_v1_ggbuelyxyr4mqp75d234uz73d2","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","published_at":"2026-09-11T22:40:25Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":70,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_dku72ecosfmxnhgk44alwx7slw","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
