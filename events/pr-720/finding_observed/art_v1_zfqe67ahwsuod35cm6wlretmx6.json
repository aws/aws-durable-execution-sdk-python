{"data":{"body":"**[P2] Validate Redshift authentication combinations**\n\nThe Data API permits `db_user` only for a provisioned cluster using temporary database-user credentials; it cannot accompany a workgroup or `secret_arn`. This constructor accepts both invalid combinations, causing every export to fail with a validation error that the scheduler reduces to a warning. Reject those combinations at construction and cover each supported authentication mode in tests and documentation.","comment_node_id":"PRRC_kwDOPsIIsM7uEb81","finding_digest":"5b29d47af3f5de50628c76544fd5875a1eb1107182a30e1b6bd9cb4818b32d69","finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","line":49,"observation_digest":"9bb2c5351ce2321f37aab7f9e65635bf910aeacd6f48445b93153b5c9a9f5c83","observation_id":"aro_v1_tozmkni44izb6n5kw746mvrvx6","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","published_at":"2026-09-11T23:18:22Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":44,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_zfqe67ahwsuod35cm6wlretmx6","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:22Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
