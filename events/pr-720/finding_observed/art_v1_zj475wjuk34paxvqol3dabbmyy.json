{"data":{"body":"**[P1] Prevent concurrent EFS append corruption**\n\nThe default mode sends every invocation for a day to one unlocked append file. EFS/NFS append positioning is not atomic across clients, so scaled Lambda environments can overwrite or interleave records. Use per-execution files or cross-process locking with an atomic record write, and add concurrent-writer coverage.","comment_node_id":"PRRC_kwDOPsIIsM7uC8xT","finding_digest":"ec7f85a6806de23e7011f3b1a9bba6796a32e062b508f9f197df5d70c90349ec","finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","line":71,"observation_digest":"a8ad9a16b1d937e257ed07a93a7b3ef87ac88e4764f8062db2147aad5cbd674d","observation_id":"aro_v1_vcwzufvr3e36ev7na6utu6z67b","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","published_at":"2026-09-11T22:03:39Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":70,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_zj475wjuk34paxvqol3dabbmyy","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
