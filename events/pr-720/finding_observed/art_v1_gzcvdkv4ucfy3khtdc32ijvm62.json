{"data":{"body":"**[P1] Wait for Redshift statements to finish**\n\n`ExecuteStatement` only acknowledges submission. Subsequent snapshots can complete first, allowing an older `RUNNING` row to overwrite a terminal state, while later SQL failures are never observed. Poll the returned statement ID to a terminal state with a finite timeout before exporting the next snapshot, or add equivalent stale-write and failure handling.","comment_node_id":"PRRC_kwDOPsIIsM7uEb3a","finding_digest":"2efec889548a345d9072e2d00b9b16de0666d4057286ec779a45b0950b58d92d","finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","line":152,"observation_digest":"ed155b854daa1e170b996820bcca555a3ef86b5d2c07e288735e0085f94c1880","observation_id":"aro_v1_5ukvxbknvipboc4znaqlzssvli","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","published_at":"2026-09-11T23:18:18Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":152,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_gzcvdkv4ucfy3khtdc32ijvm62","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:18Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
