{"data":{"body":"**[P1] Prevent unsafe POST redirects**\n\n`urllib` rewrites POST requests on 301/302/303 redirects as GET and forwards non-content headers. `HttpExporter` and `OTelExporter` can therefore report success without delivering the record body and may forward authorization headers to another origin. Disable automatic redirects, or permit only same-origin redirects that preserve the method/body and strip sensitive headers on origin changes; add redirect tests.","comment_node_id":"PRRC_kwDOPsIIsM7uEbwv","finding_digest":"c85dffc4f1bd3b3891eb8bbaec54ea493cf009bd2cac55886acd374564876c3c","finding_id":"arf_v1_zbo77rhrxu5treplro5oyvhkje","finding_key":"insight/exporters/_common.py::http_send::post-redirect-safety","identity_key":"insight/exporters/_common.py::http_send::post-redirect-safety","line":81,"observation_digest":"34423574e939e310b26609672a11dee0a5c3be8fa66386f3efd8963cfce830d1","observation_id":"aro_v1_grbdk5hjhhrrbmtgbftsueo64c","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"","published_at":"2026-09-11T23:18:14Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":81,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_vevrfm6rnymrj3gkbmzjxuiwhg","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
