{"data":{"body":"**[P2] Validate Redshift's target-specific authentication modes**\n\nThis only enforces target exclusivity; it still accepts `workgroup_name` with `db_user`, and a provisioned cluster with both `db_user` and `secret_arn`. Those requests fail at the Data API and the scheduler reduces the failure to a warning, silently losing every record. Reject `db_user` for serverless and require exactly one of `db_user` or `secret_arn` for provisioned clusters.","comment_node_id":"PRRC_kwDOPsIIsM7uDuER","finding_digest":"5b29d47af3f5de50628c76544fd5875a1eb1107182a30e1b6bd9cb4818b32d69","finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","line":49,"observation_digest":"46ef37dc4cbf0acfc2e63701f58edba8b4e6908a27003506ac5fdc6cc469ee44","observation_id":"aro_v1_i3xtpxcmx4fm7qxgg4a7ldw3vc","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","published_at":"2026-09-11T22:40:28Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":44,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_gqiaewqrm2iwrma6cbi265ylio","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:28Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
