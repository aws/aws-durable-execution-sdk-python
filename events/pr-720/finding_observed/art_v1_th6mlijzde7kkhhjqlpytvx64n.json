{"data":{"body":"**[P1] Protect shared EFS appends from concurrent writers**\n\nThe default mode sends every invocation for a day to one file using an unlocked append. EFS is NFS, where append positioning is not atomic across clients, so concurrently scaled Lambda environments can overwrite or interleave records and corrupt the NDJSON file. Use per-execution files or cross-process locking with an atomic record write, and add concurrent-writer coverage.","comment_node_id":"PRRC_kwDOPsIIsM7t9pZY","finding_digest":"ec7f85a6806de23e7011f3b1a9bba6796a32e062b508f9f197df5d70c90349ec","finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","line":71,"observation_digest":"f6b06c9f332e9462591b6e17bee0c1899efa2b30fba731a71d64296f44e068b0","observation_id":"aro_v1_62ygzhztf2kgewi3nyl35ygbrg","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"","published_at":"2026-09-11T18:43:51Z","review_id":"arr_v1_2cq7dktxvabgcbetwmfipqxnt7","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"32c68f1b2186ef5140fef99a73aa5360f129fac8","reviewer":"codex","start_line":70,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_th6mlijzde7kkhhjqlpytvx64n","record_type":"finding_observed","recorded_at":"2026-09-11T18:43:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
