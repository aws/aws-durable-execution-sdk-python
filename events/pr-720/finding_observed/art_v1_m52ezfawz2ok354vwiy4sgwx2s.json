{"data":{"body":"**[P1] Wait for Redshift statements to finish**\n\n`ExecuteStatement` only acknowledges submission. Sequential `on-change` submissions may complete out of order, allowing an older `RUNNING` row to overwrite `SUCCEEDED`, while later SQL failures are never observed. Poll the returned statement ID to a terminal state with a finite timeout, or add an `emitted_at` stale-write guard and separately surface failed statements.","comment_node_id":"PRRC_kwDOPsIIsM7uDuCi","finding_digest":"2efec889548a345d9072e2d00b9b16de0666d4057286ec779a45b0950b58d92d","finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","line":152,"observation_digest":"5560f2649f3a68f82c0fdc0b2165f8bb44baa3d255733f9732362f76a485fb0d","observation_id":"aro_v1_kvqpeze7hjupqlap3qfsczpyxn","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","published_at":"2026-09-11T22:40:27Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":152,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_m52ezfawz2ok354vwiy4sgwx2s","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:27Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
