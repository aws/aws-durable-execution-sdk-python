{"data":{"body":"**[P2] Measure the bytes JSON mode actually writes**\n\nThe scheduler checks `render(record)` using compact JSON, but JSON mode writes indented JSON. With `max_record_size_bytes` configured, the resulting file can substantially exceed the limit. Serialize identically to the size check or make the renderer account for indentation, and add a nested-record size test.","comment_node_id":"PRRC_kwDOPsIIsM7uC89c","finding_digest":"52fe803682f8a5331094f91887dbf1120a5135c344d04ef1eabb78691a2292fc","finding_id":"arf_v1_kl7ianuc7cstgeeu7emipw7rci","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","line":79,"observation_digest":"44b8de0056e7ab41d33b7625491be3e0baa6bc4c9f87570b280e23a1585cca3f","observation_id":"aro_v1_is4n4acw46vuduz3oysusg7d4c","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"","published_at":"2026-09-11T22:03:48Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":77,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_nls6bqgwxvkoi5ts7ya6lgznen","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:48Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
