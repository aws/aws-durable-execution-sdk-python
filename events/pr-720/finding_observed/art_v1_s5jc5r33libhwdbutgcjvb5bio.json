{"data":{"body":"**[P2] Fail fast when basic-auth credentials are absent**\n\n`auth=\"basic\"` currently accepts missing credentials and sends the literal `None:None`. Because exporter failures are later swallowed into warnings, this can silently drop every record. Require both username and password at construction, checking specifically for `None` so an intentionally empty password remains possible.","comment_node_id":"PRRC_kwDOPsIIsM7uC8_i","finding_digest":"953effe2378fd34f319beecde3aee13329a853ba20c843258ba16354bcfef9d9","finding_id":"arf_v1_su7p7yrxr7ju6mm353g6hlxbgm","finding_key":"insight/exporters/opensearch_exporter.py::opensearchexporter.__init__::basic-credentials-required","identity_key":"insight/exporters/opensearch_exporter.py::opensearchexporter.__init__::basic-credentials-required","line":57,"observation_digest":"fe4e86ccc08df2ce48e3d0dc385672c1d49a5593debea80ed4656979a83ceeb0","observation_id":"aro_v1_7zhintgarxzm4shd2dodqvtsyh","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/opensearch_exporter.py","prior_finding_id":"","published_at":"2026-09-11T22:03:49Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":55,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_s5jc5r33libhwdbutgcjvb5bio","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:49Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
