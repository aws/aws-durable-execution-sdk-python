{"data":{"body":"**[P2] Validate Redshift authentication combinations**\n\n`db_user` is valid only with a provisioned cluster using temporary credentials; it cannot accompany a workgroup or `secret_arn`. These combinations are accepted here and every export subsequently fails service validation, which the scheduler reduces to a warning. Reject invalid combinations during construction and test each supported authentication mode.","comment_node_id":"PRRC_kwDOPsIIsM7uEtj4","finding_digest":"5b29d47af3f5de50628c76544fd5875a1eb1107182a30e1b6bd9cb4818b32d69","finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","line":55,"observation_digest":"7cb4064bf568b639beee642b39dbf75206ccdbc8f9e51f2d4f2832829dc934b0","observation_id":"aro_v1_ps2ams7vnc3dtpxomqvttw7xki","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","published_at":"2026-09-11T23:35:14Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":54,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_kkelwezrgzyrkgpwgg262ksl3y","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
