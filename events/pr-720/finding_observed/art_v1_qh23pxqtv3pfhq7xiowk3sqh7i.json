{"data":{"body":"**[P2] Surface OTLP partial-success rejection**\n\nOTLP/HTTP may return 2xx with `partialSuccess.rejectedLogRecords`, but this treats every 2xx as complete success and the helper discards successful response bodies. Records can be rejected without any warning. Read a bounded success body for this exporter, parse `partialSuccess`, and report rejected records and the accompanying error message.","comment_node_id":"PRRC_kwDOPsIIsM7uDuJd","finding_digest":"56b67473ac0331e58ad263665b9c5c8cdbf0033c3916ee48bd0f76a45079d038","finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","finding_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","identity_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","line":91,"observation_digest":"d59126ebb8c95f7410bdb866a826f14c0376114dc7c38878427d5db22ea7cdad","observation_id":"aro_v1_2wisn25yzfpxief5xbtkqjxrjq","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","published_at":"2026-09-11T22:40:33Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":88,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_qh23pxqtv3pfhq7xiowk3sqh7i","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:33Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
