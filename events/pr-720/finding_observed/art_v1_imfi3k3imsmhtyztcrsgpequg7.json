{"data":{"body":"**[P2] Surface OTLP partial-success rejection**\n\nOTLP/HTTP can return 2xx with `partialSuccess.rejectedLogRecords`, but the helper discards successful response bodies, so rejected logs are treated as exported. Read a bounded success body for this exporter, parse `partialSuccess`, and report rejected records with its error message.","comment_node_id":"PRRC_kwDOPsIIsM7uEtlE","finding_digest":"56b67473ac0331e58ad263665b9c5c8cdbf0033c3916ee48bd0f76a45079d038","finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","finding_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","identity_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","line":88,"observation_digest":"6affca6684c334b36e968f376164424d1570aaa6adee8fe92c54cffb03b21692","observation_id":"aro_v1_nl74uzueym2lg3uwr43wczccju","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","published_at":"2026-09-11T23:35:15Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":88,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_imfi3k3imsmhtyztcrsgpequg7","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
