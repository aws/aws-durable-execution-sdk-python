{"data":{"body":"**[P2] Surface OTLP partial-success rejection**\n\nOTLP/HTTP may return 2xx with `partialSuccess.rejectedLogRecords`, but the shared helper discards successful response bodies. Rejected records are consequently treated as fully exported. Read a bounded success body for this exporter, parse `partialSuccess`, and report rejected records with the accompanying error message.","comment_node_id":"PRRC_kwDOPsIIsM7uEb-o","finding_digest":"56b67473ac0331e58ad263665b9c5c8cdbf0033c3916ee48bd0f76a45079d038","finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","finding_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","identity_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","line":88,"observation_digest":"8a4f1ad0690c4028a89b1bb78d904089a18d21cb81966639effbc920cfe393ce","observation_id":"aro_v1_rjhrvudjbracrke3do3y3ecarg","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","published_at":"2026-09-11T23:18:24Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":88,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_doekzngxy3hwlmn74atd3ehq5s","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
