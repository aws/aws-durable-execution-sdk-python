{"data":{"body":"**[P1] Wait for Redshift statements to finish**\n\n`ExecuteStatement` only acknowledges submission. Later snapshots may complete first, allowing an older `RUNNING` row to overwrite terminal state, while asynchronous SQL failures are never observed. Poll the returned statement ID to a terminal state with a finite timeout, or implement equivalent stale-write and failure handling.","comment_node_id":"PRRC_kwDOPsIIsM7uEth7","finding_digest":"2efec889548a345d9072e2d00b9b16de0666d4057286ec779a45b0950b58d92d","finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","line":152,"observation_digest":"8b7d1bd7dbacf8f2a08c5e6401d4bac05fba7b411a1066eb7cc1d3f5644ea241","observation_id":"aro_v1_rn6rxv63vt4pfiemlzsadvf2yb","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","published_at":"2026-09-11T23:35:11Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":152,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_obgifdwlxljif7xft6tx4vabnw","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:11Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
