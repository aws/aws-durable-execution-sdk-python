{"data":{"body":"**[P1] Avoid unlocked shared appends on EFS**\n\nDefault mode funnels every execution for a day into one file, but append positioning is not atomic across NFS/EFS clients and concurrent Lambda environments can overwrite or interleave records. Use per-execution/per-writer files or an EFS-compatible cross-process lock around each encoded write.","comment_node_id":"PRRC_kwDOPsIIsM7uEtix","finding_digest":"ec7f85a6806de23e7011f3b1a9bba6796a32e062b508f9f197df5d70c90349ec","finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","line":71,"observation_digest":"dc0e767c706e4985516439ad2387a176414d5f82bcc989acc9e1218b177ec66d","observation_id":"aro_v1_3qhhm7dqnzeykulehgwshb5boz","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","published_at":"2026-09-11T23:35:13Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":70,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_5fzc2sumiq3db55ebl77lqsafr","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:13Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
