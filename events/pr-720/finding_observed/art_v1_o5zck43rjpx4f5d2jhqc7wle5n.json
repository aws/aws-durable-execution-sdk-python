{"data":{"body":"**[P2] Key JSON files by an unambiguous execution identity**\n\nExecution names can be reused, and `sanitize()` is many-to-one, so distinct executions can overwrite the same file. Derive the filename from `executionArn`, preferably with a stable digest plus a readable prefix, and test same-name and sanitization collisions.","comment_node_id":"PRRC_kwDOPsIIsM7uC83H","finding_digest":"54966b50239711349862a6d0a09432313d416b2e2bed9bc806d960c7c622ee4c","finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","line":75,"observation_digest":"6784c1fa157375dd0eb9c1648791ed087b7b8039bf0113ddaaddc66fdace45f9","observation_id":"aro_v1_m6cmd6qvon252dvzyfsipepnbb","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","published_at":"2026-09-11T22:03:43Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":73,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_o5zck43rjpx4f5d2jhqc7wle5n","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
