{"data":{"body":"**[P2] Reject invalid Redshift target/auth combinations**\n\nThis validates only that one target exists, then can send both WorkgroupName and ClusterIdentifier or DbUser with a serverless workgroup. Those mutually exclusive configurations are accepted locally but fail every asynchronous export. Require exactly one target and validate the target-specific DbUser/SecretArn combination at construction, with negative tests.","comment_node_id":"PRRC_kwDOPsIIsM7uC81R","finding_digest":"5b29d47af3f5de50628c76544fd5875a1eb1107182a30e1b6bd9cb4818b32d69","finding_id":"arf_v1_lmu5i6xt6xpfayumozke7vmhli","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.__init__::target-auth-exclusivity","line":48,"observation_digest":"7a019c6597d31ab5d89f1501bc75aac958c6daa7ef31e794796710a47b56948b","observation_id":"aro_v1_piazyzmx2mnllwe7cua3y5nkzf","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"","published_at":"2026-09-11T22:03:42Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":44,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_5wrw6ogsp6kfm7jpp7varru3pm","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:42Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
