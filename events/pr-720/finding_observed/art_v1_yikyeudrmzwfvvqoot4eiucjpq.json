{"data":{"body":"**[P2] Key JSON files by an unambiguous execution identity**\n\nExecution names can be reused, and `sanitize()` maps distinct names to the same value. Different executions can consequently overwrite the same file. Derive the filename from `executionArn`, preferably using a stable digest plus a readable name prefix, and test both reuse and sanitization collisions.","comment_node_id":"PRRC_kwDOPsIIsM7uDuGA","finding_digest":"54966b50239711349862a6d0a09432313d416b2e2bed9bc806d960c7c622ee4c","finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","line":76,"observation_digest":"c293e1e5c5f5c413ed5b49cdbb7bdc42eeee08c993549bebc6f4318b99ed672b","observation_id":"aro_v1_ykj6dzof6xcbh3k3jhg3w664il","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","published_at":"2026-09-11T22:40:30Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":73,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_yikyeudrmzwfvvqoot4eiucjpq","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:30Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
