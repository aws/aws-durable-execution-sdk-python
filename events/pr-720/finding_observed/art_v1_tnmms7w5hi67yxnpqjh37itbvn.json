{"data":{"body":"**[P1] Wait for Redshift statements to complete**\n\nExecuteStatement only submits asynchronous work. In `on-change` mode, older MERGEs can finish after the terminal MERGE and overwrite it with `RUNNING`; later SQL failures are also never observed. Poll the returned statement ID with a finite timeout and surface failed/aborted states, or serialize updates with an `emitted_at` stale-write guard.","comment_node_id":"PRRC_kwDOPsIIsM7uC8u7","finding_digest":"2efec889548a345d9072e2d00b9b16de0666d4057286ec779a45b0950b58d92d","finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","finding_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","identity_key":"insight/exporters/redshift_exporter.py::redshiftexporter.export::completion-ordering","line":151,"observation_digest":"f1c732575258c89d6a6b43b1d3fd80f6f3061da3e8466923791b2fa961a01e5e","observation_id":"aro_v1_6hdtev2sldej22tlioy5h7ma63","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/redshift_exporter.py","prior_finding_id":"arf_v1_f37mrckuri2f3eds4liaxgyw3y","published_at":"2026-09-11T22:03:37Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":151,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_tnmms7w5hi67yxnpqjh37itbvn","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:37Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
