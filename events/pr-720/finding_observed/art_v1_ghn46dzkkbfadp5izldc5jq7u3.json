{"data":{"body":"**[P1] Avoid unlocked shared appends on EFS**\n\nDefault mode funnels every execution for a day into one file, but append positioning is not atomic across EFS/NFS clients and large writes may interleave. Concurrent Lambda environments can corrupt records. Use per-execution/per-writer files or an EFS-compatible cross-process lock around one encoded write, with concurrent-writer coverage.","comment_node_id":"PRRC_kwDOPsIIsM7uEb1L","finding_digest":"ec7f85a6806de23e7011f3b1a9bba6796a32e062b508f9f197df5d70c90349ec","finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::efs-append-atomicity","line":71,"observation_digest":"48ad059cbbcc4c4e90111f76449e0becda14d4bfa1e393858fe376b42a01b283","observation_id":"aro_v1_jcwqlhf3zrge5eard53ejhql5t","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_5r7yljuanxrd44ar6oy2to5gpf","published_at":"2026-09-11T23:18:16Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":70,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_ghn46dzkkbfadp5izldc5jq7u3","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:16Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
