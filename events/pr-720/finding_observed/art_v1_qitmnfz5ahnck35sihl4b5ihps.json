{"data":{"body":"**[P3] Use the instrumentation library version for the scope**\n\n`InstrumentationScope.version` identifies the emitting library, not the workflow record schema. Using `schemaVersion` leaves the scope permanently reported as `1.0` and misgroups telemetry across SDK releases. Use the insight package version from `__about__`, or omit the scope version.","comment_node_id":"PRRC_kwDOPsIIsM7uDuNr","finding_digest":"f4194c28442c0cb8f05cad6e09686fcded69dc903504ef5f4953f9ddfc671106","finding_id":"arf_v1_6qmuykcefqglr4c4vvxas2dpzx","finding_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","identity_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","line":116,"observation_digest":"2c28f1f7897db2837222de4c8eb25428e486718a9788c104576f59d1f254e499","observation_id":"aro_v1_fqupd54jpwzig4rc3zgi5msufd","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"arf_v1_6qmuykcefqglr4c4vvxas2dpzx","published_at":"2026-09-11T22:40:35Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":114,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_qitmnfz5ahnck35sihl4b5ihps","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:35Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
