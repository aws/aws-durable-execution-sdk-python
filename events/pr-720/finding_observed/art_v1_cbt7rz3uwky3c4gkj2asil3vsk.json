{"data":{"body":"**[P3] Use the instrumentation library version for the scope**\n\n`InstrumentationScope.version` identifies the emitting library, not the workflow record schema. Using `schemaVersion` permanently reports the scope as `1.0` and misgroups telemetry across SDK releases. Use the insight package version from `__about__`, or omit the scope version.","comment_node_id":"PRRC_kwDOPsIIsM7uEcAq","finding_digest":"f4194c28442c0cb8f05cad6e09686fcded69dc903504ef5f4953f9ddfc671106","finding_id":"arf_v1_6qmuykcefqglr4c4vvxas2dpzx","finding_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","identity_key":"insight/exporters/otel_exporter.py::otelexporter._build_payload::instrumentation-scope-version","line":116,"observation_digest":"a02ba14d494c7ebddce96c58db5dfd1cbbd830aea03ef5701bfb2e0d02460872","observation_id":"aro_v1_uav2ctkjjr7l3xhjnrmnwxp5ds","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"arf_v1_6qmuykcefqglr4c4vvxas2dpzx","published_at":"2026-09-11T23:18:25Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":114,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_cbt7rz3uwky3c4gkj2asil3vsk","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
