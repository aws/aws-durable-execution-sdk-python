{"data":{"body":"**[P1] Give every HTTP-backed exporter a finite timeout**\n\n`OTelExporter` and `OpenSearchExporter` omit this argument, leaving their requests unbounded. A stalled endpoint then blocks the sole export worker while invocation completion waits indefinitely in `drain()`. Provide a finite default or expose validated timeout settings on both exporters, with stalled-endpoint tests.","comment_node_id":"PRRC_kwDOPsIIsM7uEbzC","finding_digest":"ac2df1b1e8ffd3b551e50aaf85ce40437eb83a204a99d5d624be01c213bc39f4","finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","finding_key":"insight/exporters/_common.py::http_send::finite-timeout","identity_key":"insight/exporters/_common.py::http_send::finite-timeout","line":68,"observation_digest":"abb29368891b1b57abb0bf45fdc66fe3e35a4bead336f7a2a55583eba5c1196c","observation_id":"aro_v1_vozjg2ejdmnvpk5qx5c73rtp4p","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","published_at":"2026-09-11T23:18:15Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":68,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_m5w6roxfe6fshhktvt5chwcxs6","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
