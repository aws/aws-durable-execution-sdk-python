{"data":{"body":"**[P2] Key JSON files by an unambiguous execution identity**\n\n`executionName` is not globally unique when multiple functions share a directory, and sanitization can also map distinct names to the same filename. Unrelated executions can overwrite each other. Derive the filename from `executionArn`, preferably using a stable digest plus a readable name prefix, and test cross-function and sanitization collisions.","comment_node_id":"PRRC_kwDOPsIIsM7uEb5B","finding_digest":"54966b50239711349862a6d0a09432313d416b2e2bed9bc806d960c7c622ee4c","finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","line":75,"observation_digest":"c22bb2b900c9e0d3f694996803f784b51db3d59730cfe0f7cfcd55f08ee27bd7","observation_id":"aro_v1_yiv3foiazhqnh5uutfuah54ewu","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","published_at":"2026-09-11T23:18:19Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":73,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_iysyl3m7r4l6jk4j5uwveag7w7","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:19Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
