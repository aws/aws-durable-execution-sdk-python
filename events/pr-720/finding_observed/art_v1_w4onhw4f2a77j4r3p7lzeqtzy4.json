{"data":{"body":"**[P2] Key JSON files by an unambiguous execution identity**\n\n`executionName` is not unique across functions sharing a directory, and sanitization maps distinct names to the same filename. Unrelated executions can therefore overwrite each other. Derive the filename from `executionArn`, preferably with a stable digest plus a readable name prefix.","comment_node_id":"PRRC_kwDOPsIIsM7uEtmr","finding_digest":"54966b50239711349862a6d0a09432313d416b2e2bed9bc806d960c7c622ee4c","finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","line":75,"observation_digest":"c9748ac2f473eb7b2719a5cd27381f400fea46b690021b352bd3500b7f4ba3c8","observation_id":"aro_v1_zf2ivqxuopvxwjyzuxgsooa7ia","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","published_at":"2026-09-11T23:35:17Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":73,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_w4onhw4f2a77j4r3p7lzeqtzy4","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:17Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
