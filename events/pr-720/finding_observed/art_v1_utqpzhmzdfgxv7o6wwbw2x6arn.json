{"data":{"body":"**[P2] Measure the bytes JSON mode actually writes**\n\nThe scheduler measures compact JSON returned by `render()`, but JSON mode writes indented JSON. A record can pass or be truncated to `max_record_size_bytes` and still produce a larger file. Serialize compactly as measured, or make truncation account for the exact pretty-printed representation, with a boundary test.","comment_node_id":"PRRC_kwDOPsIIsM7uEb6u","finding_digest":"52fe803682f8a5331094f91887dbf1120a5135c344d04ef1eabb78691a2292fc","finding_id":"arf_v1_kl7ianuc7cstgeeu7emipw7rci","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::json-size-limit","line":78,"observation_digest":"9bab9fe5f1fd33a426a07be9a12bc6d4255c413a14a27236608b360c9dda710c","observation_id":"aro_v1_tovz7zpr7uz2ijvappu2ck6g2q","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"arf_v1_kl7ianuc7cstgeeu7emipw7rci","published_at":"2026-09-11T23:18:21Z","review_id":"arr_v1_ye3ydz5usqvpcutnf6yc5uvdmf","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"deda80a630863c21a31e9529d1b2d6d7b2a420fe","reviewer":"codex","start_line":77,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_utqpzhmzdfgxv7o6wwbw2x6arn","record_type":"finding_observed","recorded_at":"2026-09-11T23:18:21Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
