{"data":{"body":"**[P1] Bound every HTTP-backed export**\n\nOTelExporter and OpenSearchExporter call this helper without a timeout. A stalled endpoint therefore blocks the export worker, and invocation-end draining can hang until Lambda itself times out. Give both exporters a finite configurable timeout or make the helper default finite, with stalled-endpoint tests.","comment_node_id":"PRRC_kwDOPsIIsM7uC8sO","finding_digest":"ac2df1b1e8ffd3b551e50aaf85ce40437eb83a204a99d5d624be01c213bc39f4","finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","finding_key":"insight/exporters/_common.py::http_send::finite-timeout","identity_key":"insight/exporters/_common.py::http_send::finite-timeout","line":66,"observation_digest":"0f1c1f4d95182def2c090c19a33130d2fa2cab5f2bb4f50d68cca43c34cf72c8","observation_id":"aro_v1_b4ob6tmvdaw66lajbqm2gmjq2l","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","published_at":"2026-09-11T22:03:36Z","review_id":"arr_v1_au5e3inkypj77dyafq5zyn566k","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"7f24921722e226045a5f548585ea7fbad6134fcf","reviewer":"codex","start_line":66,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_t24dr3xtnb46ir7e2fhgxj3yjl","record_type":"finding_observed","recorded_at":"2026-09-11T22:03:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
