{"data":{"body":"**[P2] Surface OTLP partial-success rejections**\n\nOTLP/HTTP may return status 200 with `partialSuccess.rejectedLogRecords` indicating that the log was rejected. Discarding the response body and accepting every 2xx makes this data loss silent. Parse successful JSON responses and raise or report when records were rejected, including `errorMessage`; add a partial-success response test.","comment_node_id":"PRRC_kwDOPsIIsM7t9pgv","finding_digest":"56b67473ac0331e58ad263665b9c5c8cdbf0033c3916ee48bd0f76a45079d038","finding_id":"arf_v1_k23hi45mamy6lcwsmntfxhc4rt","finding_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","identity_key":"insight/exporters/otel_exporter.py::otelexporter.export::partial-success-rejection","line":86,"observation_digest":"151d3405be05b1211f6413c6e2bfad78c2431191c55e8affb886ce502509c786","observation_id":"aro_v1_cuotibn6awysch3ecpdofp5npd","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/otel_exporter.py","prior_finding_id":"","published_at":"2026-09-11T18:43:54Z","review_id":"arr_v1_2cq7dktxvabgcbetwmfipqxnt7","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"32c68f1b2186ef5140fef99a73aa5360f129fac8","reviewer":"codex","start_line":86,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_zyfvcygjbzwjifancooalwlg3p","record_type":"finding_observed","recorded_at":"2026-09-11T18:43:54Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
