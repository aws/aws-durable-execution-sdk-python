{"data":{"body":"**[P1] Bound every HTTP exporter request**\n\n`OTelExporter` and `OpenSearchExporter` omit this argument, leaving requests unbounded. A stalled endpoint blocks the sole export worker, and invocation completion then waits in `drain()` until Lambda times out. Add a finite default or validated timeout settings to both exporters and pass them here.","comment_node_id":"PRRC_kwDOPsIIsM7uEtgE","finding_digest":"ac2df1b1e8ffd3b551e50aaf85ce40437eb83a204a99d5d624be01c213bc39f4","finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","finding_key":"insight/exporters/_common.py::http_send::finite-timeout","identity_key":"insight/exporters/_common.py::http_send::finite-timeout","line":84,"observation_digest":"02cb287a707dfc7be5eefae1ec2b00db71f91e1c299050c9ee9563f2ab0d8d56","observation_id":"aro_v1_alfsq6tqpx6hxzpo7lq6ykya3n","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","published_at":"2026-09-11T23:35:10Z","review_id":"arr_v1_gxyeexmt5x7z62mbqv3xknff2j","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"3a424e7bf6d3c768f38024007e42038eb43fcbde","reviewer":"codex","start_line":84,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_vm5iurpielida5lnrv5fptsz67","record_type":"finding_observed","recorded_at":"2026-09-11T23:35:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
