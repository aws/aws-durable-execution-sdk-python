{"data":{"body":"**[P2] Key JSON files by the full execution identity**\n\n`executionName` is not unique across functions or execution-name reuse, and `sanitize()` is many-to-one. Distinct executions sharing a directory can consequently overwrite the same file. Derive the filename from `executionArn`, preferably using a stable digest plus a readable prefix, and test same-name and sanitization collisions.","comment_node_id":"PRRC_kwDOPsIIsM7t9pct","finding_digest":"54966b50239711349862a6d0a09432313d416b2e2bed9bc806d960c7c622ee4c","finding_id":"arf_v1_kslgwubds4itjgdcu3ikbfbsge","finding_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","identity_key":"insight/exporters/file_exporter.py::fileexporter.export::unique-json-key","line":75,"observation_digest":"c575b2a19f2b02db6c167e7538fda302420b4e233191d439478492287b5945c8","observation_id":"aro_v1_yv23fim7fmbnw3awpz2tr7ndaj","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/file_exporter.py","prior_finding_id":"","published_at":"2026-09-11T18:43:52Z","review_id":"arr_v1_2cq7dktxvabgcbetwmfipqxnt7","reviewed_base_sha":"630b7771cedb1cf561e6ac29d49b84b6291db6b4","reviewed_head_sha":"32c68f1b2186ef5140fef99a73aa5360f129fac8","reviewer":"codex","start_line":73,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_sybphcwo24s55dnoabd4kummkw","record_type":"finding_observed","recorded_at":"2026-09-11T18:43:52Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
