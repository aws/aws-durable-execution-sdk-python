{"data":{"body":"**[P1] Give every HTTP-backed exporter a finite timeout**\n\n`OTelExporter` and `OpenSearchExporter` call this helper without a timeout, so a stalled endpoint can block the sole export worker. Because invocation completion waits in `drain()`, an otherwise successful durable invocation can time out. Make the default finite or expose and pass validated timeout settings from both exporters, with stalled-endpoint tests.","comment_node_id":"PRRC_kwDOPsIIsM7uDt_K","finding_digest":"ac2df1b1e8ffd3b551e50aaf85ce40437eb83a204a99d5d624be01c213bc39f4","finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","finding_key":"insight/exporters/_common.py::http_send::finite-timeout","identity_key":"insight/exporters/_common.py::http_send::finite-timeout","line":68,"observation_digest":"e78160df9faf097694fd52818a6b018983eccde533cc99769ca7103ea0588901","observation_id":"aro_v1_46awbx47v4exnfh5kkayu2ybrg","path":"packages/aws-durable-execution-sdk-python-insight/src/aws_durable_execution_sdk_python_insight/exporters/_common.py","prior_finding_id":"arf_v1_vqw7dmpi77j3kupfbkxyltsain","published_at":"2026-09-11T22:40:23Z","review_id":"arr_v1_xt6uhdthxa7nsmucff7v6b6xfj","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"9b517c0ced071953adbd1e93e9660837dafb3e8d","reviewer":"codex","start_line":68,"suggestion_id":""},"pull_request":{"number":720},"record_id":"art_v1_etxan66nh7ja7pxsemjink26qs","record_type":"finding_observed","recorded_at":"2026-09-11T22:40:23Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
