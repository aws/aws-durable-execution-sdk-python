{"data":{"body":"[P3] Do not guarantee delivery of the burst's first snapshot. After the first `schedule()` starts the worker, the producer can reacquire the condition and replace that same ARN's entry before the worker claims it, so the only exported snapshot may be the latest. Clarify the distinction between an unclaimed first snapshot and one already claimed by the worker.","comment_node_id":"PRRC_kwDOPsIIsM7vmyQM","finding_digest":"7a7a9c6b194cc18ade3cab2928b0c183ef087cb5347368f9412e86e623fcb682","finding_id":"arf_v1_pj5jy2yzjtayvxr4vmusrmgbqp","finding_key":"packages/aws-durable-execution-sdk-python-insight/readme.md::asynchronous-export-note::first-snapshot-guarantee","identity_key":"packages/aws-durable-execution-sdk-python-insight/readme.md::asynchronous-export-note::first-snapshot-guarantee","line":64,"observation_digest":"3e14d3a26d6260a3bef207bc427d7337b3f583bd3e1fa085cde9ad95ac86777c","observation_id":"aro_v1_hyknhitnmjqkhpxsa66ee7ltg6","path":"packages/aws-durable-execution-sdk-python-insight/README.md","prior_finding_id":"","published_at":"2026-09-15T20:29:44Z","review_id":"arr_v1_5xo5vwvuswlezq5jt4osgiwm7u","reviewed_base_sha":"8742ad9c9535e1de042963963c6b439f656894ce","reviewed_head_sha":"14fca8bbbd2bc2c7d30bf115317682cce3c21711","reviewer":"codex","start_line":63,"suggestion_id":"arsg_v1_nt3drrpzpbgjtunt6zin7baxxz"},"pull_request":{"number":727},"record_id":"art_v1_wkbc2gk7pep7l3l7zbd3q56ue7","record_type":"finding_observed","recorded_at":"2026-09-15T20:29:44Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
