{"data":{"body":"[P2] Enforce the configured session lifetime\n\nThe validated timeout is discarded, and no subsequent operation uses `config.timeout`. A one-second configuration therefore allows a handler to wait 60 seconds and return normally, with cleanup starting only afterward. This contradicts `AgentcoreSessionConfig.timeout`, which promises a session lifetime including durable waits. Enforce a replay-stable session deadline and stop the session on expiry, with regression coverage spanning suspension and replay.","comment_node_id":"","finding_digest":"a7cb9a6df45547f60b7e287f6ce0a802f98ae0fb94ca37974acc3a79d67d2260","finding_id":"arf_v1_u7fzu3pukvd7mc36fb7wzyfial","finding_key":"compute/agentcore/session.py::agentcore_session::session-timeout-not-enforced","identity_key":"compute/agentcore/session.py::agentcore_session::session-timeout-not-enforced","line":165,"observation_digest":"aa8c14b06b133a3e2b5864c1807a0635249c17d797685b610fedb4495b4bfa93","observation_id":"aro_v1_vkgbjmdlcm5d4k2ymtaya6qggu","path":"packages/aws-durable-execution-sdk-python-extras/src/aws_durable_execution_sdk_python_extras/compute/agentcore/session.py","prior_finding_id":"arf_v1_u7fzu3pukvd7mc36fb7wzyfial","published_at":"2026-11-19T22:45:17Z","review_id":"arr_v1_updbubraqzr2gk7gujt2hlunlz","reviewed_base_sha":"dc6d6542e056b1e2cf1e4e6768e436940845e563","reviewed_head_sha":"74203f63647bee13980acc1bb5de68953737c1b0","reviewer":"codex","start_line":165,"suggestion_id":"","suppressed":true,"suppression_status":"deferred"},"pull_request":{"number":968},"record_id":"art_v1_36dpxaqcefkko4igeuu5lwjaxb","record_type":"finding_observed","recorded_at":"2026-11-19T22:45:17Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
