{"data":{"body":"**[P2] Retain automated coverage for the advertised core 2.0 compatibility.** The OTel runtime dependency remains `>=2.0.0`, but changing the only published-core test environment to `>=2.1.0` leaves no checked-in suite exercising OTel 1.1 against supported core 2.0.x. Keep a lane pinned to `>=2.0,<2.1` for valid registration and lifecycle cases, and use a separate 2.1+ lane for exclusivity tests.","comment_node_id":"PRRC_kwDOPsIIsM74ljKr","finding_digest":"8e219df0fdd94200af6b2d44903b43115c1a498e40e1ebcaac9c0a7b7d0a2a42","finding_id":"arf_v1_ryqz34h53fbabl3lfvcjao2dcf","finding_key":"pyproject.toml::test-pypi-otel::minimum-core-compatibility-coverage","identity_key":"pyproject.toml::test-pypi-otel::minimum-core-compatibility-coverage","line":138,"observation_digest":"f38d482738d1e50fa7005753af44014872bc69c9745f48e0fa7e5d44c6df121a","observation_id":"aro_v1_6oguqjzy2hsq7jyak5j26rabjb","path":"pyproject.toml","prior_finding_id":"","published_at":"2026-10-02T23:15:15Z","review_id":"arr_v1_vugk6xy47xwtocgbwq6sul5egs","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"8b67dbe82ca6c7743ec2c7ce0a619212bb312648","reviewer":"codex","start_line":138,"suggestion_id":""},"pull_request":{"number":753},"record_id":"art_v1_y5xkyu6rl4ady24yt6js3e4vsm","record_type":"finding_observed","recorded_at":"2026-10-02T23:15:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
