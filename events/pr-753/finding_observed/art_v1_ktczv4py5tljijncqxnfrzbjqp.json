{"data":{"body":"**[P2] Validate exclusivity metadata before using it as a dictionary key.** Runtime-loaded plugins are not guaranteed to honor the annotation; an unhashable value such as a list currently escapes as a raw `TypeError`, while other non-string values silently become groups. Validate that `exclusive_group` is `None` or a valid string and raise `PluginLoadError` naming the plugin type, with coverage for explicit and discovered plugins.","comment_node_id":"PRRC_kwDOPsIIsM74jNet","finding_digest":"db512f5a02e63e9f283de25c4a907137abddfbfef981c7797175a414b1c2787f","finding_id":"arf_v1_3nis6wqc4y7j6kb54joevedrg6","finding_key":"core/plugin_discovery.py::_validate_exclusive_groups::metadata-type-validation","identity_key":"core/plugin_discovery.py::_validate_exclusive_groups::metadata-type-validation","line":142,"observation_digest":"c8b41d4b8c814db07d53caa7b0f3db049957ae6c33e4339bbc0a068fc5118d3d","observation_id":"aro_v1_zc2b2s4mqfg3a7ktzkt3b463as","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/plugin_discovery.py","prior_finding_id":"","published_at":"2026-10-02T21:27:43Z","review_id":"arr_v1_ikhcthwxf454c3uzzfyqtn6ewy","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"0b04265b1795677ab4d47346d4142e7047aa62f6","reviewer":"codex","start_line":139,"suggestion_id":""},"pull_request":{"number":753},"record_id":"art_v1_ktczv4py5tljijncqxnfrzbjqp","record_type":"finding_observed","recorded_at":"2026-10-02T21:27:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
