{"data":{"body":"[P1] Keep untrusted PRs off the CodeBuild runner. `build` runs for every pull request, while `lint-commits` also permits forks, so a fork author can execute arbitrary code through Hatch/tests or a modified `lintcommit.py` inside the AWS testing account. Route fork PRs\u2014and Dependabot for `build`\u2014to `ubuntu-latest` or skip them in both jobs before selecting CodeBuild.","comment_node_id":"PRRC_kwDOPsIIsM74FBqh","finding_digest":"f82b5a7ed273e471bf0e78993b587e89af56471b0c8f3a35b4df9ac36becfb85","finding_id":"arf_v1_7avvu7wsopshdpyopcmtwwd6rg","finding_key":"github/workflows/ci.yml::pull-request-jobs::fork-runner-isolation","identity_key":"github/workflows/ci.yml::pull-request-jobs::fork-runner-isolation","line":52,"observation_digest":"3d38397c896c207ea74fae62b55e074fc04a6af0102efa4d56b7f807391ae623","observation_id":"aro_v1_hu4ds7ejnqqh5j2pvzrlkxqhj7","path":".github/workflows/ci.yml","prior_finding_id":"","published_at":"2026-10-02T01:25:55Z","review_id":"arr_v1_wqtkq4fovi2bobct7ib3z25imk","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"5bf4fb68c573a02c9777e678410bf5ce51a31484","reviewer":"codex","start_line":52,"suggestion_id":""},"pull_request":{"number":747},"record_id":"art_v1_xid3pzkezsvjc4lyumql5jscab","record_type":"finding_observed","recorded_at":"2026-10-02T01:25:55Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
