{"data":{"body":"[P1] Preserve the existing `ContextExtractor` contract. This public type previously returned an OpenTelemetry `Context`, so existing custom extractors now raise `TypeError` on every invocation and produce no telemetry. Support legacy `Context` results through an adapter/deprecation period (extracting their active `SpanContext`), or introduce a separate new configuration API, and retain a regression test using `lambda _: Context()`.","comment_node_id":"PRRC_kwDOPsIIsM7o8eLA","finding_digest":"4b2616504fd0d9c425092147f4dfed13a3c78b01daf8a721ea82c13b73c0568e","finding_id":"arf_v1_jmtbmucp2dm4ijijefd7jx7nco","finding_key":"otel/context_extractors.py::context_extractor::legacy-context-return-compatibility","identity_key":"otel/context_extractors.py::context_extractor::legacy-context-return-compatibility","line":61,"observation_digest":"8f0cc2cb4d5d36c8a1316cd4f5a32b73b7f473d89421a5533c37a3e85e47aaf7","observation_id":"aro_v1_r4gmfs2nlu3mrijrntkplizloo","path":"packages/aws-durable-execution-sdk-python-otel/src/aws_durable_execution_sdk_python_otel/context_extractors.py","prior_finding_id":"","published_at":"2026-09-01T20:31:04Z","review_id":"arr_v1_75i4qfzw4aepwenq4mtwjt5pnl","reviewed_base_sha":"9052f3510f9c7cc83c8eeb8e260226b38c5e0245","reviewed_head_sha":"aec6acfa2bc32257c2d86726b380713f1cbc0d8d","reviewer":"codex","start_line":53,"suggestion_id":""},"pull_request":{"number":693},"record_id":"art_v1_qa2q4fgyfckkrt3qgpztvccrqk","record_type":"finding_observed","recorded_at":"2026-09-01T20:31:04Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
