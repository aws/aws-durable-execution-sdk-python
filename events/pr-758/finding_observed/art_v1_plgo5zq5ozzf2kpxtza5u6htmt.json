{"data":{"body":"[P2] Normalize an empty error before queuing this terminal update. `send_callback_failure(error=None)` creates an all-`None` `ErrorObject`; the memory store preserves that truthy object, causing OTel to mark the span `ERROR`, while filesystem/SQLite stores serialize it as `{}` and reload it as `None`, producing `UNSET`. Store `None` when the error payload is empty and add a regression covering memory and serialized stores.","comment_node_id":"PRRC_kwDOPsIIsM77J79b","finding_digest":"5a9a660bd276ccfc33bea5d008cdde891a3d423c373aad2166160e3dd843a669","finding_id":"arf_v1_lkngmc6so3gpym56uxiarto6re","finding_key":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py::complete_callback_failure::empty-error-store-consistency","identity_key":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py::complete_callback_failure::empty-error-store-consistency","line":678,"observation_digest":"6c5b30388f4702cceb38e3be1183aa39e0df36a8313172c8857e4347b030ab16","observation_id":"aro_v1_nrntaoepi4bmz2zy4o7bda5khh","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py","prior_finding_id":"arf_v1_lkngmc6so3gpym56uxiarto6re","published_at":"2026-10-08T01:24:39Z","review_id":"arr_v1_trnlm34pj3aplypdplkixdj6mr","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"3bacb932a6e5a3543082817d71b8c14b1a967f56","reviewer":"codex","start_line":678,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_plgo5zq5ozzf2kpxtza5u6htmt","record_type":"finding_observed","recorded_at":"2026-10-08T01:24:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
