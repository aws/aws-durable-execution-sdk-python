{"data":{"body":"[P2] Do not propagate `ContextVar` bindings left by failed plugin setup. `_dispatch_plugin` swallows invocation-start exceptions, but a plugin that sets a variable and then raises leaves that partial state current; this snapshot copies it into the worker, where it can change durable handler control flow. Continue in the pre-hook context when setup fails, apply the same rollback to failed `handler_context` entry, and add a regression where the failing plugin binds before raising.","comment_node_id":"PRRC_kwDOPsIIsM75zfPV","finding_digest":"bc50cdfac26548a66bf6eadc491ceaaf9076749e193968b810095b38b258a822","finding_id":"arf_v1_xrim36wcmvekm27w5loeshhkv6","finding_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py::durable_execution::failed-plugin-context-propagation","identity_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py::durable_execution::failed-plugin-context-propagation","line":322,"observation_digest":"9512f4c1001237ee264e9018c2445bfea783d840bd60a8a67cb3a26c85d9a3dc","observation_id":"aro_v1_sujpjqiaci364jsosammerc372","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py","prior_finding_id":"","published_at":"2026-10-06T02:45:21Z","review_id":"arr_v1_zhmhy3h3vwr5m6fyzowgqj6bog","reviewed_base_sha":"55659db79c158d3623800f6f40755de01b0e057f","reviewed_head_sha":"ef7c447fd314993b76d8447ffb16d9ad9eeebc5f","reviewer":"codex","start_line":322,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_ruioicpq4ng3dfbfdx73tva6my","record_type":"finding_observed","recorded_at":"2026-10-06T02:45:21Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
