{"data":{"body":"[P2] Normalize an errorless callback failure before queuing this update. `send_callback_failure(error=None)` supplies an all-`None` `ErrorObject`; the default in-memory store preserves that truthy object, so both OTel views receive an error and mark the span `ERROR`. File-backed stores serialize it as `{}` and reload it as `None`, producing `UNSET` instead. Store `None` for an empty error payload and add a case-25 regression covering both memory and file stores.","comment_node_id":"PRRC_kwDOPsIIsM77Jx_e","finding_digest":"5a9a660bd276ccfc33bea5d008cdde891a3d423c373aad2166160e3dd843a669","finding_id":"arf_v1_lkngmc6so3gpym56uxiarto6re","finding_key":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py::complete_callback_failure::empty-error-store-consistency","identity_key":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py::complete_callback_failure::empty-error-store-consistency","line":678,"observation_digest":"b04b0362472147f6313913495df1faee1c77a47020c2aee9d7bb44c7939c6484","observation_id":"aro_v1_wbfqgyshefd7mmjzcnev34p25y","path":"packages/aws-durable-execution-sdk-python-testing/src/aws_durable_execution_sdk_python_testing/execution.py","prior_finding_id":"","published_at":"2026-10-08T01:16:10Z","review_id":"arr_v1_ipkqc3ced744zslzznktfy4kkk","reviewed_base_sha":"ef683592fbd3edb48c20b880d859c294bc0ae7a0","reviewed_head_sha":"246cad826359f3c7e96340ff115177bc8c89bd23","reviewer":"codex","start_line":678,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_5ddxzmy4yudsxahldlhaub6wea","record_type":"finding_observed","recorded_at":"2026-10-08T01:16:10Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
