{"data":{"body":"[P2] This test unconditionally requires the new core\u2019s `handler_context` and `copy_context().run` dispatch, but `hatch run test-pypi-otel:test` runs this directory against the previously published core, where handler spans have no asserted SDK parent. That documented compatibility check will therefore fail for every parameter set. Gate these assertions on the new capability while retaining old-core expectations, or raise the OTel package\u2019s minimum core version and update its compatibility contract.","comment_node_id":"PRRC_kwDOPsIIsM74onm0","finding_digest":"b1219c664e5facc36f14e26d2ae3e52d0dfbb028ea7382712c6bf29d3d504fa8","finding_id":"arf_v1_weqzyzsol6wmg3yu4jwsvy7ffu","finding_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py::test_handler_user_spans_inherit_context_across_resume_and_failure::published-core-compatibility","identity_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py::test_handler_user_spans_inherit_context_across_resume_and_failure::published-core-compatibility","line":272,"observation_digest":"e2f43e4a59ec6d3f410aa33657018c5e517fc38be7c7c6c245905869cfa0773a","observation_id":"aro_v1_4l2d4ssz5rwt6qikum3foammlz","path":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py","prior_finding_id":"","published_at":"2026-10-03T02:44:36Z","review_id":"arr_v1_eljggntmlskqd7woyrvf6qdyxm","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"6cb34302645965b2d31d83d22887c67ab44a9077","reviewer":"codex","start_line":262,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_r7rn3c3zr45vkhxbofkj2edr43","record_type":"finding_observed","recorded_at":"2026-10-03T02:44:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
