{"data":{"body":"[P2] No checked-in workflow or CI script runs `hatch run test-pypi-otel:test`, so this legacy-core branch is never exercised on PRs; the normal test jobs use the workspace core. A regression breaking the declared core `>=2.0.0` compatibility can therefore merge unnoticed. Add this environment as a required CI job, or raise the OTel package\u2019s minimum core version and remove the legacy path.","comment_node_id":"PRRC_kwDOPsIIsM74o_rt","finding_digest":"7e5878d8d93c17b2b0daec97cd49c9fadc1968970cfb9e6454a823acfea05e16","finding_id":"arf_v1_pzmhrwgzhql3fmg25sl42soj7l","finding_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py::test_handler_user_spans_inherit_context_across_resume_and_failure::legacy-core-branch-not-ci-enforced","identity_key":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py::test_handler_user_spans_inherit_context_across_resume_and_failure::legacy-core-branch-not-ci-enforced","line":285,"observation_digest":"b31dfd6108b4b759ec26410ff603e69c016b64843c118714dcf82dd7cdd9a928","observation_id":"aro_v1_wmo72yiiws3vt3bgieh7ma7gtq","path":"packages/aws-durable-execution-sdk-python-otel/tests/e2e/test_invocation_wait_resume_int.py","prior_finding_id":"","published_at":"2026-10-03T03:19:04Z","review_id":"arr_v1_6d6us44dpjcxtfdrmhymu3hoyh","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"63cd43c50ea531f05f005b32370937eb4781df79","reviewer":"codex","start_line":285,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_36stpiszqhjibck4nmw67v4yhw","record_type":"finding_observed","recorded_at":"2026-10-03T03:19:04Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
