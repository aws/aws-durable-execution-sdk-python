{"data":{"body":"[P2] Add a local runner test for case 22. Package CI currently only parses this handler and checks its template wiring, while credentialed conformance runs are skipped for fork PRs. Regressions in replay probe counts, concurrent parallel/map parent propagation, or context restoration can therefore merge undetected. Add a `DurableFunctionTestRunner` test for both plugin views that drives the wait/resume and verifies probe counts, SDK parents, and ambient-context restoration.","comment_node_id":"PRRC_kwDOPsIIsM74oLdZ","finding_digest":"0879d53172687aaeba10498d21d1fcf6d5cf06a2dcf42d9f80f2a1322cbb6f9b","finding_id":"arf_v1_bb45kmlsnb5k5oqqjggsdup463","finding_key":"packages/aws-durable-execution-sdk-python-conformance-tests-otel/src/otel_22_user_function_context.py::handler::local-behavior-coverage","identity_key":"packages/aws-durable-execution-sdk-python-conformance-tests-otel/src/otel_22_user_function_context.py::handler::local-behavior-coverage","line":91,"observation_digest":"e4eba70a64f22cb436e929bcbff7e503121def0e1170072092ed871ef15a756d","observation_id":"aro_v1_4tv2octe6iwlinxjfg6l757fam","path":"packages/aws-durable-execution-sdk-python-conformance-tests-otel/src/otel_22_user_function_context.py","prior_finding_id":"arf_v1_bb45kmlsnb5k5oqqjggsdup463","published_at":"2026-10-03T02:11:05Z","review_id":"arr_v1_4i56jv3ye6zzqz64wboxlujfhy","reviewed_base_sha":"95322aceb1f764247a945b7fe1af6bda639c29ea","reviewed_head_sha":"55a7870423dfe1bac0f057d959d654d5f302a7cd","reviewer":"codex","start_line":91,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_7ktk2axkn46u66a77fbywkaa3x","record_type":"finding_observed","recorded_at":"2026-10-03T02:11:05Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
