{"data":{"body":"[P2] Preserve the no-plugin worker-context behavior here. This unconditionally copies the Lambda caller's context into the user worker, even when no plugins are registered; previously that fresh worker used its default context. Uninstrumented handlers can therefore newly observe caller `ContextVar` values and active OTel spans. Submit `func` directly when the plugin list is empty (or add a conditional dispatch helper), and add a worker-level no-plugin regression test.","comment_node_id":"PRRC_kwDOPsIIsM745ILE","finding_digest":"348b55ce993329ca3a25f679d7e46ba1614c6e60140138da37a59fa6e26a454d","finding_id":"arf_v1_gsfvltuzgmu4uorf6z45pzdluf","finding_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py::durable_execution::no-plugin-worker-context-compatibility","identity_key":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py::durable_execution::no-plugin-worker-context-compatibility","line":320,"observation_digest":"4d82abfa543ec99c1c5392dad0d1805d46b12feab4049d90d28c8612b5ded5be","observation_id":"aro_v1_jwbkx6suh3ezyhctslnnbumalv","path":"packages/aws-durable-execution-sdk-python/src/aws_durable_execution_sdk_python/execution.py","prior_finding_id":"","published_at":"2026-10-04T01:44:31Z","review_id":"arr_v1_ely36ok324qp6mjy7qobhzu3yx","reviewed_base_sha":"631b78d1b505b157eee758662291fc5e2353bbb6","reviewed_head_sha":"146f2313801b8bce2f8402d5e8c8f1cd064e4279","reviewer":"codex","start_line":320,"suggestion_id":""},"pull_request":{"number":758},"record_id":"art_v1_tugpkidygtnj4kvyzpzcmitwpi","record_type":"finding_observed","recorded_at":"2026-10-04T01:44:31Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
