{"data":{"body":"[P3] Use absolute migration links in published package READMEs\n\nBoth OTel and Core declare `readme = \"README.md\"`, so these relative links are included unchanged in their PyPI descriptions. On PyPI, `../../docs/...` resolves against PyPI rather than this repository, leaving users with a broken migration-guide link. Use absolute repository URLs here and in the corresponding new Core README link.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABA4qUSA","finding_digest":"d5f7b72752a4f1c9bfaab52c118197a84d50b58ffd3dcb2a83fbf15098594192","finding_id":"arf_v1_2x33oj2suty4tp5kwuwbdamxvb","finding_key":"package-readmes::migration-guide::relative-links-in-published-metadata","identity_key":"package-readmes::migration-guide::relative-links-in-published-metadata","line":18,"observation_digest":"3f7c3eec885e1c4e7fa0f6f1618f8f964f7c5b1b735943b96c9ea7ca49349e07","observation_id":"aro_v1_h56d53eilyoe475a63ywdd4psz","path":"packages/aws-durable-execution-sdk-python-otel/README.md","prior_finding_id":"","published_at":"2026-10-22T22:54:51Z","review_id":"arr_v1_insvq4tblmxa72zzgsxlm6p7ir","reviewed_base_sha":"f870be53eeeac46c6b23177412bfbc2968eab023","reviewed_head_sha":"f14ead96789b255f619a07e31187c5439b017777","reviewer":"codex","start_line":18,"suggestion_id":""},"pull_request":{"number":801},"record_id":"art_v1_lilfmi5v6ajsbskywddsdwcxsl","record_type":"finding_observed","recorded_at":"2026-10-22T22:54:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
