{"data":{"body":"[P2] Match the dependency to the local exporter version\n\nThe exporter\u2019s `__about__.py` declares version `0.0.1`, which this PR leaves unchanged. Requiring `==1.0.0` makes this conformance package incompatible with the exporter it is intended to test: a dependency resolver installing both local projects must reject the combination. Match the pin to the repository version and add a metadata test that checks this compatibility.","comment_node_id":"PRRC_kwDOPsIIsM8AAAABBDMW6w","finding_digest":"96172b9aa11ec00c02cc5fc18c6b6fde887399f3beff5e06a503e5727efb1daf","finding_id":"arf_v1_sylsxgvbd3aayawml7ayy23p32","finding_key":"conformance-tests-telemetry/pyproject.toml::project.dependencies::exporter-version-mismatch","identity_key":"conformance-tests-telemetry/pyproject.toml::project.dependencies::exporter-version-mismatch","line":12,"observation_digest":"68db342ca52c33a1ea717c38fd3c04f14126541d0bc77a1be80dfc92063fab7a","observation_id":"aro_v1_ndntilfffqz2d2trpq4p2pae6f","path":"packages/aws-durable-execution-sdk-python-conformance-tests-telemetry/pyproject.toml","prior_finding_id":"","published_at":"2026-10-24T01:01:30Z","review_id":"arr_v1_g72lcqmell5x3itqshtlu5zf5t","reviewed_base_sha":"e6d60c9a853aaae55e5f6539a6a595c25e2a3215","reviewed_head_sha":"ccc54896b137a01c8cf6030130dc58c2b4590242","reviewer":"codex","start_line":12,"suggestion_id":"arsg_v1_xppbfz5goahnzbzonubh5xsd76"},"pull_request":{"number":822},"record_id":"art_v1_csbmzmjwyhvorsy3gw4nrhme3j","record_type":"finding_observed","recorded_at":"2026-10-24T01:01:30Z","repository":{"full_name":"aws/aws-durable-execution-sdk-python","id":1052903600},"schema_version":1}
